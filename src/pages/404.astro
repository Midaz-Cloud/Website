---
// Página para direcciones que no existen. Vercel la sirve con estado 404 y no se indexa.
import LandingLayout from "../layouts/LandingLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
---

<LandingLayout title="Página no encontrada | Midaz" description="La página que buscas no existe o cambió de dirección." intro={false} noindex canonicalPath={null}>
    <Navbar home={false} />
    <main class="mx-auto flex min-h-[60vh] max-w-[720px] flex-col items-center justify-center px-4 py-20 text-center sm:px-8">
        <p class="font-[Inter] text-sm font-semibold uppercase tracking-[1.2px] text-landing-blue">Error 404</p>
        <h1 class="mt-3 font-funnel text-[clamp(1.875rem,4.5vw,2.75rem)] font-bold leading-[1.1] tracking-[-0.02em]">Esta página no existe</h1>
        <p class="mt-4 text-base text-landing-navy/80">Puede que la dirección esté mal escrita o que la página se haya movido.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
            <a href="/" class="rounded-full bg-landing-blue px-6 py-3 font-[Inter] text-sm font-semibold text-white">Ir al inicio</a>
            <a href="/comenzar" class="rounded-full border border-[rgba(0,75,224,0.25)] bg-white/70 px-6 py-3 font-[Inter] text-sm font-semibold text-landing-navy hover:border-landing-blue hover:text-landing-blue">Crear mi cuenta</a>
        </div>
    </main>
    <LandingFooter home={false} />
</LandingLayout>
