---
import Layout from "../layouts/Layout.astro";
import HeroHeading from "../components/react/HeroHeading";
import ParticlesBg from "../components/react/ParticlesBg";
import ProblemCards from "../components/react/ProblemCards";
import ManifestoHighlighted from "../components/react/ManifestoHighlighted";
import BentoSection from "../components/react/BentoSection";
import StatsSection from "../components/react/StatsSection";
import FlowSection from "../components/react/FlowSection";
import SectorAccordion from "../components/home/SectorAccordion.astro";
import ScatterCTA from "../components/home/ScatterCTA.astro";

const sectors = [
    {
        slug: "tiendas",
        title: "Tiendas y abastos",
        image: "/section7/PD07746_-_food_and_bev.avif",
        metric: "Multi-cajero y multi-sede",
        caption: "Control de inventario en tiempo real con IGTF automático.",
        href: "/comenzar",
    },
    {
        slug: "panaderias",
        title: "Panaderías y fruterías",
        image: "/section7/PD07746_-_retail.avif",
        metric: "Venta por peso exacto",
        caption:
            "Factura kilos y gramos con comprobante fiscal en cada operación.",
        href: "/comenzar",
    },
    {
        slug: "restaurantes",
        title: "Restaurantes y cafeterías",
        image: "/section7/PD07746_-_beauty.avif",
        metric: "Comandas y recetas",
        caption:
            "Cada venta descuenta automáticamente los ingredientes del stock.",
        href: "/comenzar",
    },

    {
        slug: "multisede",
        title: "Negocios multi-sede",
        image: "/section7/PD07746_-_services.avif",
        metric: "Un backoffice, todas las sucursales",
        caption:
            "Visión consolidada y monitor POS en tiempo real desde cualquier lugar.",
        href: "/comenzar",
    },
];

const trailImages = [
    {
        src: "https://images.unsplash.com/photo-1604719312566-8912e9227c6a?w=400&q=75",
        alt: "Tienda",
    },
    {
        src: "https://images.unsplash.com/photo-1509440159596-0249088772ff?w=400&q=75",
        alt: "Panadería",
    },
    {
        src: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=400&q=75",
        alt: "Restaurante",
    },
    {
        src: "https://images.unsplash.com/photo-1587854692152-cbe660dbde88?w=400&q=75",
        alt: "Farmacia",
    },
    {
        src: "https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&q=75",
        alt: "Oficina",
    },
    {
        src: "https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=400&q=75",
        alt: "POS",
    },
    {
        src: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=400&q=75",
        alt: "Web",
    },
    {
        src: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=400&q=75",
        alt: "Sede",
    },
];

const comparisonRows = [
    {
        label: "IGTF",
        before: "El cajero calcula a mano o con calculadora. Error frecuente.",
        after: "Se aplica el 3% automáticamente según el método de pago. Siempre correcto.",
    },
    {
        label: "Internet caído",
        before: "El POS no funciona. El negocio para. Se pierde la venta.",
        after: "Opera igual. La factura se imprime. Se sincroniza sola cuando vuelve la red.",
    },
    {
        label: "Inventario",
        before: "Hoja de cálculo actualizada al final del día, si hay tiempo.",
        after: "Cada venta descuenta el stock al instante en todas las sedes.",
    },
    {
        label: "Visión multi-sede",
        before: "El dueño llama a cada sucursal para saber cómo va el día.",
        after: "Dashboard en tiempo real con todas las sedes y cajas activas.",
    },
    {
        label: "Cierre de caja",
        before: "Conteo manual, cruce con papel. Puede tomar horas.",
        after: "Reporte Z automático. Cuadre calculado y enviado al backoffice.",
    },
    {
        label: "Conciliación",
        before: "Al final del mes, horas cruzando estado de cuenta con facturas a mano.",
        after: "Automática. Cruza lotes bancarios contra facturas. Diferencias destacadas.",
    },
];
---

<Layout title="Midaz — Tu cerebro operativo y fiscal">
    <!-- ─── SECCIÓN 1: HERO ──────────────────────────── -->
    <section class="hero-section">
        <!-- TODO: Agregar HeroBg -->
        <!-- <HeroBg client:load /> -->
        <ParticlesBg
            client:load
            color="#a9ccff"
            quantity={35}
            staticity={70}
            size={0.4}
        />
        <div class="hero-content">
            <HeroHeading client:load />
            <p class="hero-sub">
                Factura, cobra, controla tu inventario y cierra el día — todo en
                un solo lugar, aunque no haya internet. Sin errores. Sin multas.
            </p>
            <div class="hero-buttons">
                <a href="/comenzar" class="btn-blue-solid"
                    >Solicitar acceso anticipado →</a
                >
                <a href="#como-funciona" class="btn-outline"
                    >Ver cómo funciona ↓</a
                >
            </div>
        </div>
        <div class="video-placeholder">
            <span class="vp-text"
                >[ Video scroll animation — agregar frames en /public/frames/ ]</span
            >
        </div>
    </section>

    <!-- ─── SECCIÓN 2: MANIFIESTO ────────────────────── -->
    <section class="manifesto-section">
        <div class="manifesto-inner sc">
            <span class="eyebrow-gold">— Manifiesto</span>
            <ManifestoHighlighted client:load />
            <p class="manifesto-note">
                Un solo sistema para tu caja, tu equipo, tu inventario y tu
                cumplimiento fiscal. Pensado para el comerciante venezolano.
                Hecho para que trabajes tranquilo.
            </p>
        </div>
    </section>

    <!-- ─── SECCIÓN 3: EL PROBLEMA ──────────────────── -->
    <section id="producto" class="problem-section">
        <div class="sc">
            <div class="section-header reveal">
                <h2 class="sh2 dark">
                    Vender en Venezuela<br /><s class="accent-strike"
                        >debería ser simple.</s
                    >
                </h2>
                <p class="ssub dark">
                    El sistema fiscal venezolano castiga los errores.<br />
                    Midaz los elimina desde el origen.
                </p>
            </div>
            <div class="reveal">
                <ProblemCards client:visible />
            </div>
        </div>
    </section>

    <!-- ─── SECCIÓN 4: SCROLL VIDEO ──────────────────── -->
    <div id="como-funciona">
        <div class="video-intro reveal">
            <span class="eyebrow-gold">Así funciona Midaz</span>
            <h2 class="video-intro-h2">
                Del primer toque<br />al cierre <em class="accent-gold"
                    >del día.</em
                >
            </h2>
        </div>

        <section
            id="video-scroll-section"
            style="position:relative;height:600vh;background:#0a0a0a;"
        >
            <div
                style="position:sticky;top:0;height:100vh;overflow:hidden;display:flex;align-items:center;justify-content:center;"
            >
                <canvas
                    id="midaz-reel"
                    style="position:absolute;top:50%;left:50%;
                       transform:translate(-50%,-50%);
                       max-width:100%;max-height:100vh;
                       will-change:contents;display:none;"
                >
                </canvas>
                <div
                    id="scroll-caption"
                    style="position:absolute;left:5%;top:50%;transform:translateY(-50%);
                       max-width:280px;z-index:10;pointer-events:none;"
                >
                    <p
                        id="caption-text"
                        style="font-family:'Inter',sans-serif;font-size:18px;
                           color:#ffffff;line-height:1.6;
                           opacity:0;transition:opacity 0.4s ease;"
                    >
                    </p>
                </div>
                <!-- Placeholder mientras no hay frames -->
                <div
                    id="video-fallback"
                    style="border:1px solid rgba(0,75,224,0.4);border-radius:12px;
                       aspect-ratio:16/9;width:min(900px,90vw);
                       display:flex;align-items:center;justify-content:center;"
                >
                    <span
                        style="font-family:'Inter',sans-serif;font-size:14px;color:#a9ccff;"
                    >
                        [ Sección de video — agregar frames WebP en
                        /public/frames/ ]
                    </span>
                </div>
            </div>
        </section>

        <!-- Loader overlay (oculto por defecto, se muestra al cargar frames) -->
        <div
            id="frames-loader"
            style="position:fixed;inset:0;background:#0a0a0a;z-index:1000;
               display:none;flex-direction:column;align-items:center;
               justify-content:center;gap:20px;"
        >
            <svg width="48" height="48" viewBox="0 0 186.22 180.96" fill="none">
                <path
                    fill="#ffb05a"
                    d="M138.74,80.71l-31.86,31.86v40.35l-8.73,8.73v-54.49l28.53-28.53v-45.06L93.1,0l-33.57,33.57v45.06l28.53,28.53v54.48l-8.72-8.72v-40.35l-31.86-31.86H0v47.48l31.86,31.86h40.34l10.32,10.32,10.59,10.59,5.03-5.04,5.55-5.55,10.32-10.32h40.34l31.86-31.86v-47.48h-47.48ZM98.15,19.3l18.44,18.45v36.69l-18.44,18.44V19.3ZM36.03,149.96l-25.94-25.94v-26.09s52.03,52.04,52.03,52.04h-26.08ZM69.25,142.83l-52.04-52.04h26.09s25.94,25.95,25.94,25.95v26.08ZM69.62,74.45v-36.69l18.44-18.45v73.59l-18.44-18.44ZM116.97,116.75l25.94-25.94h26.09s-52.04,52.03-52.04,52.03v-26.08ZM176.13,124.02l-25.94,25.94h-26.08l52.04-52.04v26.09Z"
                ></path>
            </svg>
            <div
                style="width:200px;height:2px;background:#07143a;border-radius:2px;overflow:hidden;"
            >
                <div
                    id="loader-bar"
                    style="height:100%;width:0%;background:#004be0;transition:width 0.1s linear;border-radius:2px;"
                >
                </div>
            </div>
            <span
                id="loader-text"
                style="font-family:'Inter',sans-serif;color:#a9ccff;font-size:14px;"
            >
                Cargando... 0%
            </span>
        </div>
    </div>

    <!-- ─── SECCIÓN 5: DOS SISTEMAS ─────────────────── -->
    <section id="para-quien" class="systems-section">
        <div class="sc">
            <div class="section-header reveal">
                <span class="eyebrow-gold"
                    >Dos sistemas. Una sola plataforma.</span
                >
                <h2 class="sh2 light">
                    Un <em class="accent-gold">ecosistema,</em><br />no una app
                    suelta.
                </h2>
            </div>
        </div>
        <div class="systems-panels">
            <!-- Agora -->
            <div class="panel-agora reveal">
                <span class="badge badge-gold">Hardware incluido</span>
                <svg
                    width="48"
                    height="48"
                    viewBox="0 0 186.22 180.96"
                    fill="none"
                    aria-hidden="true"
                    style="display:block;margin-bottom:20px"
                >
                    <path
                        fill="#ffb05a"
                        d="M138.74,80.71l-31.86,31.86v40.35l-8.73,8.73v-54.49l28.53-28.53v-45.06L93.1,0l-33.57,33.57v45.06l28.53,28.53v54.48l-8.72-8.72v-40.35l-31.86-31.86H0v47.48l31.86,31.86h40.34l10.32,10.32,10.59,10.59,5.03-5.04,5.55-5.55,10.32-10.32h40.34l31.86-31.86v-47.48h-47.48ZM98.15,19.3l18.44,18.45v36.69l-18.44,18.44V19.3ZM36.03,149.96l-25.94-25.94v-26.09s52.03,52.04,52.03,52.04h-26.08ZM69.25,142.83l-52.04-52.04h26.09s25.94,25.95,25.94,25.95v26.08ZM69.62,74.45v-36.69l18.44-18.45v73.59l-18.44-18.44ZM116.97,116.75l25.94-25.94h26.09s-52.04,52.03-52.04,52.03v-26.08ZM176.13,124.02l-25.94,25.94h-26.08l52.04-52.04v26.09Z"
                    ></path>
                </svg>
                <h3 class="panel-title" style="color:#fff">Midaz Agora</h3>
                <p class="panel-sub" style="color:#a9ccff">
                    POS en terminal + Backoffice web
                </p>
                <p class="panel-desc" style="color:rgba(255,255,255,0.75)">
                    Un ecosistema completo. El cajero opera desde el terminal
                    fiscal con impresora integrada. El dueño ve todo en tiempo
                    real desde el panel web. Factura, cobra, controla el
                    inventario y cierra el día — aunque no haya internet.
                </p>
                <div class="features-grid">
                    {
                        [
                            "App Android en terminal fiscal",
                            "Backoffice web incluido",
                            "Impresora fiscal integrada",
                            "Monitor POS en tiempo real",
                            "Opera 100% offline",
                            "Inventario multi-sede",
                            "IGTF automático",
                            "Conciliación bancaria",
                            "Reporte Z con un toque",
                            "Auditoría fiscal completa",
                        ].map((f) => (
                            <div class="feature-row">
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#004be0"
                                    stroke-width="2.5"
                                    aria-hidden="true"
                                    style="flex-shrink:0"
                                >
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                <span style="color:rgba(255,255,255,0.8)">
                                    {f}
                                </span>
                            </div>
                        ))
                    }
                </div>
                <a href="/comenzar" class="panel-cta cta-solid"
                    >Conocer Agora →</a
                >
            </div>
            <!-- Web -->
            <div class="panel-web reveal" style="transition-delay:100ms">
                <span class="badge badge-blue">Cualquier navegador</span>
                <svg
                    width="48"
                    height="48"
                    viewBox="0 0 186.22 180.96"
                    fill="none"
                    aria-hidden="true"
                    style="display:block;margin-bottom:20px"
                >
                    <path
                        fill="#ffb05a"
                        d="M138.74,80.71l-31.86,31.86v40.35l-8.73,8.73v-54.49l28.53-28.53v-45.06L93.1,0l-33.57,33.57v45.06l28.53,28.53v54.48l-8.72-8.72v-40.35l-31.86-31.86H0v47.48l31.86,31.86h40.34l10.32,10.32,10.59,10.59,5.03-5.04,5.55-5.55,10.32-10.32h40.34l31.86-31.86v-47.48h-47.48ZM98.15,19.3l18.44,18.45v36.69l-18.44,18.44V19.3ZM36.03,149.96l-25.94-25.94v-26.09s52.03,52.04,52.03,52.04h-26.08ZM69.25,142.83l-52.04-52.04h26.09s25.94,25.95,25.94,25.95v26.08ZM69.62,74.45v-36.69l18.44-18.45v73.59l-18.44-18.44ZM116.97,116.75l25.94-25.94h26.09s-52.04,52.03-52.04,52.03v-26.08ZM176.13,124.02l-25.94,25.94h-26.08l52.04-52.04v26.09Z"
                    ></path>
                </svg>
                <h3 class="panel-title" style="color:#07143a">Midaz Web</h3>
                <p class="panel-sub" style="color:#004be0">
                    Sistema web + impresora fiscal
                </p>
                <p class="panel-desc" style="color:rgba(7,20,58,0.75)">
                    Para negocios con sus propias computadoras o tablets. Se
                    conecta directamente a impresoras fiscales desde el
                    navegador. Factura, cobra y controla el inventario sin
                    instalar nada.
                </p>
                <div class="features-grid">
                    {
                        [
                            "Funciona en cualquier PC/tablet",
                            "Impresoras fiscales compatibles",
                            "Sin hardware adicional",
                            "Inventario integrado",
                            "Multi-usuario y multi-sede",
                            "Auditoría fiscal",
                            "94 permisos granulares",
                            "Tasa BCV automática",
                            "Notas de crédito fiscales",
                            "Venta por kilo/gramo (próximo)",
                        ].map((f) => (
                            <div class="feature-row">
                                <svg
                                    width="16"
                                    height="16"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="#004be0"
                                    stroke-width="2.5"
                                    aria-hidden="true"
                                    style="flex-shrink:0"
                                >
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                <span style="color:rgba(7,20,58,0.8)">{f}</span>
                            </div>
                        ))
                    }
                </div>
                <a href="/comenzar" class="panel-cta cta-outline"
                    >Conocer Midaz Web →</a
                >
            </div>
        </div>
    </section>

    <!-- ─── SECCIÓN 5b: SENIAT ───────────────────────── -->
    <section class="seniat-section">
        <div class="sc">
            <div class="section-header reveal">
                <span class="eyebrow-gold">Cumplimiento</span>
                <h2 class="sh2 light">
                    SENIAT, pero<br /><em class="accent-gold"
                        >sin dolor de cabeza.</em
                    >
                </h2>
                <p class="ssub" style="color:rgba(169,204,255,0.75)">
                    Midaz habla directo con tu impresora fiscal. Calcula el IVA,
                    aplica el IGTF cuando toca, imprime la factura legal y
                    guarda todo para tu Reporte Z al cierre. Tú vendes. Midaz
                    cumple.
                </p>
            </div>
            <div class="seniat-grid">
                {
                    [
                        {
                            n: "1",
                            label: "Factura fiscal",
                            desc: "Emitida con número de control SHA-256. Legal desde el segundo uno.",
                        },
                        {
                            n: "2",
                            label: "IGTF automático",
                            desc: "3% sobre divisas para Contribuyente Especial. Calculado al céntimo.",
                        },
                        {
                            n: "3",
                            label: "Notas de crédito y débito",
                            desc: "Vinculadas a la factura original. Fiscalizadas en segundos.",
                        },
                        {
                            n: "4",
                            label: "Reporte Z al cierre",
                            desc: "Cierre de día en un clic. Libro fiscal listo para el SENIAT.",
                        },
                    ].map((item, i) => (
                        <div
                            class="seniat-card reveal"
                            style={`transition-delay:${i * 80}ms`}
                        >
                            <span class="seniat-num">{item.n}</span>
                            <h4 class="seniat-label">{item.label}</h4>
                            <p class="seniat-desc">{item.desc}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- ─── SECCIÓN 5c: BENTO FEATURES ──────────────── -->
    <section class="bento-section">
        <div class="sc">
            <div class="section-header reveal">
                <span class="eyebrow-gold">Plataforma completa</span>
                <h2 class="sh2 light">
                    Todo lo que<br />necesita tu <em class="accent-gold"
                        >negocio.</em
                    >
                </h2>
            </div>
        </div>
        <div class="bento-wrap reveal">
            <BentoSection client:visible />
        </div>
    </section>

    <!-- ─── SECCIÓN 6: FLUJO DE VENTA ───────────────── -->
    <section class="flow-section">
        <div class="sc">
            <div class="section-header reveal">
                <span class="eyebrow-gold">El día a día</span>
                <h2 class="sh2 light">
                    De la venta al cierre,<br />sin <em class="accent-gold"
                        >fricciones.</em
                    >
                </h2>
                <p class="ssub" style="color:rgba(169,204,255,0.75)">
                    7 pasos que se completan en menos de 2 minutos.
                </p>
            </div>
            <div class="reveal" style="transition-delay:80ms">
                <FlowSection client:visible />
            </div>
        </div>
    </section>

    <!-- ─── SECCIÓN 6b: OFFLINE ─────────────────────── -->
    <section class="offline-section">
        <div class="sc offline-inner">
            <div class="offline-text reveal">
                <span class="eyebrow-gold">Sin internet, sin drama</span>
                <h2 class="sh2 dark" style="margin-top:16px">
                    Si se cae<br />la señal,<br /><em class="accent-gold"
                        >Midaz no.</em
                    >
                </h2>
                <p
                    class="ssub dark"
                    style="text-align:left;margin:0;margin-top:20px"
                >
                    En Venezuela el internet es un compañero impredecible. Por
                    eso Midaz está hecho para vender aunque el mundo se apague.
                    La caja sigue. La factura sale. Todo se guarda en el equipo.
                    Cuando vuelve la señal, sube al sistema.
                </p>
                <div
                    class="offline-badges reveal"
                    style="transition-delay:100ms"
                >
                    <span class="o-badge">Offline-first</span>
                    <span class="o-badge">Sync automática</span>
                    <span class="o-badge">Cero pérdida de datos</span>
                </div>
            </div>
            <div class="offline-mockup reveal" style="transition-delay:150ms">
                <div class="mockup-card">
                    <div class="mockup-header">
                        <span class="mockup-dot dot-green"></span>
                        <span class="mockup-status-label"
                            >Estado actual · Caja 02</span
                        >
                        <span class="mockup-status-val offline-badge-val"
                            >• Sin internet · operativo</span
                        >
                    </div>
                    {
                        [
                            {
                                icon: "✓",
                                title: "Venta registrada localmente",
                                sub: "Factura #00-00084291 · $47.30 · Efectivo USD",
                                tag: "En cola",
                                tagColor: "#f49a40",
                            },
                            {
                                icon: "✓",
                                title: "Impresora fiscal respondió",
                                sub: "La impresora emitió la factura legal sin depender de la nube",
                                tag: "OK",
                                tagColor: "#22c55e",
                            },
                            {
                                icon: "✓",
                                title: "Cola de sincronización lista",
                                sub: "8 facturas · 3 órdenes · 1 reporte Z esperando",
                                tag: "Pendiente",
                                tagColor: "#f49a40",
                            },
                            {
                                icon: "↑",
                                title: "Cuando vuelva el internet…",
                                sub: "Todo sube solo, ordenado por prioridad fiscal",
                                tag: "Auto",
                                tagColor: "#004be0",
                                highlight: true,
                            },
                        ].map((row) => (
                            <div
                                class={`mockup-row${row.highlight ? " mockup-row-blue" : ""}`}
                            >
                                <span
                                    class="mockup-icon"
                                    style={
                                        row.highlight
                                            ? "color:#004be0"
                                            : "color:#22c55e"
                                    }
                                >
                                    {row.icon}
                                </span>
                                <div class="mockup-row-text">
