<script>
// ─── REVEAL OBSERVER ─────────────────────────────
const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            revealObs.unobserve(entry.target);
        }
    });
}, { threshold: 0.12 });

document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

// ─── SMOOTH SCROLL ───────────────────────────────
document.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', (e) => {
        const href = (link as HTMLAnchorElement).getAttribute('href') || '';
        const target = document.querySelector(href);
        if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth' });
        }
    });
});

// ─── SCROLL VIDEO ────────────────────────────────
const TOTAL_FRAMES = 240;
const VIDEO_WIDTH  = 1920;
const VIDEO_HEIGHT = 1080;
const FRAMES_DIR   = '/frames/';

const CAPTIONS: [number, number, string][] = [
    [0.00, 0.20, "El cajero abre Midaz con su PIN. La app verifica la impresora y está lista en segundos."],
    [0.20, 0.40, "Agrega los productos por nombre o código de barras. Precio, IVA y stock se actualizan en tiempo real."],
    [0.40, 0.60, "El cliente paga en bolívares, dólares o divisas. El IGTF del 3% se calcula automáticamente."],
    [0.60, 0.80, "La impresora fiscal emite el comprobante legal al instante. Válido ante SENIAT."],
    [0.80, 1.00, "Todo queda registrado. El dueño ve la venta en tiempo real desde el backoffice."],
];

const canvas   = document.getElementById('midaz-reel') as HTMLCanvasElement | null;
const fallback = document.getElementById('video-fallback') as HTMLElement | null;
const section  = document.getElementById('video-scroll-section') as HTMLElement | null;
const captionEl = document.getElementById('caption-text') as HTMLElement | null;

if (canvas) {
    const ctx = canvas.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    canvas.width  = VIDEO_WIDTH  * dpr;
    canvas.height = VIDEO_HEIGHT * dpr;
    ctx?.scale(dpr, dpr);

    const aspect = VIDEO_WIDTH / VIDEO_HEIGHT;
    if (window.innerWidth / window.innerHeight > aspect) {
        canvas.style.height = '100vh';
        canvas.style.width  = (window.innerHeight * aspect) + 'px';
    } else {
        canvas.style.width  = '100vw';
        canvas.style.height = (window.innerWidth / aspect) + 'px';
    }

    const frames: (HTMLImageElement | undefined)[] = new Array(TOTAL_FRAMES);
    let framesLoaded = 0;
    let anyLoaded    = false;

    const loaderBar  = document.getElementById('loader-bar') as HTMLElement | null;
    const loaderText = document.getElementById('loader-text') as HTMLElement | null;
    const loader     = document.getElementById('frames-loader') as HTMLElement | null;

    const loadFrame = (index: number) => new Promise<void>(resolve => {
        const n   = String(index + 1).padStart(4, '0');
        const img = new Image();
        img.onload = () => {
            frames[index] = img;
            framesLoaded++;
            anyLoaded = true;
            const pct = Math.round(framesLoaded / TOTAL_FRAMES * 100);
            if (loaderBar)  loaderBar.style.width = pct + '%';
            if (loaderText) loaderText.textContent = `Cargando... ${pct}%`;
            resolve();
        };
        img.onerror = () => resolve();
        img.src = `${FRAMES_DIR}frame_${String(n).padStart(4, '0')}.webp`;
    });

    async function preloadFrames() {
        if (loader) loader.style.display = 'flex';
        const first = Array.from({ length: Math.min(30, TOTAL_FRAMES) }, (_, i) => loadFrame(i));
        await Promise.all(first);

        if (anyLoaded) {
            if (fallback) fallback.style.display = 'none';
            if (canvas)   canvas.style.display   = 'block';
            if (loader) {
                (loader as HTMLElement).style.transition = 'opacity 0.5s';
                (loader as HTMLElement).style.opacity    = '0';
                setTimeout(() => { if (loader) (loader as HTMLElement).style.display = 'none'; }, 500);
            }
            const img0 = frames[0];
            if (img0 && ctx) ctx.drawImage(img0, 0, 0, VIDEO_WIDTH, VIDEO_HEIGHT);
        } else {
            if (loader) (loader as HTMLElement).style.display = 'none';
        }

        const rest = Array.from({ length: TOTAL_FRAMES - 30 }, (_, i) => loadFrame(i + 30));
        await Promise.all(rest);
    }

    if (window.location.protocol !== 'file:') {
        preloadFrames();
    }

    let currentFrame   = -1;
    let rafPending     = false;
    let currentCaption = -1;

    window.addEventListener('scroll', () => {
        if (!section || !anyLoaded) return;
        const rect       = section.getBoundingClientRect();
        const maxScroll  = section.offsetHeight - window.innerHeight;
        const scrolled   = Math.max(0, -rect.top);
        const progress   = Math.min(1, scrolled / maxScroll);
        const frameIndex = Math.min(Math.floor(progress * (TOTAL_FRAMES - 1)), TOTAL_FRAMES - 1);

        if (frameIndex !== currentFrame && !rafPending && frames[frameIndex]) {
            rafPending = true;
            requestAnimationFrame(() => {
                const img = frames[frameIndex];
                if (img && ctx) ctx.drawImage(img, 0, 0, VIDEO_WIDTH, VIDEO_HEIGHT);
                currentFrame = frameIndex;
                rafPending   = false;
            });
        }

        for (let i = 0; i < CAPTIONS.length; i++) {
            const [start, end, text] = CAPTIONS[i];
            if (progress >= start && progress < end && currentCaption !== i) {
                if (captionEl) {
                    captionEl.style.opacity = '0';
                    setTimeout(() => {
                        if (captionEl) { captionEl.textContent = text; captionEl.style.opacity = '1'; }
                    }, 200);
                }
                currentCaption = i;
                break;
            }
        }
    }, { passive: true });
}
</script>
