---
import LandingLayout from "../layouts/LandingLayout.astro";
import Navbar from "../components/landing/Navbar.astro";
import Hero from "../components/landing/Hero.astro";
import Overview from "../components/landing/Overview.astro";
import Partners from "../components/landing/Partners.astro";
import Ecosystem from "../components/landing/Ecosystem.astro";
import Platform from "../components/landing/Platform.astro";
import Omnichannel from "../components/landing/Omnichannel.astro";
import Faq from "../components/landing/Faq.astro";
import Hermez from "../components/landing/Hermez.astro";
import LandingFooter from "../components/landing/LandingFooter.astro";
---

<LandingLayout>
    <Navbar />
    <main>
        <Hero />
        <Overview>
            <Fragment slot="title">
                MIDAZ es la <span class="text-landing-orange">infraestructura operativa e integral</span> para el comercio moderno.
            </Fragment>
            Diseñado para eliminar la fricción entre la caja, la contabilidad y el inventario. Garantizamos tranquilidad fiscal automatizando tus ventas a tasa oficial, sin descuadres de caja ni trabajo manual.
        </Overview>
        <Partners />
        <Ecosystem />
        <Platform />
        <Omnichannel />
        <Faq />
        <Hermez />
    </main>
    <LandingFooter />
</LandingLayout>
