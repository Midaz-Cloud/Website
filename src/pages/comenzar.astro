---
// Alta rápida: el cliente deja sus datos, elige un plan y paga por Pago Móvil.
// La referencia se envía a soporte para verificarla y crear el usuario.
import "../styles/onboarding.css";

const SUPPORT_EMAIL = "soporte@midazve.com";

// Datos de la cuenta que recibe el Pago Móvil.
const PAGO_MOVIL = {
    banco: "POR DEFINIR",
    telefono: "POR DEFINIR",
    rif: "POR DEFINIR",
};

const PLANS = [
    {
        id: "web-mensual",
        product: "Midaz Web",
        name: "Mensual",
        price: 29,
        period: "/mes",
        description: "Pago flexible, sin compromiso",
        features: ["Sistema web desde cualquier PC o tablet", "Conexión a impresoras fiscales", "Tasa BCV automática", "Soporte 24/7"],
    },
    {
        id: "web-anual",
        product: "Midaz Web",
        name: "Anual",
        price: 290,
        period: "/año",
        description: "Ahorras el equivalente a 2 meses",
        features: ["Todo lo del Mensual", "Multiusuario y multisede", "Reportes avanzados exportables", "Soporte 24/7"],
        recommended: true,
    },
    {
        id: "agora-emprendedor",
        product: "Ágora",
        name: "Emprendedor",
        price: 49,
        period: "/mes",
        description: "Para un local y una caja",
        features: ["Terminal fiscal incluido", "App Android y panel web", "Inventario hasta 500 productos", "Soporte 24/7"],
    },
    {
        id: "agora-empresarial",
        product: "Ágora",
        name: "Empresarial",
        price: 99,
        period: "/mes",
        description: "Varias cajas y sedes",
        features: ["Todo lo del Emprendedor", "Hasta 5 cajeros", "Inventario ilimitado y multisede", "Conciliación bancaria automática"],
    },
];

const BANKS = [
    "0102 Banco de Venezuela",
    "0104 Venezolano de Crédito",
    "0105 Mercantil",
    "0108 Provincial",
    "0114 Bancaribe",
    "0115 Exterior",
    "0128 Banco Caroní",
    "0134 Banesco",
    "0137 Sofitasa",
    "0138 Banco Plaza",
    "0151 BFC Banco Fondo Común",
    "0156 100% Banco",
    "0157 DelSur",
    "0163 Banco del Tesoro",
    "0166 Banco Agrícola de Venezuela",
    "0168 Bancrecer",
    "0169 R4 Banco Microfinanciero",
    "0171 Banco Activo",
    "0172 Bancamiga",
    "0174 Banplus",
    "0175 Banco Digital de los Trabajadores",
    "0177 Banfanb",
    "0191 BNC Nacional de Crédito",
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
        <meta name="description" content="Crea tu cuenta de Midaz en minutos: tus datos, tu plan y el pago por Pago Móvil." />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Empieza con Midaz | Midaz</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@600;700&family=Funnel+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
            @media (max-width: 560px) { .plans { grid-template-columns: 1fr; } }
            .plan {
                position: relative; text-align: left; font-family: inherit; color: var(--text); cursor: pointer;
                background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius);
                padding: 16px; display: flex; flex-direction: column; gap: 6px; transition: 0.15s ease; box-shadow: var(--shadow);
            }
            .plan:hover { border-color: var(--blue); }
            .plan[aria-pressed="true"] { border-color: var(--blue); background: var(--blue-soft); }
            .plan .prod { font-size: 11.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-faint); }
            .plan .name { font-family: "Funnel Display", serif; font-size: 18px; font-weight: 700; color: var(--heading); }
            .plan .price { font-size: 26px; font-weight: 700; color: var(--heading); font-variant-numeric: tabular-nums; }
            .plan .price small { font-size: 13px; font-weight: 600; color: var(--text-dim); }
            .plan .desc { font-size: 13px; color: var(--text-dim); }
            .plan ul { margin: 6px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
            .plan li { font-size: 13px; padding-left: 18px; position: relative; }
            .plan li::before { content: "✓"; position: absolute; left: 0; color: var(--good); font-weight: 700; }
            .plan .tag { position: absolute; top: 12px; right: 12px; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 99px; background: var(--amber); color: var(--navy); }
            .pay-box { background: var(--navy); color: #f2f4fb; border-radius: var(--radius); padding: 18px 18px 14px; box-shadow: var(--shadow); }
            .pay-box h3 { color: #fff; font-size: 16px; margin-bottom: 10px; }
            .pay-row { display: flex; justify-content: space-between; gap: 10px; align-items: center; padding: 9px 0; border-top: 1px solid rgba(255, 255, 255, 0.12); font-size: 14px; }
            .pay-row span { color: #b7bcda; }
            .pay-row b { font-variant-numeric: tabular-nums; }
            .copy { background: none; border: 1px solid rgba(255, 255, 255, 0.3); color: #f2f4fb; border-radius: 99px; font: inherit; font-size: 12px; font-weight: 600; padding: 3px 10px; cursor: pointer; margin-left: 8px; }
            .copy:hover { border-color: #fff; }
            select {
                width: 100%; border: 1px solid var(--border); border-radius: 9px; background: var(--surface);
                color: var(--text); padding: 11px 12px; font-size: 14.5px; font-family: inherit;
            }
            .hint { font-size: 12.5px; color: var(--text-faint); }
            .err { font-size: 12.5px; color: var(--bad); }
            .done-box { text-align: center; padding: 28px 8px; }
            .done-box .check { width: 56px; height: 56px; border-radius: 99px; background: var(--good-bg); color: var(--good); font-size: 28px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; }
            .done-box p { color: var(--text-dim); font-size: 14.5px; line-height: 1.55; max-width: 46ch; margin: 10px auto 0; }
            .done-box .btn { margin-top: 18px; }
        </style>
    </head>
    <body>
        <div class="wrap">
            <a class="brand" href="/" aria-label="Midaz, volver al inicio">
                <img class="logo-light" src="/logo-blue.svg" alt="Midaz" />
                <img class="logo-dark" src="/logo-white.svg" alt="" aria-hidden="true" />
            </a>
            <header class="topbar">
                <span class="eyebrow">Midaz · Empieza hoy</span>
                <h1>Crea tu cuenta</h1>
            </header>

            <div class="step-progress">
                <div class="step-label" id="stepLabel">Paso 1</div>
                <div class="dots" id="stepDots"></div>
            </div>

            <div id="stepContainer"></div>

            <footer class="foot">¿Prefieres que te acompañemos? Escríbenos a {SUPPORT_EMAIL}.</footer>
        </div>

        <script is:inline define:vars={{ SUPPORT_EMAIL, PAGO_MOVIL, PLANS, BANKS }}>
            (function () {
                "use strict";

                var STORE_KEY = "midaz-alta-v1";
                var STEPS = ["Tus datos", "Tu plan", "Pago Móvil"];
                var state = load() || { step: 0, data: {}, plan: null, pay: {} };
                var D = state.data, Y = state.pay;
                var container = document.getElementById("stepContainer");

                function load() { try { return JSON.parse(localStorage.getItem(STORE_KEY)); } catch (e) { return null; } }
                function persist() { try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) {} }
                function $(id) { return document.getElementById(id); }
                function esc(s) {
                    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
                        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
                    });
                }
                function plan() { return PLANS.filter(function (p) { return p.id === state.plan; })[0] || null; }
                function usd(n) { return "$" + n.toLocaleString("en-US"); }

                function validEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v || ""); }
                function digits(v) { return (v || "").replace(/\D/g, ""); }
                function validRif(v) { return /^[VEJGPC]-?\d{6,9}(-?\d)?$/i.test((v || "").trim()); }

                function missingData() {
                    var m = [];
                    if (!D.name || !D.name.trim()) m.push("tu nombre");
                    if (!D.company || !D.company.trim()) m.push("la empresa");
                    if (!validRif(D.rif)) m.push("RIF válido");
                    if (!validEmail(D.email)) m.push("correo válido");
                    if (digits(D.phone).length < 10) m.push("teléfono");
                    return m;
                }
                function missingPay() {
                    var m = [];
                    if (!Y.bank) m.push("banco de origen");
                    if (digits(Y.phone).length < 10) m.push("teléfono que pagó");
                    if (!/^[VEJGP]?-?\d{6,9}$/i.test((Y.id || "").trim())) m.push("cédula o RIF del titular");
                    if (!/^\d{4,12}$/.test(digits(Y.ref)) || digits(Y.ref) !== (Y.ref || "").trim()) m.push("referencia (solo números, 4 a 12 dígitos)");
                    if (!(parseFloat(String(Y.amount || "").replace(",", ".")) > 0)) m.push("monto pagado");
                    if (!Y.date) m.push("fecha del pago");
                    return m;
                }

                function goTo(i) {
                    if (i > 0 && missingData().length) i = 0;
                    if (i > 1 && !plan()) i = 1;
                    state.step = i;
                    persist();
                    render();
                    window.scrollTo({ top: 0, behavior: "smooth" });
                }

                function render() {
                    if (state.step > 0 && missingData().length) state.step = 0;
                    if (state.step > 1 && !plan()) state.step = 1;
                    var done = state.step === 3;
                    $("stepDots").innerHTML = STEPS.map(function (_, i) {
                        return '<span class="dot' + (i < state.step ? " done" : i === state.step ? " current" : "") + '"></span>';
                    }).join("");
                    $("stepLabel").textContent = done ? "Listo" : "Paso " + (state.step + 1) + " de " + STEPS.length + " · " + STEPS[state.step];
                    [renderData, renderPlans, renderPay, renderDone][state.step]();
                }

                function field(id, label, type, placeholder, value, extra) {
                    return '<div class="field"><label for="' + id + '">' + label + '</label><input id="' + id + '" type="' + type + '" placeholder="' + placeholder + '" value="' + esc(value) + '" ' + (extra || "") + "></div>";
                }

                function bindInputs(map, obj, update) {
                    Object.keys(map).forEach(function (id) {
                        var el = $(id);
                        el.addEventListener("input", function () { obj[map[id]] = el.value; persist(); update(); });
                    });
                }

                function renderData() {
                    container.innerHTML =
                        '<div class="step-intro"><h2>Cuéntanos quién eres</h2><p>Con esto creamos tu usuario. Te toma un minuto.</p></div>' +
                        '<div class="profile-fields">' +
                            '<div class="two">' +
                                field("fName", "Tu nombre", "text", "Nombre y apellido", D.name, 'autocomplete="name"') +
                                field("fCompany", "Empresa", "text", "Ej. Farmacia La Salud, C.A.", D.company, 'autocomplete="organization"') +
                            "</div>" +
                            '<div class="two">' +
                                field("fRif", "RIF de la empresa", "text", "J-12345678-9", D.rif, 'autocapitalize="characters"') +
                                field("fPhone", "Teléfono o WhatsApp", "tel", "0414 123 4567", D.phone, 'inputmode="tel" autocomplete="tel"') +
                            "</div>" +
                            field("fEmail", "Correo para tu usuario", "email", "tu@empresa.com", D.email, 'inputmode="email" autocomplete="email"') +
                        "</div>" +
                        '<div class="step-nav"><span class="nav-fill missing-note" id="missingNote"></span><button type="button" class="btn btn-blue" id="nextBtn">Continuar</button></div>';
                    function update() {
                        var m = missingData();
                        $("nextBtn").disabled = m.length > 0;
                        $("missingNote").textContent = m.length ? "Falta: " + m.join(", ") : "";
                    }
                    bindInputs({ fName: "name", fCompany: "company", fRif: "rif", fPhone: "phone", fEmail: "email" }, D, update);
                    update();
                    $("nextBtn").addEventListener("click", function () { goTo(1); });
                }

                function renderPlans() {
                    container.innerHTML =
                        '<div class="step-intro"><h2>Elige tu plan</h2><p>Precios en dólares. Pagas en bolívares a la tasa BCV del día.</p></div>' +
                        '<div class="plans">' + PLANS.map(function (p) {
                            return '<button type="button" class="plan" data-id="' + p.id + '" aria-pressed="' + (state.plan === p.id) + '">' +
                                (p.recommended ? '<span class="tag">Recomendado</span>' : "") +
                                '<span class="prod">' + esc(p.product) + '</span><span class="name">' + esc(p.name) + "</span>" +
                                '<span class="price">' + usd(p.price) + "<small>" + p.period + "</small></span>" +
                                '<span class="desc">' + esc(p.description) + "</span>" +
                                "<ul>" + p.features.map(function (f) { return "<li>" + esc(f) + "</li>"; }).join("") + "</ul></button>";
                        }).join("") + "</div>" +
                        '<div class="step-nav"><button type="button" class="btn btn-outline" id="backBtn">◀ Atrás</button><button type="button" class="btn btn-blue" id="nextBtn">Ir a pagar ▶</button></div>';
                    function update() {
                        container.querySelectorAll(".plan").forEach(function (b) { b.setAttribute("aria-pressed", b.dataset.id === state.plan ? "true" : "false"); });
                        $("nextBtn").disabled = !plan();
                    }
                    container.querySelectorAll(".plan").forEach(function (b) {
                        b.addEventListener("click", function () { state.plan = b.dataset.id; persist(); update(); });
                    });
                    update();
                    $("backBtn").addEventListener("click", function () { goTo(0); });
                    $("nextBtn").addEventListener("click", function () { goTo(2); });
                }

                function renderPay() {
                    var p = plan();
                    var today = new Date().toISOString().slice(0, 10);
                    if (!Y.date) Y.date = today;
                    container.innerHTML =
                        '<div class="step-intro"><h2>Paga por Pago Móvil</h2><p>Haz el Pago Móvil desde tu banco con estos datos y luego registra la referencia.</p></div>' +
                        '<div class="pay-box">' +
                            "<h3>" + esc(p.product + " · " + p.name) + "</h3>" +
                            '<div class="pay-row"><span>Monto</span><b>' + usd(p.price) + " en Bs a tasa BCV</b></div>" +
                            '<div class="pay-row"><span>Banco</span><b>' + esc(PAGO_MOVIL.banco) + '<button type="button" class="copy" data-copy="' + esc(PAGO_MOVIL.banco.slice(0, 4)) + '">Copiar</button></b></div>' +
                            '<div class="pay-row"><span>Teléfono</span><b>' + esc(PAGO_MOVIL.telefono) + '<button type="button" class="copy" data-copy="' + esc(digits(PAGO_MOVIL.telefono)) + '">Copiar</button></b></div>' +
                            '<div class="pay-row"><span>RIF</span><b>' + esc(PAGO_MOVIL.rif) + '<button type="button" class="copy" data-copy="' + esc(PAGO_MOVIL.rif) + '">Copiar</button></b></div>' +
                        "</div>" +
                        '<div class="step-head-row" style="padding-top:22px"><h2>Registra tu pago</h2></div>' +
                        '<div class="profile-fields">' +
                            '<div class="two">' +
                                '<div class="field"><label for="pBank">Banco desde el que pagaste</label><select id="pBank"><option value="">Selecciona tu banco</option>' +
                                    BANKS.map(function (b) { return '<option' + (Y.bank === b ? " selected" : "") + ">" + esc(b) + "</option>"; }).join("") +
                                "</select></div>" +
                                field("pPhone", "Teléfono que pagó", "tel", "0414 123 4567", Y.phone || D.phone, 'inputmode="tel"') +
                            "</div>" +
                            '<div class="two">' +
                                field("pId", "Cédula o RIF del titular", "text", "V-12345678", Y.id, 'autocapitalize="characters"') +
                                field("pRef", "Número de referencia", "text", "Ej. 004512", Y.ref, 'inputmode="numeric" maxlength="12"') +
                            "</div>" +
                            '<div class="two">' +
                                field("pAmount", "Monto pagado (Bs)", "text", "Ej. 1.234,56", Y.amount, 'inputmode="decimal"') +
                                field("pDate", "Fecha del pago", "date", "", Y.date, 'max="' + today + '"') +
                            "</div>" +
                            '<p class="hint">La referencia está en el comprobante que te da tu banco al terminar el Pago Móvil.</p>' +
                        "</div>" +
                        '<div class="step-nav"><button type="button" class="btn btn-outline" id="backBtn">◀ Atrás</button><span class="nav-fill missing-note" id="missingNote"></span><button type="button" class="btn btn-blue" id="nextBtn">Validar pago</button></div>';

                    if (!Y.phone) Y.phone = D.phone;
                    function update() {
                        var m = missingPay();
                        $("nextBtn").disabled = m.length > 0;
                        $("missingNote").textContent = m.length ? "Falta: " + m.join(", ") : "";
                    }
                    bindInputs({ pPhone: "phone", pId: "id", pRef: "ref", pAmount: "amount", pDate: "date" }, Y, update);
                    $("pBank").addEventListener("change", function () { Y.bank = this.value; persist(); update(); });
                    container.querySelectorAll(".copy").forEach(function (b) {
                        b.addEventListener("click", function () {
                            if (navigator.clipboard) navigator.clipboard.writeText(b.dataset.copy).catch(function () {});
                            b.textContent = "Copiado ✓";
                            setTimeout(function () { b.textContent = "Copiar"; }, 1500);
                        });
                    });
                    update();
                    $("backBtn").addEventListener("click", function () { goTo(1); });
                    $("nextBtn").addEventListener("click", function () {
                        if (missingPay().length) return;
                        state.sentAt = new Date().toISOString();
                        goTo(3);
                    });
                }

                function summary() {
                    var p = plan();
                    return [
                        "Nueva alta en Midaz",
                        "",
                        "Cliente",
                        "- Nombre: " + D.name,
                        "- Empresa: " + D.company,
                        "- RIF: " + D.rif,
                        "- Correo: " + D.email,
                        "- Teléfono: " + D.phone,
                        "",
                        "Plan: " + p.product + " " + p.name + " (" + usd(p.price) + p.period + ")",
                        "",
                        "Pago Móvil por verificar",
                        "- Banco de origen: " + Y.bank,
                        "- Teléfono que pagó: " + Y.phone,
                        "- Cédula/RIF del titular: " + Y.id,
                        "- Referencia: " + digits(Y.ref),
                        "- Monto: Bs " + Y.amount,
                        "- Fecha: " + Y.date,
                    ].join("\n");
                }

                function renderDone() {
                    var p = plan();
                    var mailto = "mailto:" + SUPPORT_EMAIL + "?subject=" + encodeURIComponent("Alta Midaz: " + D.company + " · ref " + digits(Y.ref)) + "&body=" + encodeURIComponent(summary());
                    container.innerHTML =
                        '<div class="done-box">' +
                            '<div class="check">✓</div>' +
                            "<h2>Último paso: envíanos tu pago</h2>" +
                            "<p>Toca el botón para mandar tu referencia " + esc(digits(Y.ref)) + " y tu plan " + esc(p.product + " " + p.name) +
                            " a soporte. Al confirmar el pago creamos tu usuario y te escribimos a <strong>" + esc(D.email) + "</strong>.</p>" +
                            '<a class="btn btn-primary" id="mailBtn" href="' + mailto + '">Enviar a soporte</a>' +
                            '<p class="hint" id="sentNote" hidden>Si no se abrió tu correo, escribe a ' + esc(SUPPORT_EMAIL) + " con tu referencia.</p>" +
                            '<p><button type="button" class="edit-profile-link" id="editBtn">✎ Corregir datos del pago</button></p>' +
                        "</div>";
                    $("mailBtn").addEventListener("click", function () { $("sentNote").hidden = false; });
                    $("editBtn").addEventListener("click", function () { goTo(2); });
                }

                render();
            })();
        </script>
    </body>
</html>
