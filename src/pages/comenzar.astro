---
import "../styles/globals.css";
import OnboardingScreen from "@/components/onboarding/OnboardingScreen";
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Solicita tu demo de Midaz — Tu cerebro operativo y fiscal para Venezuela" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@700&family=Inter:wght@400;500;600&display=swap"
            rel="stylesheet"
        />

        <title>Solicitar demo | Midaz</title>

        <style>
            *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
            html { scroll-behavior: smooth; }
            body {
                font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
                -webkit-font-smoothing: antialiased;
                background: #07143a;
                min-height: 100vh;
                overflow-x: hidden;
            }

            .ob-skeleton {
                min-height: 100vh;
                background: #07143a;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 20px;
            }
            .sk-icon {
                width: 56px; height: 56px;
                background: linear-gradient(90deg, #0d1f4a 25%, #1a3060 50%, #0d1f4a 75%);
                background-size: 200% 100%;
                animation: shimmer 1.5s infinite;
                border-radius: 12px;
            }
            .sk-title {
                width: 280px; height: 40px;
                background: linear-gradient(90deg, #0d1f4a 25%, #1a3060 50%, #0d1f4a 75%);
                background-size: 200% 100%;
                animation: shimmer 1.5s infinite;
                border-radius: 8px;
            }
            .sk-sub {
                width: 200px; height: 20px;
                background: linear-gradient(90deg, #0d1f4a 25%, #1a3060 50%, #0d1f4a 75%);
                background-size: 200% 100%;
                animation: shimmer 1.5s infinite;
                border-radius: 6px;
            }
            .sk-btn {
                width: 180px; height: 52px;
                background: linear-gradient(90deg, #003ab0 25%, #004be0 50%, #003ab0 75%);
                background-size: 200% 100%;
                animation: shimmer 1.5s infinite;
                border-radius: 8px;
                margin-top: 8px;
            }
            @keyframes shimmer {
                0%   { background-position: 200% 0; }
                100% { background-position: -200% 0; }
            }
        </style>
    </head>
    <body>
        <div class="ob-skeleton" id="ob-skeleton">
            <div class="sk-icon"></div>
            <div class="sk-title"></div>
            <div class="sk-sub"></div>
            <div class="sk-btn"></div>
        </div>

        <div id="ob-root">
            <OnboardingScreen client:load />
        </div>

        <script>
            const root = document.getElementById("ob-root");
            const skeleton = document.getElementById("ob-skeleton");

            const obs = new MutationObserver(() => {
                if (root && root.children.length > 0) {
                    if (skeleton) skeleton.style.display = "none";
                    obs.disconnect();
                }
            });
            if (root) obs.observe(root, { childList: true, subtree: true });

            setTimeout(() => {
                if (skeleton) skeleton.style.display = "none";
            }, 2500);
        </script>
    </body>
</html>
