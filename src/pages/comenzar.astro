---
// Probar Midaz: preguntas de solo tocar sobre el negocio, plan recomendado con su cotización y datos de contacto.
// La solicitud llega sola a soporte por correo (api/alta.js) y un asesor contacta al cliente para la demo o el alta.
// Planes y precios salen del catálogo comercial (catalogo.midazlatam.com): si cambian allá, se actualizan aquí en PLANS.
// Por ahora el formulario no ofrece complementos ni equipos (Fila Cero, Citas, Midaz Pay, Kiosko Atlas).
import "../styles/onboarding.css";
import { acceptedDocuments } from "../data/legal.mjs";
import { CONTACT } from "../data/contacto.mjs";

// Canal oficial (Términos y Condiciones, cláusula 1.3).
const SUPPORT_EMAIL = CONTACT.email;
// Documentos que el cliente acepta al enviar: versión vigente de cada uno, con su URL fija.
const LEGAL = acceptedDocuments().map(({ doc, title, version, url }) => ({ doc, title, version, url }));

// Planes del ERP web, del más chico al más grande: el orden es el nivel (tier) que usa la recomendación.
// Precios en REF + IVA; monthly/annual en null = a medida.
const PLANS = [
    {
        id: "arranca",
        name: "Arranca",
        monthly: 0,
        annual: 0,
        description: "Empieza gratis y paga solo si subes de plan",
        limits: "1 sucursal · 1 caja · 1 usuario · hasta 200 productos",
        features: ["Ventas y factura fiscal digital", "Inventario básico", "Impuestos, tasas e indicadores", "Guías y videos paso a paso"],
    },
    {
        id: "mi-negocio",
        name: "Mi Negocio",
        monthly: 15,
        annual: 150,
        description: "Para un local con una o dos cajas",
        limits: "1 sucursal · 2 cajas · 3 usuarios · productos ilimitados",
        features: ["Todo lo de Arranca", "Clientes y cuentas por cobrar (el fiado)", "Soporte por WhatsApp de lunes a viernes"],
    },
    {
        id: "crece",
        name: "Crece",
        monthly: 35,
        annual: 350,
        description: "Para crecer hasta 3 sucursales",
        limits: "Hasta 3 sucursales · cajas ilimitadas · 10 usuarios",
        features: ["Todo lo de Mi Negocio", "Compras y proveedores", "Tesorería: control de caja y bancos", "Puedes sumar Citas y Fila Cero"],
    },
    {
        id: "empresa",
        name: "Empresa",
        monthly: 65,
        annual: 650,
        description: "Para varias sucursales",
        limits: "Sucursales y cajas ilimitadas · 25 usuarios",
        features: ["Todo lo de Crece", "Contabilidad y nómina", "Auditoría", "Acceso para tu contador"],
    },
    {
        id: "cadena",
        name: "Cadena",
        monthly: null,
        annual: null,
        description: "Para cadenas y franquicias",
        limits: "Sucursales, cajas y usuarios ilimitados",
        features: ["Todo lo de Empresa", "Citas y Fila Cero incluidos", "Hermez, asistente con IA", "Soporte preferencial con SLA"],
    },
];

// Preguntas de solo tocar para conocer el negocio y recomendar el plan.
// "only" limita una pregunta a ciertos tipos de negocio; "short" es la etiqueta en el correo a soporte.
const QUESTIONS = [
    {
        key: "type",
        short: "Tipo de negocio",
        title: "¿Qué tipo de negocio tienes?",
        options: [
            ["retail", "Tienda o comercio", "Ropa, víveres, ferretería, tecnología…"],
            ["food", "Restaurante o comida", "Restaurante, cafetería, comida rápida"],
            ["pharmacy", "Farmacia"],
            ["services", "Servicios o clínica", "Consultorio, clínica, taller, peluquería…"],
            ["wholesale", "Mayorista o distribuidora", "Vendes a otros negocios"],
            ["other", "Otro"],
        ],
    },
    {
        key: "retailKind",
        only: ["retail"],
        short: "Vende",
        title: "¿Qué vendes principalmente?",
        options: [
            ["clothes", "Ropa y calzado"],
            ["grocery", "Víveres o abasto"],
            ["hardware", "Ferretería"],
            ["tech", "Tecnología"],
            ["beauty", "Belleza y cuidado personal"],
            ["other", "Otra cosa"],
        ],
    },
    {
        key: "foodService",
        only: ["food"],
        short: "Atención",
        title: "¿Cómo atiendes a tus clientes?",
        options: [
            ["tables", "En mesas"],
            ["counter", "En mostrador o para llevar"],
            ["delivery", "Sobre todo delivery"],
            ["mixed", "De todo un poco"],
        ],
    },
    {
        key: "branches",
        short: "Sucursales",
        title: "¿Cuántas sucursales tienes?",
        options: [
            ["1", "Una"],
            ["2-3", "2 o 3"],
            ["4+", "4 o más"],
            ["chain", "Cadena o franquicia", "Muchas sucursales con la misma marca"],
        ],
    },
    {
        key: "registers",
        short: "Cajas",
        title: "¿Cuántas cajas cobran a la vez?",
        hint: "Contando todas tus sucursales.",
        options: [["1", "Una"], ["2", "Dos"], ["3+", "3 o más"]],
    },
    {
        key: "users",
        short: "Usuarios",
        title: "¿Cuántas personas usarán Midaz?",
        hint: "Cajeros, administración y dueños, en todas tus sucursales.",
        options: [["1", "Solo yo"], ["2-3", "2 o 3"], ["4-10", "De 4 a 10"], ["11-25", "De 11 a 25"], ["25+", "Más de 25"]],
    },
    {
        key: "products",
        only: ["retail", "food", "pharmacy", "wholesale", "other"],
        short: "Productos",
        title: "¿Cuántos productos manejas?",
        options: [["<200", "Menos de 200"], ["200-5000", "De 200 a 5.000"], ["5000+", "Más de 5.000"]],
    },
    {
        key: "invoicing",
        short: "Facturación",
        title: "¿Cómo facturas hoy?",
        hint: "Desde el 19 de abril de 2027 ya no se podrá facturar en forma libre (Providencia SNAT/2026/00093). Midaz emite tu factura fiscal con imprenta digital autorizada (HKA y Unidigital).",
        options: [
            ["fiscal", "Con máquina fiscal"],
            ["digital", "Con factura digital"],
            ["free", "En forma libre", "Talonario de imprenta"],
            ["none", "Todavía no facturo"],
        ],
    },
    {
        key: "system",
        short: "Sistema actual",
        title: "¿Qué sistema usas hoy?",
        hint: "Te ayudamos a pasar tus datos a Midaz sin perderlos, también desde Excel.",
        options: [
            ["saint", "Saint"],
            ["profit", "Profit"],
            ["galac", "Gálac"],
            ["valery", "Valery"],
            ["other", "Otro sistema"],
            ["none", "Ninguno", "Excel, cuaderno o estoy empezando"],
        ],
    },
    {
        key: "goals",
        multi: true,
        short: "Quiere resolver",
        title: "¿Qué quieres resolver primero?",
        hint: "Puedes tocar varias.",
        options: [
            ["billing", "Facturar más rápido"],
            ["stock", "Controlar el inventario"],
            ["credit", "Fiado y cuentas por cobrar"],
            ["purchases", "Compras y proveedores"],
            ["treasury", "Caja y bancos"],
            ["accounting", "Contabilidad y nómina"],
            ["branches", "Ver todas mis sucursales"],
            ["reports", "Reportes y cierres de caja"],
        ],
    },
];

// Mismos tipos de documento que el cotizador del catálogo.
const DOC_TYPES = ["J", "V", "E", "G", "P", "C"];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
        <meta
            name="description"
            content="Prueba Midaz: cuéntanos de tu negocio, te recomendamos un plan con su precio y un asesor te contacta para la demo o para activar tu cuenta."
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Prueba Midaz | Midaz</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@600;700&family=Funnel+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            .plans { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
            @media (max-width: 560px) { .plans { grid-template-columns: 1fr; } }
            .plan {
                position: relative; text-align: left; font-family: inherit; color: var(--text); cursor: pointer;
                background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius);
                padding: 16px; display: flex; flex-direction: column; gap: 6px; transition: 0.15s ease; box-shadow: var(--shadow);
            }
            .plan:hover { border-color: var(--blue); }
            .plan[aria-pressed="true"] { border-color: var(--blue); background: var(--blue-soft); }
            .plan .name { font-family: "Funnel Display", serif; font-size: 18px; font-weight: 700; color: var(--heading); padding-right: 96px; }
            .plan .price { font-size: 26px; font-weight: 700; color: var(--heading); font-variant-numeric: tabular-nums; }
            .plan .price small { font-size: 13px; font-weight: 600; color: var(--text-dim); }
            .plan .save { font-size: 12px; font-weight: 700; color: var(--good); }
            .plan .desc { font-size: 13px; color: var(--text-dim); }
            .plan .limits { font-size: 12.5px; color: var(--text-faint); }
            .plan ul { margin: 6px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 4px; }
            .plan li { font-size: 13px; padding-left: 18px; position: relative; }
            .plan li::before { content: "✓"; position: absolute; left: 0; color: var(--good); font-weight: 700; }
            .plan .tag { position: absolute; top: 12px; right: 12px; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 99px; background: var(--amber); color: var(--navy); }
            .period { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 4px; border-radius: 14px; background: var(--surface-2); border: 1px solid var(--border); margin-bottom: 14px; }
            .period button { font-family: inherit; font-size: 13.5px; font-weight: 600; color: var(--text-dim); background: transparent; border: 0; border-radius: 10px; padding: 8px 14px; cursor: pointer; }
            .period button[aria-pressed="true"] { background: var(--surface); color: var(--heading); box-shadow: var(--shadow); }
            .period small { font-size: 12px; font-weight: 700; color: var(--good); margin-left: 4px; }
            .quote { margin-top: 16px; background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 16px 18px; box-shadow: var(--shadow); }
            .quote h3 { font-size: 16px; margin-bottom: 6px; }
            .quote .row { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; font-size: 13.5px; padding: 7px 0; border-top: 1px solid var(--border); }
            .quote .row > :last-child { text-align: right; }
            .quote .row b { color: var(--heading); font-variant-numeric: tabular-nums; white-space: nowrap; }
            .quote .row.total { font-size: 15px; font-weight: 700; color: var(--heading); }
            .quote .row.total b { font-size: 17px; white-space: normal; }
            .quote .fine { font-size: 12.5px; color: var(--text-faint); margin: 12px 0 0; line-height: 1.5; }
            .nav-total { display: flex; flex-direction: column; align-items: flex-end; text-align: right; font-size: 12px; color: var(--text-dim); line-height: 1.3; }
            .nav-total b { font-size: 15px; color: var(--heading); font-variant-numeric: tabular-nums; }
            .quote .row.total > span { white-space: nowrap; }
            /* En pantallas angostas, el total y la nota de lo que falta van en su propia fila, sobre los botones. */
            @media (max-width: 560px) {
                .step-nav { flex-wrap: wrap; }
                .step-nav .nav-total, .step-nav .missing-note, .step-nav .err { order: -1; flex-basis: 100%; }
                .step-nav .nav-total { flex-direction: row; justify-content: space-between; align-items: baseline; gap: 12px; }
                .step-nav .missing-note:empty { display: none; }
            }
            .hint { font-size: 12.5px; color: var(--text-faint); }
            .hint a, .err a { color: var(--blue); font-weight: 600; }
            .err { font-size: 13px; color: var(--bad); }
            .opts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
            @media (max-width: 560px) { .opts { grid-template-columns: 1fr; } }
            .opt {
                text-align: left; font-family: inherit; color: var(--text); cursor: pointer; background: var(--surface);
                border: 1.5px solid var(--border); border-radius: var(--radius); padding: 16px 18px; min-height: 60px;
                display: flex; flex-direction: column; justify-content: center; gap: 3px; transition: 0.15s ease; box-shadow: var(--shadow);
            }
            .opt b { font-size: 16px; font-weight: 600; color: var(--heading); }
            .opt small { font-size: 13px; color: var(--text-dim); }
            .opt:hover { border-color: var(--blue); }
            .opt[aria-pressed="true"] { border-color: var(--blue); background: var(--blue-soft); }
            .opt[aria-pressed="true"] b { color: var(--blue); }
            .opt.multi { padding-left: 46px; position: relative; }
            .opt.multi::before {
                content: ""; position: absolute; left: 16px; top: 50%; width: 18px; height: 18px; margin-top: -9px;
                border: 1.5px solid var(--border); border-radius: 5px; background: var(--surface);
            }
            .opt.multi[aria-pressed="true"]::before { content: "✓"; color: #fff; background: var(--blue); border-color: var(--blue); font-size: 13px; font-weight: 700; line-height: 18px; text-align: center; }
            .modes { margin-bottom: 20px; }
            .doc { display: grid; grid-template-columns: 76px 1fr; gap: 8px; }
            select {
                width: 100%; border: 1px solid var(--border); border-radius: 9px; background: var(--surface);
                color: var(--text); padding: 11px 10px; font-size: 14.5px; font-family: inherit;
            }
            .consent { display: flex; flex-direction: column; gap: 12px; margin-top: 22px; }
            .check-row { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.5; color: var(--text); cursor: pointer; }
            .check-row input { flex: none; width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--blue); cursor: pointer; }
            .check-row a { color: var(--blue); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
            .check-row.optional { color: var(--text-dim); font-size: 13.5px; }
            .done-box { text-align: center; padding: 28px 8px; }
            .done-box .check { width: 56px; height: 56px; border-radius: 99px; background: var(--good-bg); color: var(--good); font-size: 28px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 14px; }
            .done-box p { color: var(--text-dim); font-size: 14.5px; line-height: 1.55; max-width: 46ch; margin: 10px auto 0; }
            .done-box .btn { margin-top: 18px; }
            footer.foot a { color: var(--blue); font-weight: 600; }
        </style>
    </head>
    <body>
        <div class="wrap">
            <a class="brand" href="/" aria-label="Midaz, volver al inicio">
                <img class="logo-light" src="/logo-blue.svg" alt="Midaz" />
                <img class="logo-dark" src="/logo-white.svg" alt="" aria-hidden="true" />
            </a>
            <header class="topbar">
                <span class="eyebrow">Midaz · Prueba Midaz</span>
                <h1>Arma tu Midaz</h1>
            </header>

            <div class="step-progress">
                <div class="step-label" id="stepLabel">Paso 1</div>
                <div class="dots" id="stepDots"></div>
            </div>

            <div id="stepContainer"></div>

            <footer class="foot">
                ¿Prefieres hablar con alguien? Escríbenos por <a href={CONTACT.whatsappUrl} target="_blank" rel="noopener">WhatsApp al {CONTACT.whatsappText}</a>
                ({CONTACT.hours.toLowerCase()}) o a <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
            </footer>
        </div>

        <script is:inline define:vars={{ SUPPORT_EMAIL, PLANS, QUESTIONS, DOC_TYPES, LEGAL }}>
            (function () {
                "use strict";

                var STORE_KEY = "midaz-alta-v4";
                var state = load() || { step: 0, answers: {}, plan: null, period: "monthly", mode: "demo", data: {} };
                var A = state.answers, D = state.data;
                var container = document.getElementById("stepContainer");

                function load() { try { return JSON.parse(localStorage.getItem(STORE_KEY)); } catch (e) { return null; } }
                function persist() { try { localStorage.setItem(STORE_KEY, JSON.stringify(state)); } catch (e) {} }
                function $(id) { return document.getElementById(id); }
                function esc(s) {
                    return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
                        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
                    });
                }
                function ref(n) { return "REF " + n.toLocaleString("es-VE"); }
                function validEmail(v) { return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v || ""); }
                function digits(v) { return (v || "").replace(/\D/g, ""); }

                // Algunas preguntas solo aplican según el tipo de negocio.
                function applies(q) {
                    if (!q.only) return true;
                    // Sin tipo todavía, se cuenta como tienda para que el total de pasos no salte.
                    return q.only.indexOf(A.type || "retail") !== -1;
                }
                function questions() { return QUESTIONS.filter(applies); }
                // Pasos: preguntas, plan, datos. El paso siguiente al último es "Listo".
                function steps() {
                    return questions().map(function (q) { return { kind: "q", q: q, label: "Tu negocio" }; })
                        .concat([{ kind: "plan", label: "Tu plan" }, { kind: "data", label: "Tus datos" }]);
                }
                function answered(q) { return q.multi ? (A[q.key] || []).length > 0 : !!A[q.key]; }
                function optionLabel(q, v) { var o = q.options.filter(function (x) { return x[0] === v; })[0]; return o ? o[1] : v; }
                function has(key, v) { return (A[key] || []).indexOf(v) !== -1; }

                // Plan recomendado (índice en PLANS): el mayor de los mínimos que piden el rubro, el tamaño y lo que quiere resolver.
                // Sigue la guía de cierre del catálogo (1 o 2 cajas: Mi Negocio; hasta 3 sucursales: Crece; varias: Empresa)
                // y los límites de cada plan.
                function recommendedTier() {
                    var t = 0;
                    function atLeast(n) { if (n > t) t = n; }
                    if (A.type === "food" || A.type === "pharmacy") atLeast(2);
                    if (A.branches === "chain") atLeast(4); else if (A.branches === "4+") atLeast(3); else if (A.branches === "2-3") atLeast(2);
                    if (A.registers === "3+") atLeast(2); else if (A.registers === "2") atLeast(1);
                    if (A.users === "25+") atLeast(4); else if (A.users === "11-25") atLeast(3); else if (A.users === "4-10") atLeast(2); else if (A.users === "2-3") atLeast(1);
                    if (A.products && A.products !== "<200") atLeast(1);
                    if (has("goals", "accounting")) atLeast(3);
                    if (has("goals", "purchases") || has("goals", "treasury")) atLeast(2);
                    if (has("goals", "credit")) atLeast(1);
                    return t;
                }
                function recommended() { return PLANS[recommendedTier()].id; }
                function tierOf(id) { for (var i = 0; i < PLANS.length; i++) if (PLANS[i].id === id) return i; return -1; }
                function plan() { return PLANS[tierOf(state.plan)] || null; }

                // Precio del plan según la forma de pago elegida.
                function planPrice(p) {
                    if (p.monthly == null) return { main: "A medida", per: "" };
                    if (p.monthly === 0) return { main: ref(0), per: " sin mensualidad" };
                    return state.period === "annual" ? { main: ref(p.annual), per: "/año", save: "Ahorras " + ref(p.monthly * 12 - p.annual) } : { main: ref(p.monthly), per: "/mes" };
                }

                // Total del plan elegido según la forma de pago.
                function total() {
                    var p = plan();
                    if (p.monthly == null) return "A medida";
                    if (p.monthly === 0) return ref(0) + ", sin mensualidad";
                    return state.period === "annual" ? ref(p.annual) + "/año + IVA" : ref(p.monthly) + "/mes + IVA";
                }

                function legalLink(doc) {
                    var d = LEGAL.filter(function (x) { return x.doc === doc; })[0];
                    return '<a href="' + d.url + '" target="_blank" rel="noopener">' + esc(d.title) + "</a>";
                }
                // La aceptación no se guarda: la casilla empieza desmarcada cada vez que se muestra el paso.
                var consent = { accepted: false, marketing: false };

                // Cédula o RIF: letra + número. Con 9 dígitos es un RIF y lleva el dígito verificador aparte (J-50863327-0).
                function docText() {
                    var n = digits(D.docNumber);
                    return (D.docType || "J") + "-" + (n.length === 9 ? n.slice(0, 8) + "-" + n.slice(8) : n);
                }
                function missingData() {
                    var m = [];
                    if (!D.name || !D.name.trim()) m.push("tu nombre");
                    if (!D.company || !D.company.trim()) m.push("el nombre del comercio");
                    var n = digits(D.docNumber).length;
                    if (n < 6 || n > 9) m.push("cédula o RIF");
                    if (!validEmail(D.email)) m.push("correo válido");
                    if (digits(D.phone).length < 10) m.push("teléfono");
                    return m;
                }

                // Primer paso que todavía no se puede pasar.
                function firstOpen() {
                    var list = steps();
                    for (var i = 0; i < list.length; i++) {
                        var s = list[i];
                        if (s.kind === "q" && !answered(s.q)) return i;
                        if (s.kind === "plan" && !plan()) return i;
                        if (s.kind === "data" && (missingData().length || !state.sentAt)) return i;
                    }
                    return list.length;
                }

                function goTo(i) {
                    state.step = Math.max(0, Math.min(i, firstOpen()));
                    persist();
                    render();
                    window.scrollTo({ top: 0, behavior: "smooth" });
                }

                function render() {
                    var list = steps();
                    state.step = Math.min(state.step, firstOpen());
                    var done = state.step >= list.length;
                    $("stepDots").innerHTML = list.map(function (_, i) {
                        return '<span class="dot' + (i < state.step ? " done" : i === state.step ? " current" : "") + '"></span>';
                    }).join("");
                    $("stepLabel").textContent = done ? "Listo" : "Paso " + (state.step + 1) + " de " + list.length + " · " + list[state.step].label;
                    if (done) return renderDone();
                    var s = list[state.step];
                    if (s.kind === "q") renderQuestion(s.q);
                    else if (s.kind === "plan") renderPlans();
                    else renderData();
                }

                function backButton() { return state.step > 0 ? '<button type="button" class="btn btn-outline" id="backBtn">◀ Atrás</button>' : "<span></span>"; }
                function bindBack() { var b = $("backBtn"); if (b) b.addEventListener("click", function () { goTo(state.step - 1); }); }

                function renderQuestion(q) {
                    var value = A[q.key];
                    container.innerHTML =
                        '<div class="step-intro"><h2>' + esc(q.title) + "</h2><p>" + esc(q.hint || "Toca una opción.") + "</p></div>" +
                        '<div class="opts">' + q.options.map(function (o) {
                            var on = q.multi ? (value || []).indexOf(o[0]) !== -1 : value === o[0];
                            return '<button type="button" class="opt' + (q.multi ? " multi" : "") + '" data-value="' + esc(o[0]) + '" aria-pressed="' + on + '">' +
                                "<b>" + esc(o[1]) + "</b>" + (o[2] ? "<small>" + esc(o[2]) + "</small>" : "") + "</button>";
                        }).join("") + "</div>" +
                        '<div class="step-nav">' + backButton() + (q.multi || value ? '<button type="button" class="btn btn-blue" id="nextBtn">Continuar ▶</button>' : "") + "</div>";

                    function update() { var n = $("nextBtn"); if (n) n.disabled = !answered(q); }
                    container.querySelectorAll(".opt").forEach(function (b) {
                        b.addEventListener("click", function () {
                            var v = b.dataset.value;
                            if (q.multi) {
                                var list = (A[q.key] || []).slice();
                                var at = list.indexOf(v);
                                if (at === -1) list.push(v); else list.splice(at, 1);
                                A[q.key] = list;
                                b.setAttribute("aria-pressed", at === -1 ? "true" : "false");
                                persist();
                                update();
                                return;
                            }
                            A[q.key] = v;
                            // Si cambia el tipo de negocio, se borran las respuestas que ya no aplican.
                            QUESTIONS.forEach(function (x) { if (!applies(x)) delete A[x.key]; });
                            container.querySelectorAll(".opt").forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
                            persist();
                            setTimeout(function () { goTo(state.step + 1); }, 220);
                        });
                    });
                    update();
                    bindBack();
                    var n = $("nextBtn");
                    if (n) n.addEventListener("click", function () { goTo(state.step + 1); });
                }

                function renderPlans(focusSel) {
                    var rec = recommended();
                    // Mientras el cliente no elija otro, el plan sigue a la recomendación (cambia si cambian las respuestas).
                    if (!state.plan || !state.planTouched) state.plan = rec;
                    var p = plan();
                    container.innerHTML =
                        '<div class="step-intro"><h2>Este es el plan para tu negocio</h2><p>Lo elegimos con tus respuestas. Si prefieres otro, tócalo. Sin permanencia: cambias de plan cuando tu negocio lo pida.</p></div>' +
                        '<div class="period" role="group" aria-label="Forma de pago">' +
                            '<button type="button" data-period="monthly" aria-pressed="' + (state.period !== "annual") + '">Mensual</button>' +
                            '<button type="button" data-period="annual" aria-pressed="' + (state.period === "annual") + '">Anual<small>12 meses por el precio de 10</small></button>' +
                        "</div>" +
                        // El recomendado va primero para que se vea sin bajar; los demás, de menor a mayor.
                        '<div class="plans">' + PLANS.slice().sort(function (a, b) { return (b.id === rec) - (a.id === rec); }).map(function (x) {
                            var pr = planPrice(x);
                            return '<button type="button" class="plan" data-id="' + x.id + '" aria-pressed="' + (state.plan === x.id) + '">' +
                                (x.id === rec ? '<span class="tag">Recomendado para ti</span>' : "") +
                                '<span class="name">' + esc(x.name) + "</span>" +
                                '<span class="price">' + esc(pr.main) + "<small>" + esc(pr.per) + "</small></span>" +
                                (pr.save ? '<span class="save">' + esc(pr.save) + "</span>" : "") +
                                '<span class="desc">' + esc(x.description) + "</span>" +
                                '<span class="limits">' + esc(x.limits) + "</span>" +
                                "<ul>" + x.features.map(function (f) { return "<li>" + esc(f) + "</li>"; }).join("") + "</ul></button>";
                        }).join("") + "</div>" +
                        '<div class="quote" aria-live="polite">' +
                            "<h3>Tu cotización</h3>" +
                            '<div class="row total"><span>Plan ' + esc(p.name) + (p.monthly ? (state.period === "annual" ? " · anual" : " · mensual") : "") + "</span><b>" + esc(total()) + "</b></div>" +
                            (p.monthly == null ? '<p class="fine">Te cotizamos según tus sucursales y lo que necesite tu negocio.</p>' : "") +
                            '<p class="fine">Precios en REF + IVA: pagas en bolívares a la tasa BCV del día.' +
                                (state.period === "annual" && p.annual ? " En plan anual, los primeros 1.000 comercios mantienen su precio de fundador por 24 meses." : "") + "</p>" +
                        "</div>" +
                        // El total también va en la barra fija: con cinco planes, la cotización queda debajo del pliegue.
                        '<div class="step-nav">' + backButton() +
                            '<span class="nav-fill nav-total">' + esc(p.monthly == null ? "Plan " + p.name : "Total sugerido") + "<b>" + esc(total()) + "</b></span>" +
                            '<button type="button" class="btn btn-blue" id="nextBtn">Continuar ▶</button></div>';
                    persist();
                    container.querySelectorAll(".plan").forEach(function (b) {
                        b.addEventListener("click", function () {
                            state.plan = b.dataset.id;
                            state.planTouched = state.plan !== rec;
                            persist();
                            renderPlans('.plan[data-id="' + state.plan + '"]');
                        });
                    });
                    container.querySelectorAll("[data-period]").forEach(function (b) {
                        b.addEventListener("click", function () {
                            state.period = b.dataset.period;
                            persist();
                            renderPlans('[data-period="' + state.period + '"]');
                        });
                    });
                    // Al volver a pintar, el foco queda en el botón que se tocó (teclado y lector de pantalla).
                    if (focusSel) { var f = container.querySelector(focusSel); if (f) f.focus({ preventScroll: true }); }
                    bindBack();
                    $("nextBtn").addEventListener("click", function () { goTo(state.step + 1); });
                }

                function field(id, label, type, placeholder, value, extra) {
                    return '<div class="field"><label for="' + id + '">' + label + '</label><input id="' + id + '" type="' + type + '" placeholder="' + placeholder + '" value="' + esc(value) + '" ' + (extra || "") + "></div>";
                }

                function profile() {
                    return questions().map(function (q) {
                        var v = A[q.key];
                        var text = q.multi ? (v || []).map(function (x) { return optionLabel(q, x); }).join(", ") : optionLabel(q, v);
                        return q.short + ": " + text;
                    });
                }
                function planText() {
                    var p = plan(), pr = planPrice(p);
                    return p.name + (p.monthly ? (state.period === "annual" ? " anual" : " mensual") : "") + " (" + pr.main + pr.per + ")" +
                        (p.id === recommended() ? "" : " · elegido por el cliente; recomendado: " + PLANS[recommendedTier()].name);
                }
                var MODES = [
                    ["demo", "Quiero ver una demo", "Un asesor te muestra Midaz con tu negocio"],
                    ["activar", "Quiero activar mi plan", "Te escribimos para el pago y crear tu usuario"],
                ];

                function renderData() {
                    container.innerHTML =
                        '<div class="step-intro"><h2>¿Cómo quieres empezar?</h2><p>Último paso. Con esto un asesor de Midaz te escribe.</p></div>' +
                        '<div class="opts modes">' + MODES.map(function (m) {
                            return '<button type="button" class="opt" data-mode="' + m[0] + '" aria-pressed="' + (state.mode === m[0]) + '"><b>' + esc(m[1]) + "</b><small>" + esc(m[2]) + "</small></button>";
                        }).join("") + "</div>" +
                        '<div class="profile-fields">' +
                            '<div class="two">' +
                                field("fName", "Tu nombre", "text", "Nombre y apellido", D.name, 'autocomplete="name"') +
                                field("fCompany", "Nombre del comercio", "text", "Ej. Farmacia La Salud, C.A.", D.company, 'autocomplete="organization"') +
                            "</div>" +
                            '<div class="two">' +
                                '<div class="field"><label for="fDoc">Cédula o RIF</label><div class="doc">' +
                                    '<select id="fDocType" aria-label="Tipo de documento">' + DOC_TYPES.map(function (t) {
                                        return "<option" + ((D.docType || "J") === t ? " selected" : "") + ">" + t + "</option>";
                                    }).join("") + "</select>" +
                                    '<input id="fDoc" type="text" inputmode="numeric" placeholder="12345678-9" value="' + esc(D.docNumber) + '">' +
                                "</div></div>" +
                                field("fPhone", "Teléfono o WhatsApp", "tel", "0414 123 4567", D.phone, 'inputmode="tel" autocomplete="tel"') +
                            "</div>" +
                            field("fEmail", "Correo", "email", "tu@comercio.com", D.email, 'inputmode="email" autocomplete="email"') +
                        "</div>" +
                        '<div class="consent">' +
                            '<label class="check-row"><input type="checkbox" id="fAccept" required> <span>He leído y acepto los ' + legalLink("terminos") +
                                " y las " + legalLink("politicas") + ", y he leído la " + legalLink("privacidad") + " de Midaz.</span></label>" +
                            '<label class="check-row optional"><input type="checkbox" id="fMarketing"> <span>Quiero recibir novedades y promociones de Midaz por correo y WhatsApp.</span></label>' +
                        "</div>" +
                        '<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px">' +
                        '<div class="step-nav">' + backButton() + '<span class="nav-fill missing-note" id="missingNote"></span><span class="nav-fill err" id="sendError" role="alert" hidden></span><button type="button" class="btn btn-blue" id="nextBtn">Enviar solicitud</button></div>';

                    consent = { accepted: false, marketing: false };
                    function update() {
                        var m = missingData();
                        if (!consent.accepted) m.push("aceptar los Términos y Condiciones");
                        $("nextBtn").disabled = m.length > 0;
                        $("missingNote").textContent = m.length ? "Falta: " + m.join(", ") : "";
                        $("missingNote").hidden = !m.length;
                    }
                    container.querySelectorAll("[data-mode]").forEach(function (b) {
                        b.addEventListener("click", function () {
                            state.mode = b.dataset.mode;
                            container.querySelectorAll("[data-mode]").forEach(function (x) { x.setAttribute("aria-pressed", x === b ? "true" : "false"); });
                            persist();
                        });
                    });
                    var map = { fName: "name", fCompany: "company", fPhone: "phone", fEmail: "email" };
                    Object.keys(map).forEach(function (id) {
                        $(id).addEventListener("input", function () { D[map[id]] = this.value; persist(); update(); });
                    });
                    $("fDocType").addEventListener("change", function () { D.docType = this.value; persist(); });
                    $("fDoc").addEventListener("input", function () {
                        // Si pegan el documento completo (J-12345678-9), la letra pasa al selector.
                        var m = /^\s*([VEJGPC])/i.exec(this.value);
                        if (m) { D.docType = m[1].toUpperCase(); $("fDocType").value = D.docType; this.value = this.value.replace(/^\s*[A-Za-z]-?\s*/, ""); }
                        D.docNumber = this.value;
                        persist();
                        update();
                    });
                    $("fAccept").addEventListener("change", function () { consent.accepted = this.checked; update(); });
                    $("fMarketing").addEventListener("change", function () { consent.marketing = this.checked; });
                    update();
                    bindBack();
                    $("nextBtn").addEventListener("click", function () {
                        var btn = this;
                        if (missingData().length || !consent.accepted || btn.disabled) return;
                        btn.disabled = true;
                        btn.textContent = "Enviando…";
                        $("sendError").hidden = true;
                        fetch("/api/alta", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                name: D.name, company: D.company, rif: docText(), email: D.email, phone: D.phone,
                                plan: planText(), modalidad: state.mode, perfil: profile(), website: $("website").value,
                                // La hora, la IP y el navegador los toma el servidor; aquí solo va qué se aceptó.
                                aceptacion: {
                                    acepta: consent.accepted,
                                    documentos: LEGAL.map(function (d) { return { doc: d.doc, version: d.version }; }),
                                    comercial: consent.marketing,
                                },
                            }),
                        })
                            .then(function (r) {
                                if (r.status === 409) { location.reload(); throw new Error("versiones"); }
                                if (!r.ok) throw new Error(r.status);
                            })
                            .then(function () {
                                state.sentAt = new Date().toISOString();
                                goTo(state.step + 1);
                            })
                            .catch(function () {
                                btn.disabled = false;
                                btn.textContent = "Reintentar";
                                $("sendError").innerHTML = 'No pudimos enviar tu solicitud. Intenta de nuevo o <a href="' + mailto() + '">envíala por correo</a>.';
                                $("sendError").hidden = false;
                            });
                    });
                }

                function mailto() {
                    var demo = state.mode !== "activar";
                    var body = [demo ? "Solicitud de demo de Midaz" : "Nueva solicitud de alta en Midaz", "", "Quiere: " + (demo ? "ver una demo con un asesor" : "activar su plan"), "", "Cliente",
                        "- Nombre: " + D.name, "- Comercio: " + D.company, "- Cédula o RIF: " + docText(), "- Correo: " + D.email, "- Teléfono: " + D.phone,
                        "", "Negocio"].concat(profile().map(function (l) { return "- " + l; }), ["", "Plan: " + planText(), "",
                        "Aceptación: " + LEGAL.map(function (d) { return d.title + " " + d.version; }).join(", "),
                        "Novedades y promociones: " + (consent.marketing ? "sí" : "no")]).join("\n");
                    return "mailto:" + SUPPORT_EMAIL + "?subject=" + encodeURIComponent((demo ? "Demo" : "Alta") + " Midaz: " + D.company) + "&body=" + encodeURIComponent(body);
                }

                function renderDone() {
                    var p = plan(), demo = state.mode !== "activar";
                    container.innerHTML =
                        '<div class="done-box">' +
                            '<div class="check">✓</div>' +
                            "<h2>" + (demo ? "¡Listo! Te contactaremos para tu demo" : "¡Listo! Te contactaremos") + "</h2>" +
                            "<p>Recibimos tu solicitud del plan " + esc(p.name) + ". Un asesor de Midaz te escribirá a <strong>" + esc(D.email) +
                            "</strong> o al " + esc(D.phone) + (demo ? " para mostrarte Midaz con tu negocio." : " para coordinar el pago y activar tu cuenta.") + "</p>" +
                            '<p><button type="button" class="edit-profile-link" id="editBtn">✎ Empezar otra solicitud</button></p>' +
                        "</div>";
                    $("editBtn").addEventListener("click", function () {
                        state = { step: 0, answers: {}, plan: null, period: "monthly", mode: "demo", data: {} };
                        A = state.answers; D = state.data;
                        persist();
                        render();
                    });
                }

                render();
            })();
        </script>
    </body>
</html>
