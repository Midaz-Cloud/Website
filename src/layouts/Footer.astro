---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
    <div class="footer-inner">
        <!-- Grid superior -->
        <div class="footer-grid">
            <!-- Columna brand -->
            <div class="footer-brand">
                <a href="/" class="footer-logo">
                    <img src="/logo-white.svg" alt="Midaz" class="footer-logo-img" />
                </a>
                <p class="footer-tagline">Tu cerebro operativo y fiscal.</p>
            </div>

            <!-- Producto -->
            <div class="footer-col">
                <h4 class="footer-col-title">Producto</h4>
                <ul class="footer-links">
                    <li><a href="/#producto">Midaz Agora</a></li>
                    <li><a href="/#producto">Midaz Web</a></li>
                    <li><a href="#">Precios</a></li>
                    <li><a href="#">Roadmap</a></li>
                </ul>
            </div>

            <!-- Empresa -->
            <div class="footer-col">
                <h4 class="footer-col-title">Empresa</h4>
                <ul class="footer-links">
                    <li><a href="#">Nosotros</a></li>
                    <li><a href="#">Misión</a></li>
                    <li><a href="/#contacto">Contacto</a></li>
                </ul>
            </div>

            <!-- Soporte -->
            <div class="footer-col">
                <h4 class="footer-col-title">Soporte</h4>
                <ul class="footer-links">
                    <li><a href="#">Documentación</a></li>
                    <li><a href="#">FAQ</a></li>
                    <li><a href="#">Estado del sistema</a></li>
                </ul>
            </div>

            <!-- Legal -->
            <div class="footer-col">
                <h4 class="footer-col-title">Legal</h4>
                <ul class="footer-links">
                    <li><a href="/terminos">Términos de uso</a></li>
                    <li><a href="/privacidad">Privacidad</a></li>
                </ul>
            </div>
        </div>

        <!-- Línea divisoria -->
        <div class="footer-divider"></div>

        <!-- Bottom bar -->
        <div class="footer-bottom">
            <p>&copy; {currentYear} Midaz. Todos los derechos reservados.</p>
            <p>Hecho en Venezuela 🇻🇪</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background: #0a0a0a;
        padding: 80px 0 0;
    }
    .footer-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }
    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
        gap: 48px;
        margin-bottom: 64px;
    }
    .footer-logo {
        display: inline-flex;
        text-decoration: none;
        margin-bottom: 16px;
    }
    .footer-logo-img {
        height: 28px;
        width: auto;
    }
    .footer-tagline {
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: #a9ccff;
        margin: 0;
    }
    .footer-col-title {
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        color: #a9ccff;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 16px;
    }
    .footer-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .footer-links a {
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: rgba(169, 204, 255, 0.7);
        text-decoration: none;
        transition: color 0.2s ease;
    }
    .footer-links a:hover { color: #ffffff; }
    .footer-divider {
        height: 1px;
        background: rgba(0, 75, 224, 0.2);
    }
    .footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px 0;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: rgba(169, 204, 255, 0.5);
    }
    .footer-bottom p { margin: 0; }

    @media (max-width: 1024px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
            gap: 32px;
        }
        .footer-brand { grid-column: 1 / -1; }
    }
    @media (max-width: 640px) {
        .footer-grid { grid-template-columns: 1fr; }
        .footer-bottom {
            flex-direction: column;
            gap: 8px;
            text-align: center;
        }
    }
</style>
