---
import "../styles/globals.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/layouts/Footer.astro";
import WhatsAppWidget from "@/components/widgets/WhatsAppWidget.astro";

const {
    title = "Midaz - Conformidad Fiscal Simplificada y Eficiencia Operativa",
    description = "Sistema de punto de venta, inventario y facturación para tu negocio. Emite tus facturas a través de tu proveedor de emisión autorizado.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="keywords"
            content="POS Venezuela, ERP, facturación electrónica, sistema punto de venta, gestión empresarial, Midaz"
        />
        <meta
            property="og:title"
            content="Midaz - Tu cerebro operativo y fiscal"
        />
        <meta
            property="og:description"
            content="Sistema de punto de venta, inventario y facturación para tu negocio."
        />
        <meta property="og:image" content="/images/midaz-logo.png" />
        <meta property="og:type" content="website" />
        <meta property="og:locale" content="es_VE" />

        <!-- Google Fonts: Funnel Display + Inter -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@700&family=Inter:wght@400;500;600&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>

    </head>
    <body class="font-sans antialiased text-foreground bg-background">
        <Header currentPath={Astro.url.pathname} />
        <main>
            <slot />
        </main>
        <Footer />
        <WhatsAppWidget />
    </body>
</html>
