---
import "../styles/globals.css";
import WhatsAppButton from "../components/landing/WhatsAppButton.astro";
import { SOCIAL } from "../data/contacto.mjs";

const {
    title = "Midaz: facturación, ventas e inventario para tu negocio",
    description = "Sistema de facturación, punto de venta e inventario para comercios en Venezuela. IVA e IGTF automáticos, tasa BCV en vivo, modo offline y libros fiscales al día.",
    image = "/landing/og-image.jpg",
    // Solo la portada lleva la pantalla de carga del hero y precarga la laptop.
    intro = true,
    // Páginas que no deben indexarse (p. ej. versiones anteriores de un documento legal).
    noindex = false,
    // Ruta canónica cuando la página repite el contenido de otra (p. ej. /legal/terminos/v2-0 → /legal/terminos).
    canonicalPath = undefined,
} = Astro.props;

// Con `site` definido en astro.config.mjs se generan URLs absolutas (canonical, og:url, og:image).
const canonical = Astro.site ? new URL(canonicalPath ?? Astro.url.pathname, Astro.site).href : undefined;
// Los despliegues de vista previa de Vercel no se indexan.
const robots = process.env.VERCEL_ENV === "preview" ? "noindex, nofollow" : noindex ? "noindex, follow" : "index, follow";
const ogImage = Astro.site ? new URL(image, Astro.site).href : image;

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            name: "Midaz",
            logo: Astro.site ? new URL("/logo-blue.svg", Astro.site).href : "/logo-blue.svg",
            sameAs: Object.values(SOCIAL),
            ...(Astro.site && { url: Astro.site.href }),
        },
        {
            "@type": "SoftwareApplication",
            name: "Midaz",
            applicationCategory: "BusinessApplication",
            operatingSystem: "Web, Android, iOS",
            description,
            areaServed: "VE",
            inLanguage: "es",
        },
    ],
};
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#004be0" />
        <meta name="robots" content={robots} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="sitemap" href="/sitemap.xml" />
        <meta name="generator" content={Astro.generator} />
        {canonical && <link rel="canonical" href={canonical} />}

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Midaz" />
        <meta property="og:locale" content="es_VE" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Midaz. Factura, cobra y lleva tu inventario en un solo lugar." />
        {canonical && <meta property="og:url" content={canonical} />}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        {intro && <link rel="preload" as="image" href="/landing/macbook-full.webp" type="image/webp" fetchpriority="high" />}
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

        <!-- Google Fonts: Funnel Display + Poppins + Inter -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@600;700&family=Inter:wght@500;600;700&family=Poppins:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>

        <!-- Pantalla de carga y animación del titular: se deciden antes de pintar para que no parpadee el hero final.
             En cualquier pantalla, sin "reducir movimiento" y sin ancla en la URL. La carga se ve una vez por sesión. -->
        {
            intro && (
        <script is:inline>
            (function () {
                try {
                    var d = document.documentElement;
                    if (
                        !matchMedia("(prefers-reduced-motion: reduce)").matches &&
                        !location.hash
                    ) {
                        d.classList.add("hero-anim");
                        if (!sessionStorage.getItem("midaz-intro")) {
                            d.classList.add("carga");
                            // Escala del lienzo de 1280×800 desde el primer pintado, para que la carga no salte al arrancar.
                            // En pantallas angostas (teléfono) manda el ancho: el contenido del loader mide ~880 px del lienzo.
                            var cs = Math.min(innerHeight / 800, innerWidth / 880);
                            d.style.setProperty("--carga-s", String(cs));
                            d.style.setProperty("--carga-y", (innerHeight - 800 * cs) / 2 + "px");
                        }
                        // Red de seguridad: si el script no corre, el hero aparece igual.
                        setTimeout(function () {
                            if (!d.hasAttribute("data-intro-running")) d.classList.remove("carga", "hero-anim");
                        }, 2500);
                    }
                } catch (e) {}
            })();
        </script>
            )
        }
    </head>
    <body class="bg-landing-bg font-poppins text-landing-navy antialiased">
        <slot />
        <WhatsAppButton />
        <script>
            // Scroll suave con inercia (Lenis). Se desactiva si el sistema pide reducir movimiento.
            import Lenis from "lenis";
            import "lenis/dist/lenis.css";

            if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                // Se guarda en window para que las secciones con fila horizontal (FAQ) muevan la página con el deslizamiento lateral.
                (window as any).__lenis = new Lenis({ autoRaf: true, lerp: 0.09, anchors: { offset: -96 } });
            }
        </script>
    </body>
</html>
