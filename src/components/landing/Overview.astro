---
// Bloque de dos columnas: titular a la izquierda, explicación a la derecha.
interface Props {
    id?: string;
    align?: "between" | "center";
}
const { id, align = "between" } = Astro.props;
---

<section id={id} class:list={["px-4 sm:px-8", align === "between" ? "py-[60px] lg:pb-[62px] lg:pt-[61px]" : "py-[38px]"]}>
    <div
        class:list={[
            "mx-auto flex max-w-[1144px] flex-col gap-6 lg:flex-row lg:items-start",
            align === "between" ? "lg:justify-between" : "lg:items-center lg:justify-center lg:gap-[50px]",
        ]}
    >
        <h2
            class:list={[
                "max-w-[613px] font-funnel text-[clamp(1.75rem,4vw,2.125rem)] font-semibold leading-[1.18] tracking-[-0.85px] text-landing-navy",
                align === "between" ? "lg:flex-1" : "lg:flex-1 xl:w-[517px] xl:flex-none",
            ]}
        >
            <slot name="title" />
        </h2>
        <p class="max-w-[500px] text-base leading-[25px] text-[rgba(7,20,58,0.6)] lg:w-[500px] lg:shrink-0">
            <slot />
        </p>
    </div>
</section>
