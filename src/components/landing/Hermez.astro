---
const tick = "h-8 w-px bg-black/55";
---

<section id="hermez" class="overflow-hidden bg-[#fff7ef] px-4 pb-14 pt-10 sm:px-8 xl:h-[805px] xl:px-14 xl:pt-14">
    <div class="mx-auto max-w-[1168px]">
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-1 text-base leading-[19.5px] tracking-[-0.325px] md:justify-between">
            <p class="font-bold text-[#111210]">Inteligencia operativa</p>
            <p class="order-first w-full text-center font-semibold text-[#8f918c] md:order-none md:w-auto">Tu asistente virtual</p>
            <p class="font-bold text-[#111210]">Respuestas inmediatas</p>
        </div>

        <div class="relative mt-6 flex flex-col items-center gap-[27px] xl:mt-[16.5px]">
            <!-- Órbita técnica -->
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 flex items-center justify-center">
                <div class="relative aspect-square w-[min(580px,92vw)] shrink-0 rounded-full border border-black/40">
                    {
                        [0, 45, 90, 135].map((deg) => (
                            <div class="absolute inset-0 flex flex-col items-center justify-between" style={`transform: rotate(${deg}deg)`}>
                                <span class={tick} />
                                <span class={tick} />
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="relative flex h-14 items-center justify-center">
                <h2 class="translate-y-[41px] font-funnel text-[clamp(4.5rem,16vw,8rem)] font-bold leading-[45px] tracking-[-1.76px] text-landing-orange">HERMEZ</h2>
            </div>
            <div class="relative flex aspect-square w-[min(490px,80vw)] items-center justify-center">
                <!-- Video del Figma con fondo transparente, recortado al personaje (en el Figma: 1160×652 sobre el cuadro de 490) -->
                <div class="absolute left-[11.16%] top-[-1.52%] aspect-[404/564] w-[74.72%]" data-hermez>
                    <video
                        class="size-full"
                        width="404"
                        height="564"
                        poster="/landing/hermez-poster.webp"
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="auto"
                        aria-label="Hermez, el asistente virtual de Midaz"
                    >
                        <source src="/landing/hermez.webm" type="video/webm" />
                    </video>
                </div>
            </div>
        </div>

        <div class="mx-auto mt-6 flex max-w-[658px] flex-col items-center gap-[5px] text-center xl:mt-[12.5px]">
            <h3 class="font-poppins text-base font-bold leading-[19.5px] tracking-[-0.24px] text-[#111210]">Copiloto estratégico</h3>
            <blockquote class="relative max-w-[510px] pl-[18px] text-xs leading-[15.4px] tracking-[-0.055px] text-[#999a95]">
                <span aria-hidden="true" class="absolute left-0 top-0 font-funnel text-2xl leading-none text-[#c9cac5]">“</span>
                <span aria-hidden="true" class="absolute bottom-0 left-[3px] top-5 w-px bg-[#d9dad5]"></span>
                Hermez evalúa constantemente el flujo de datos de tu empresa para ofrecerte sugerencias estratégicas, predecir tendencias de ventas y optimizar la toma de decisiones en cada punto de venta.
            </blockquote>
        </div>
    </div>
</section>

<script>
    // Safari (y todo navegador en iOS) no respeta la transparencia de VP9. Ahí se usa un MP4
    // con el color arriba y la transparencia abajo, que se compone en un canvas con WebGL.
    const ua = navigator.userAgent;
    const webkitOnly = /iP(hone|ad|od)/.test(ua) || (/Safari\//.test(ua) && !/Chrome|Chromium|Android|Edg\//.test(ua));
    const host = document.querySelector<HTMLElement>("[data-hermez]");
    const poster = host?.querySelector("video");

    if (host && poster && webkitOnly) {
        const canvas = document.createElement("canvas");
        canvas.width = 404;
        canvas.height = 564;
        canvas.className = "size-full";
        canvas.setAttribute("role", "img");
        canvas.setAttribute("aria-label", poster.getAttribute("aria-label") ?? "");
        const gl = canvas.getContext("webgl", { premultipliedAlpha: false, alpha: true });

        if (gl) {
            const src = document.createElement("video");
            Object.assign(src, { muted: true, loop: true, playsInline: true, autoplay: true, src: "/landing/hermez-safari.mp4" });
            src.setAttribute("playsinline", "");

            const shader = (type: number, code: string) => {
                const sh = gl.createShader(type)!;
                gl.shaderSource(sh, code);
                gl.compileShader(sh);
                return sh;
            };
            const prog = gl.createProgram()!;
            gl.attachShader(prog, shader(gl.VERTEX_SHADER, "attribute vec2 p;varying vec2 uv;void main(){uv=vec2((p.x+1.)/2.,(1.-p.y)/2.);gl_Position=vec4(p,0.,1.);}"));
            gl.attachShader(
                prog,
                shader(
                    gl.FRAGMENT_SHADER,
                    "precision mediump float;uniform sampler2D t;varying vec2 uv;void main(){vec3 c=texture2D(t,vec2(uv.x,uv.y*.5)).rgb;float a=texture2D(t,vec2(uv.x,.5+uv.y*.5)).r;gl_FragColor=vec4(c,a);}",
                ),
            );
            gl.linkProgram(prog);
            gl.useProgram(prog);
            gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
            const loc = gl.getAttribLocation(prog, "p");
            gl.enableVertexAttribArray(loc);
            gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
            gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);

            const draw = () => {
                if (src.readyState >= 2) {
                    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGB, gl.RGB, gl.UNSIGNED_BYTE, src);
                    gl.clear(gl.COLOR_BUFFER_BIT);
                    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
                }
                requestAnimationFrame(draw);
            };

            // El póster queda visible hasta que el primer cuadro esté listo.
            poster.removeAttribute("autoplay");
            poster.querySelector("source")?.remove();
            poster.load();
            src.addEventListener(
                "playing",
                () => {
                    poster.replaceWith(canvas);
                    draw();
                },
                { once: true },
            );
            src.play().catch(() => {});
        }
    }
</script>
