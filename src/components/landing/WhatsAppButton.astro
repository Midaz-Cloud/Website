---
// Botón flotante de WhatsApp: abre el chat con el número oficial de Midaz (src/data/contacto.mjs)
// y un mensaje inicial. Se oculta mientras corre la pantalla de carga del hero.
import { CONTACT } from "../../data/contacto.mjs";

// Mensaje que llega ya escrito en el chat de WhatsApp al tocar el botón.
const message = "Hola, quiero solicitar información sobre Midaz.";
const href = `${CONTACT.whatsappUrl}?text=${encodeURIComponent(message)}`;
---

<a
    href={href}
    target="_blank"
    rel="noopener"
    aria-label={`Escríbenos por WhatsApp al ${CONTACT.whatsappText}`}
    title={`WhatsApp ${CONTACT.whatsappText}`}
    data-wa-flotante
    class="group fixed z-40 flex items-center gap-3 rounded-full bg-[#25d366] p-3.5 text-white shadow-[0_10px_30px_-6px_rgba(7,20,58,0.45)] outline-none transition-[transform,box-shadow,background-color] duration-200 hover:bg-[#1ebe5b] hover:shadow-[0_14px_34px_-6px_rgba(7,20,58,0.55)] focus-visible:ring-4 focus-visible:ring-landing-blue/40 motion-safe:hover:-translate-y-0.5 sm:py-3 sm:pl-3.5 sm:pr-5"
>
    <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        ></path>
    </svg>
    <span class="hidden text-[15px] font-semibold leading-none sm:inline">Escríbenos</span>
</a>

<style>
    [data-wa-flotante] {
        /* Respeta la zona segura de los teléfonos con barra inferior (iPhone). */
        right: max(1rem, env(safe-area-inset-right));
        bottom: max(1rem, env(safe-area-inset-bottom));
    }
    @media (min-width: 640px) {
        [data-wa-flotante] {
            right: max(1.5rem, env(safe-area-inset-right));
            bottom: max(1.5rem, env(safe-area-inset-bottom));
        }
    }
    :global(html.carga) [data-wa-flotante] {
        display: none;
    }
    @media print {
        [data-wa-flotante] {
            display: none;
        }
    }
</style>
