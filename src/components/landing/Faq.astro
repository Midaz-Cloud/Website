---
// Tarjetas de preguntas frecuentes. La 02 aparece expandida como en el diseño.
const glass = "border border-white/80 bg-white/70 shadow-[0_4px_20px_-2px_rgba(0,0,0,0.02),0_0_0_1px_rgba(0,0,0,0.02)] backdrop-blur-[2px]";
const number = "text-[72px] font-normal leading-[72px] tracking-[-3.6px] text-[rgba(203,213,225,0.8)]";
const question = "font-poppins text-lg font-semibold leading-[24.75px] tracking-[-0.45px] text-[#0f172a]";
---

<section id="dudas" class="relative overflow-hidden py-16 xl:h-[776px] xl:py-0">
    <img
        src="/landing/icons/faq-vector.svg"
        alt=""
        aria-hidden="true"
        width="445"
        height="658"
        class="pointer-events-none absolute left-0 top-[59px] hidden md:block"
    />

    <div class="relative mx-auto flex max-w-[1280px] flex-col items-center gap-10 xl:h-full xl:justify-center">
        <h2 class="px-4 text-center font-funnel xl:translate-x-[36px] text-[clamp(2.5rem,6vw,3.5rem)] font-bold leading-none tracking-[-1.4px] text-[#14181f]">
            Preguntas <span class="text-landing-orange">frecuentes</span>
        </h2>

        <ul
            class="flex w-full snap-x snap-mandatory items-end gap-[15px] overflow-x-auto px-4 pb-6 [scrollbar-width:none] xl:w-[1329px] xl:max-w-none xl:translate-x-[11.5px] xl:justify-center xl:overflow-visible xl:px-0 xl:pb-0"
        >
            <li class:list={[glass, "flex h-[360px] w-[308.75px] shrink-0 snap-center flex-col justify-between rounded-3xl p-[29px]"]}>
                <span class={number} aria-hidden="true">01.</span>
                <h3 class:list={[question, "max-w-[169px]"]}>¿Qué pasa si se va el internet?</h3>
            </li>
            <li
                class="flex h-[500px] w-[min(394.66px,85vw)] shrink-0 snap-center flex-col justify-between rounded-3xl border border-[rgba(241,245,249,0.9)] bg-white/60 p-[25px] shadow-[0_25px_50px_-12px_rgba(0,0,0,0.07),0_0_0_1px_rgba(0,0,0,0.03)]"
            >
                <div class="flex flex-col gap-3">
                    <span class={number} aria-hidden="true">02.</span>
                    <img src="/landing/sucursales.webp" alt="" width="159" height="160" loading="lazy" />
                </div>
                <div class="flex flex-col gap-[25px]">
                    <h3 class="font-poppins text-2xl font-bold leading-[33px] tracking-[-0.6px] text-[#0f172a]">¿Puedo llevar varias sucursales?</h3>
                    <p class="text-xs leading-[21.13px] text-[rgba(7,20,58,0.6)]">
                        Sí. Cada sucursal maneja sus existencias y su correlativo, con precios centralizados y reportes consolidados.
                    </p>
                </div>
            </li>
            <li class:list={[glass, "flex h-[364px] w-[308.75px] shrink-0 snap-center flex-col justify-between rounded-3xl p-[29px]"]}>
                <span class={number} aria-hidden="true">03.</span>
                <h3 class={question}>¿Cuánto tarda en estar funcionando?</h3>
            </li>
            <li class:list={[glass, "flex h-[305px] w-[272px] shrink-0 snap-center flex-col justify-between rounded-3xl p-[29px]"]}>
                <span class={number} aria-hidden="true">04.</span>
                <h3 class:list={[question, "max-w-[149px]"]}>¿Dónde viven mis datos?</h3>
            </li>
        </ul>
    </div>
</section>
