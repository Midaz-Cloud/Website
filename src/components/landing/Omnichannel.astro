---
// "La misma operación, donde ocurra la venta" (Figma: Laptop / Carrusel de pantallas).
// Una laptop cuya pantalla pasa sola por los módulos de Midaz: cada vista se queda 3,5 s y la tira
// se desliza 0,8 s hacia la siguiente. Al final se desliza a una copia de la primera y vuelve al
// inicio sin que se note. También se puede arrastrar o deslizar con el dedo.
const screens = [
    { src: "/landing/pantallas/resumen.webp", alt: "Resumen de negocio de Midaz", caption: "Resumen de negocio te muestra cómo va cada sucursal hoy" },
    { src: "/landing/pantallas/agenda.webp", alt: "Agenda de citas de Midaz", caption: "Agenda organiza tus citas por sede y profesional" },
    { src: "/landing/pantallas/cocina.webp", alt: "Cocina KDS de Midaz", caption: "Cocina KDS lleva cada comanda del pedido al pase" },
    { src: "/landing/pantallas/tesoreria.webp", alt: "Tesorería de Midaz", caption: "Tesorería muestra cuánto hay en cada cuenta, en su moneda" },
    { src: "/landing/pantallas/flujo-caja.webp", alt: "Flujo de caja de Midaz", caption: "Flujo de caja proyecta tus cuentas a 8 semanas" },
];
// Medidas del Figma (laptop de 856×520): pantalla en (86.44, 22.96) de 683.43×434.91.
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---

<section id="soluciones" class="relative overflow-x-clip">
    <div class="flex flex-col items-center gap-[25px] pb-24 pt-12 xl:h-[985px] xl:pb-0">
        <img src="/landing/icons/badge.svg" alt="" aria-hidden="true" width="69" height="69" class="-mb-[10px] -mt-[1px] h-[69px] w-[69px]" />

        <h2 class="px-4 text-center font-funnel text-[clamp(2.25rem,6vw,3.375rem)] font-semibold leading-none tracking-[-0.03em] text-[#030712]">
            <span class="block">La misma operación,</span>
            <span class="block">donde ocurra la venta</span>
        </h2>

        <div class="w-full px-4" data-laptop>
            <div class="relative mx-auto aspect-[856/520] w-full max-w-[856px] select-none xl:left-px">
                <img src="/landing/macbook-carrusel.webp" alt="" aria-hidden="true" width="856" height="520" class="absolute inset-0 size-full" draggable="false" />
                <div
                    class="absolute touch-pan-y overflow-hidden bg-white"
                    style={`left:${pct(86.44, 856)};top:${pct(22.96, 520)};width:${pct(683.43, 856)};height:${pct(434.91, 520)}`}
                    role="region"
                    aria-roledescription="carrusel"
                    aria-label="Pantallas de Midaz"
                    data-laptop-screen
                >
                    <div class="flex h-full will-change-transform" data-laptop-strip>
                        {
                            [...screens, screens[0]].map((s, i) => (
                                <img
                                    src={s.src}
                                    alt={i < screens.length ? s.alt : ""}
                                    aria-hidden={i < screens.length ? undefined : "true"}
                                    width="684"
                                    height="435"
                                    class="h-full w-full shrink-0 object-cover"
                                    loading={i === 0 ? "eager" : "lazy"}
                                    draggable="false"
                                />
                            ))
                        }
                    </div>
                    <!-- Reflejo del vidrio -->
                    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[linear-gradient(135deg,rgba(255,255,255,0.1)_0%,rgba(255,255,255,0)_45%)]"></div>
                </div>
                <!-- Muesca de la cámara -->
                <div
                    aria-hidden="true"
                    class="absolute rounded-b-[8.1px] bg-[#0d0d0f]"
                    style={`left:${pct(386.29, 856)};top:${pct(22.96, 520)};width:${pct(83.74, 856)};height:${pct(16.21, 520)}`}
                ></div>
                <div
                    aria-hidden="true"
                    class="absolute aspect-square rounded-full bg-[#383d4d]"
                    style={`left:${pct(425.45, 856)};top:${pct(28.36, 520)};width:${pct(5.4, 856)}`}
                ></div>
            </div>
        </div>

        <div class="grid w-full max-w-[600px] px-4 sm:px-0" aria-live="polite">
            {
                screens.map((s, i) => (
                    <h3
                        class:list={[
                            "col-start-1 row-start-1 text-center font-poppins text-[clamp(1.5rem,4vw,2.125rem)] font-semibold leading-[1.18] tracking-[-0.85px] text-landing-blue transition-opacity duration-[800ms] ease-in-out motion-reduce:transition-none xl:leading-10",
                            i === 0 ? "opacity-100" : "opacity-0",
                        ]}
                        aria-hidden={i === 0 ? "false" : "true"}
                        data-laptop-caption
                    >
                        {s.caption}
                    </h3>
                ))
            }
        </div>
    </div>
</section>

<script>
    const root = document.querySelector<HTMLElement>("[data-laptop]");
    const strip = root?.querySelector<HTMLElement>("[data-laptop-strip]");
    const screen = root?.querySelector<HTMLElement>("[data-laptop-screen]");
    const captions = Array.from(document.querySelectorAll<HTMLElement>("[data-laptop-caption]"));
    if (root && strip && screen) {
        const count = captions.length;
        const HOLD = 3500;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
        let index = 0;
        let timer = 0;
        let visible = false;

        const caption = (i: number) => {
            captions.forEach((el, n) => {
                const on = n === i % count;
                el.classList.toggle("opacity-100", on);
                el.classList.toggle("opacity-0", !on);
                el.setAttribute("aria-hidden", String(!on));
            });
        };

        // Figma: cambio automático 0,8 s ease-in-out; al arrastrar, 0,6 s ease-out.
        const go = (next: number, drag = false) => {
            const animate = !reduce.matches;
            strip.style.transition = animate ? `transform ${drag ? "600ms cubic-bezier(0,0,0.58,1)" : "800ms cubic-bezier(0.42,0,0.58,1)"}` : "none";
            if (next < 0) {
                // Hacia atrás desde la primera: saltar a la copia del final y deslizar.
                strip.style.transition = "none";
                strip.style.transform = `translate3d(-${count * 100}%,0,0)`;
                strip.getBoundingClientRect();
                strip.style.transition = animate ? "transform 600ms cubic-bezier(0,0,0.58,1)" : "none";
                next = count - 1;
            }
            index = next;
            strip.style.transform = `translate3d(-${index * 100}%,0,0)`;
            caption(index);
            if (index === count && !animate) reset();
        };
        const reset = () => {
            strip.style.transition = "none";
            index = 0;
            strip.style.transform = "translate3d(0,0,0)";
        };
        strip.addEventListener("transitionend", () => {
            if (index === count) reset();
        });

        const schedule = () => {
            clearTimeout(timer);
            if (visible && !reduce.matches) timer = window.setTimeout(() => (go(index + 1), schedule()), HOLD);
        };

        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            schedule();
        }).observe(root);

        // Arrastre / deslizamiento
        let startX = 0;
        let dragging = false;
        screen.addEventListener("pointerdown", (e) => {
            dragging = true;
            startX = e.clientX;
        });
        window.addEventListener("pointerup", (e) => {
            if (!dragging) return;
            dragging = false;
            const dx = e.clientX - startX;
            if (Math.abs(dx) < 30) return;
            if (index === count) reset();
            go(dx < 0 ? index + 1 : index - 1, true);
            schedule();
        });
    }
</script>
