---
// "La misma operación, donde ocurra la venta" (Figma: Laptop / Carrusel de pantallas).
// Cinco fotos de la laptop, una por módulo de Midaz, apiladas: cada una se queda 3,5 s y se funde
// en 0,8 s (ease-in-out) con la siguiente; de la última vuelve a la primera. Arrastrar o deslizar
// cambia a la siguiente o la anterior en 0,6 s (ease-out).
const screens = [
    { src: "/landing/laptops/resumen.webp", alt: "Resumen de negocio de Midaz en una laptop", caption: "Resumen de negocio te muestra cómo va cada sucursal hoy" },
    { src: "/landing/laptops/agenda.webp", alt: "Agenda de citas de Midaz en una laptop", caption: "Agenda organiza tus citas por sede y profesional" },
    { src: "/landing/laptops/cocina.webp", alt: "Cocina KDS de Midaz en una laptop", caption: "Cocina KDS lleva cada comanda del pedido al pase" },
    { src: "/landing/laptops/tesoreria.webp", alt: "Tesorería de Midaz en una laptop", caption: "Tesorería muestra cuánto hay en cada cuenta, en su moneda" },
    { src: "/landing/laptops/flujo-caja.webp", alt: "Flujo de caja de Midaz en una laptop", caption: "Flujo de caja proyecta tus cuentas a 8 semanas" },
];
---


<section id="soluciones" class="relative overflow-x-clip">
    <div class="flex flex-col items-center gap-[25px] pb-24 pt-12 xl:h-[985px] xl:pb-0">
        <img src="/landing/icons/badge.svg" alt="" aria-hidden="true" width="69" height="69" class="-mb-[10px] -mt-[1px] h-[69px] w-[69px]" />

        <h2 class="px-4 text-center font-funnel text-[clamp(2.25rem,6vw,3.375rem)] font-semibold leading-none tracking-[-0.03em] text-[#030712]">
            <span class="block">La misma operación,</span>
            <span class="block">donde ocurra la venta</span>
        </h2>

        <div class="w-full px-4" data-laptop>
            <!-- Figma: marco de 855,5×520; las fotos (767×520) empiezan 43,76 px a la derecha -->
            <div class="relative mx-auto aspect-[855.5/520] w-full max-w-[855.5px] select-none xl:left-px">
                <div class="absolute inset-y-0 left-[5.115%] w-[89.655%] touch-pan-y" role="region" aria-roledescription="carrusel" aria-label="Pantallas de Midaz" data-laptop-screen>
                    {
                        screens.map((s, i) => (
                            <img
                                src={s.src}
                                alt={s.alt}
                                width="1534"
                                height="1040"
                                class:list={["absolute inset-0 size-full", i === 0 ? "opacity-100" : "opacity-0"]}
                                aria-hidden={i === 0 ? undefined : "true"}
                                loading={i === 0 ? "eager" : "lazy"}
                                draggable="false"
                                data-laptop-shot
                            />
                        ))
                    }
                </div>
            </div>
        </div>

        <div class="grid w-full max-w-[600px] px-4 sm:px-0" aria-live="polite">
            {
                screens.map((s, i) => (
                    <h3
                        class:list={[
                            "col-start-1 row-start-1 text-center font-poppins text-[clamp(1.5rem,4vw,2.125rem)] font-semibold leading-[1.18] tracking-[-0.85px] text-landing-blue transition-opacity duration-[800ms] ease-in-out motion-reduce:transition-none xl:leading-10",
                            i === 0 ? "opacity-100" : "opacity-0",
                        ]}
                        aria-hidden={i === 0 ? "false" : "true"}
                        data-laptop-caption
                    >
                        {s.caption}
                    </h3>
                ))
            }
        </div>
    </div>
</section>

<script>
    const root = document.querySelector<HTMLElement>("[data-laptop]");
    const screen = root?.querySelector<HTMLElement>("[data-laptop-screen]");
    const shots = Array.from(root?.querySelectorAll<HTMLElement>("[data-laptop-shot]") ?? []);
    const captions = Array.from(document.querySelectorAll<HTMLElement>("[data-laptop-caption]"));
    if (root && screen && shots.length) {
        const count = shots.length;
        const HOLD = 3500;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
        let index = 0;
        let timer = 0;
        let visible = false;

        // Figma: cambio automático 0,8 s ease-in-out; al arrastrar, 0,6 s ease-out.
        const go = (next: number, drag = false) => {
            index = (next + count) % count;
            const t = reduce.matches ? "none" : `opacity ${drag ? "600ms cubic-bezier(0,0,0.58,1)" : "800ms cubic-bezier(0.42,0,0.58,1)"}`;
            shots.forEach((el, n) => {
                el.style.transition = t;
                el.style.opacity = n === index ? "1" : "0";
                if (n === index) el.removeAttribute("aria-hidden");
                else el.setAttribute("aria-hidden", "true");
            });
            captions.forEach((el, n) => {
                const on = n === index;
                el.classList.toggle("opacity-100", on);
                el.classList.toggle("opacity-0", !on);
                el.setAttribute("aria-hidden", String(!on));
            });
        };

        const schedule = () => {
            clearTimeout(timer);
            if (visible && !reduce.matches) timer = window.setTimeout(() => (go(index + 1), schedule()), HOLD);
        };

        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            schedule();
        }).observe(root);

        // Arrastre / deslizamiento
        let startX = 0;
        let dragging = false;
        screen.addEventListener("pointerdown", (e) => {
            dragging = true;
            startX = e.clientX;
        });
        window.addEventListener("pointerup", (e) => {
            if (!dragging) return;
            dragging = false;
            const dx = e.clientX - startX;
            if (Math.abs(dx) < 30) return;
            go(dx < 0 ? index + 1 : index - 1, true);
            schedule();
        });
    }
</script>
