---
// "La misma operación, donde ocurra la venta".
// En ≥1024px la sección queda fija mientras se hace scroll y el dispositivo central
// cambia de pantalla en cada paso; en móvil los pasos se muestran uno debajo del otro.
const card = "rounded-2xl shadow-[0_12px_30px_-8px_rgba(0,0,0,0.18)] shrink-0";

const steps = [
    {
        product: "Midaz Web",
        title: "Factura y cobra en el mostrador, con la cuenta hecha",
        src: "/landing/macbook-full.webp",
        alt: "Midaz Web en una laptop: listado de facturas emitidas",
        width: 633,
        height: 385,
        displayHeight: 385,
    },
    {
        product: "Punto de venta",
        title: "Cobra en caja con el total en bolívares y la tasa BCV al día",
        src: "/landing/pos.webp",
        alt: "Punto de venta Disglobal con el carrito de Midaz y el total a cobrar",
        width: 314,
        height: 411,
        displayHeight: 440,
    },
    {
        product: "Midaz App",
        title: "Tus clientes piden directo desde la mesa, sin descargar apps",
        src: "/landing/phone.webp",
        alt: "App de pedidos de Midaz en un iPhone, pedido desde la mesa",
        width: 361,
        height: 594,
        displayHeight: 470,
    },
    {
        product: "Midaz Marketplace",
        title: "Cada producto con su precio, sus extras y sus alérgenos",
        src: "/landing/iphone15.webp",
        alt: "Ficha de producto en Midaz con precio, extras y alérgenos",
        width: 196,
        height: 391,
        displayHeight: 430,
    },
];
---

<section id="soluciones" class="relative overflow-x-clip lg:h-[calc(100vh+var(--steps)*70vh)]" style={`--steps:${steps.length - 1}`} data-scroll-story>
    <div class="flex flex-col items-center gap-[25px] pb-24 pt-12 lg:sticky lg:top-0 lg:h-screen lg:justify-center lg:gap-5 lg:pb-6 lg:pt-[104px]">
        <img src="/landing/icons/badge.svg" alt="" aria-hidden="true" width="69" height="69" class="-mb-[10px] -mt-[1px] h-[69px] w-[69px] lg:[@media(max-height:960px)]:hidden" />

        <h2 class="px-4 text-center font-funnel text-[clamp(2.25rem,6vw,3.375rem)] font-semibold leading-none tracking-[-0.03em] text-[#030712]">
            <span class="block">La misma operación,</span>
            <span class="block">donde ocurra la venta</span>
        </h2>

        <div class="relative flex w-full max-w-[1280px] items-center justify-center px-4">
            <!-- Tarjetas flotantes izquierda -->
            <div aria-hidden="true" class="absolute left-[-24px] top-1/2 hidden -translate-y-[38%] items-center xl:flex">
                <div class:list={[card, "h-[192px] w-[112px] bg-gradient-to-b from-[#872054] to-[#f43f8e] opacity-[0.85]"]}></div>
                <div class:list={[card, "h-[240px] w-[144px] bg-landing-blue"]}></div>
                <div class:list={[card, "h-[256px] w-[160px] bg-[#262626]"]}></div>
            </div>
            <!-- Tarjetas flotantes derecha -->
            <div aria-hidden="true" class="absolute left-[68.83%] top-1/2 hidden -translate-y-[38%] items-center xl:flex">
                <div class:list={[card, "h-[256px] w-[160px] bg-[#451a03]"]}></div>
                <div class:list={[card, "h-[240px] w-[144px] bg-landing-blue"]}></div>
                <div class:list={[card, "h-[192px] w-[112px] bg-[linear-gradient(120deg,#022c22_0%,#14532d_100%)] opacity-[0.85]"]}></div>
            </div>

            <!-- Escritorio: un escenario, una pantalla por paso -->
            <div class="relative hidden h-[clamp(280px,calc(100vh-400px),520px)] w-full max-w-[633px] lg:block">
                {
                    steps.map((step, i) => (
                        <div
                            class:list={[
                                "absolute inset-0 flex items-center justify-center transition-[opacity,transform] duration-700 ease-out motion-reduce:transition-none",
                                i === 0 ? "opacity-100" : "scale-95 opacity-0",
                            ]}
                            data-story-item={i}
                            aria-hidden={i === 0 ? "false" : "true"}
                        >
                            <img
                                src={step.src}
                                alt={step.alt}
                                width={step.width}
                                height={step.height}
                                style={`height:${step.displayHeight}px`}
                                class="max-h-full w-auto max-w-full object-contain"
                                loading={i === 0 ? "eager" : "lazy"}
                            />
                        </div>
                    ))
                }
            </div>
        </div>

        <!-- Escritorio: texto del paso activo + indicador -->
        <div class="hidden flex-col items-center gap-4 px-4 lg:flex">
            <div class="grid w-[min(640px,90vw)] place-items-center">
                {
                    steps.map((step, i) => (
                        <div
                            class:list={[
                                "col-start-1 row-start-1 flex flex-col items-center gap-2 text-center transition-opacity duration-500 motion-reduce:transition-none",
                                i === 0 ? "opacity-100" : "opacity-0",
                            ]}
                            data-story-caption={i}
                            aria-hidden={i === 0 ? "false" : "true"}
                        >
                            <p class="text-xs font-semibold uppercase tracking-[1.2px] text-landing-orange">{step.product}</p>
                            <h3 class="max-w-[599px] font-poppins text-[34px] font-bold leading-10 tracking-[-0.85px] text-landing-blue">{step.title}</h3>
                        </div>
                    ))
                }
            </div>
            <ol class="flex gap-2" aria-label="Pasos">
                {
                    steps.map((step, i) => (
                        <li>
                            <button
                                type="button"
                                class:list={["h-2 rounded-full transition-all duration-300", i === 0 ? "w-6 bg-landing-blue" : "w-2 bg-landing-slate/50"]}
                                aria-label={`Ver ${step.product}`}
                                data-story-dot={i}
                            ></button>
                        </li>
                    ))
                }
            </ol>
        </div>

        <!-- Móvil y tablet: pasos apilados -->
        <ul class="flex w-full flex-col items-center gap-14 px-4 lg:hidden">
            {
                steps.map((step) => (
                    <li class="flex w-full max-w-[633px] flex-col items-center gap-4 text-center">
                        <img src={step.src} alt={step.alt} width={step.width} height={step.height} class="h-auto max-h-[420px] w-auto max-w-full" loading="lazy" />
                        <p class="text-xs font-semibold uppercase tracking-[1.2px] text-landing-orange">{step.product}</p>
                        <h3 class="max-w-[599px] font-poppins text-[clamp(1.5rem,4vw,2.125rem)] font-bold leading-[1.18] tracking-[-0.85px] text-landing-blue">{step.title}</h3>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<script>
    const story = document.querySelector<HTMLElement>("[data-scroll-story]");
    if (story) {
        const items = Array.from(story.querySelectorAll<HTMLElement>("[data-story-item]"));
        const captions = Array.from(story.querySelectorAll<HTMLElement>("[data-story-caption]"));
        const dots = Array.from(story.querySelectorAll<HTMLButtonElement>("[data-story-dot]"));
        const count = items.length;
        const desktop = window.matchMedia("(min-width: 1024px)");
        let active = 0;

        const setActive = (index: number) => {
            if (index === active) return;
            active = index;
            [...items, ...captions].forEach((el) => {
                const on = Number(el.dataset.storyItem ?? el.dataset.storyCaption) === index;
                el.classList.toggle("opacity-0", !on);
                el.classList.toggle("opacity-100", on);
                if (el.dataset.storyItem !== undefined) el.classList.toggle("scale-95", !on);
                el.setAttribute("aria-hidden", String(!on));
            });
            dots.forEach((el, i) => {
                el.classList.toggle("w-6", i === index);
                el.classList.toggle("bg-landing-blue", i === index);
                el.classList.toggle("w-2", i !== index);
                el.classList.toggle("bg-landing-slate/50", i !== index);
            });
        };

        // Recorrido del scroll mientras el escenario está fijo (alto de la sección menos una pantalla).
        const travel = () => story.offsetHeight - window.innerHeight;

        const update = () => {
            if (!desktop.matches) return;
            const t = travel();
            const progress = t > 0 ? Math.min(1, Math.max(0, -story.getBoundingClientRect().top / t)) : 0;
            setActive(Math.min(count - 1, Math.floor(progress * count)));
        };

        dots.forEach((dot, i) =>
            dot.addEventListener("click", () => {
                const top = story.getBoundingClientRect().top + window.scrollY + ((i + 0.5) / count) * travel();
                window.scrollTo({ top, behavior: "smooth" });
            }),
        );

        let ticking = false;
        window.addEventListener(
            "scroll",
            () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(() => {
                    update();
                    ticking = false;
                });
            },
            { passive: true },
        );
        desktop.addEventListener("change", update);
        update();
    }
</script>
