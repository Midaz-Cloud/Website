---
// En la portada los enlaces son anclas de la misma página; en las demás páginas (p. ej. /legal) llevan a la portada.
const { home = true } = Astro.props;
const base = home ? "" : "/";
const links = [
    { label: "Home", href: "#inicio", active: home },
    { label: "Soluciones", href: "#soluciones" },
    { label: "Nuestros productos", href: "#productos" },
    { label: "Control fiscal", href: "#plataforma" },
    { label: "Dudas", href: "#dudas" },
    { label: "Hermez", href: "#hermez" },
].map((l) => ({ ...l, href: base + l.href }));
---

<header class="sticky top-0 z-50 px-4 pt-4 sm:px-6 lg:px-10 lg:pt-[32px]">
    <nav
        class="relative mx-auto flex max-w-[1200px] items-center justify-between rounded-full border border-[rgba(0,75,224,0.35)] bg-[rgba(0,75,224,0.12)] max-lg:bg-[rgba(238,243,253,0.88)] px-5 transition-colors duration-300 data-[on-blue]:border-white/60 data-[on-blue]:bg-[rgba(238,243,253,0.92)] py-[11px] shadow-[8px_20px_18px_-18px_rgba(0,0,0,0.35),0_0_15px_0_rgba(255,255,255,0.05)] backdrop-blur-[25px] lg:px-[25px]"
        aria-label="Principal"
        data-nav
    >
        <!-- Línea de brillo superior -->
        <span
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-[10%] top-0 h-px rounded-full bg-gradient-to-r from-[rgba(0,75,224,0)] via-[rgba(0,75,224,0.7)] to-[rgba(0,75,224,0)]"
        ></span>

        <a href={home ? "#inicio" : "/"} class="relative flex shrink-0 items-center pt-[2px]" aria-label="Midaz, inicio">
            <img src="/landing/icons/logo.svg" alt="Midaz" width="128" height="30" class="h-[29.5px] w-32 max-[374px]:h-auto max-[374px]:w-[108px]" />
        </a>

        <ul class="hidden items-center gap-6 lg:flex">
            {
                links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class:list={[
                                "font-[Inter] text-sm leading-5 transition-colors",
                                link.active
                                    ? "font-bold text-landing-blue underline underline-offset-2"
                                    : "font-medium text-landing-navy hover:text-landing-blue",
                            ]}
                            aria-current={link.active ? "page" : undefined}
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <div class="flex items-center gap-3 lg:gap-4">
            <a
                href="/comenzar"
                class="hidden items-center justify-center gap-2 whitespace-nowrap rounded-full border border-landing-navy py-2 pl-[19px] pr-[15px] text-center font-[Inter] text-sm font-semibold leading-5 text-landing-navy shadow-[0_1px_2px_0_rgba(0,0,0,0.05)] transition-colors hover:bg-landing-navy hover:text-white sm:inline-flex"
            >
                Prueba gratis
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="shrink-0">
                    <path d="M3.33337 8H12.6667M8.66671 12L12.6667 8L8.66671 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
            <a
                href="https://web.midazlatam.com"
                class="inline-flex whitespace-nowrap rounded-full bg-landing-blue px-4 py-2 text-center max-[374px]:px-3 font-[Inter] text-sm font-semibold leading-5 text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.05)] transition-colors hover:bg-[#003bb3] sm:px-5"
            >
                Iniciar sesión
            </a>

            <!-- Menú móvil -->
            <details class="group relative lg:hidden">
                <summary
                    class="flex size-9 cursor-pointer list-none items-center justify-center rounded-full text-landing-navy [&::-webkit-details-marker]:hidden"
                    aria-label="Abrir menú"
                >
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" />
                        <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </summary>
                <ul
                    class="absolute right-0 top-12 flex w-60 flex-col gap-1 rounded-2xl border border-[rgba(0,75,224,0.2)] bg-white/95 p-3 shadow-xl backdrop-blur"
                >
                    {
                        links.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    class:list={[
                                        "block rounded-xl px-3 py-2 font-[Inter] text-sm",
                                        link.active ? "font-bold text-landing-blue" : "font-medium text-landing-navy hover:bg-landing-bg",
                                    ]}
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                    <li class="sm:hidden">
                        <a href="/comenzar" class="mt-1 block rounded-xl border border-landing-navy px-3 py-2 text-center font-[Inter] text-sm font-semibold">
                            Prueba gratis
                        </a>
                    </li>
                </ul>
            </details>
        </div>
    </nav>
    <script>
        // Sobre secciones azules (data-nav-azul) el vidrio azul se pierde: el menú pasa a blanco para que se lea el logo.
        const nav = document.querySelector<HTMLElement>("[data-nav]");
        const blues = document.querySelectorAll("[data-nav-azul]");
        if (nav && blues.length) {
            const update = () => {
                const r = nav.getBoundingClientRect();
                const over = Array.from(blues).some((el) => {
                    const b = el.getBoundingClientRect();
                    return b.top < r.bottom && b.bottom > r.top;
                });
                nav.toggleAttribute("data-on-blue", over);
            };
            addEventListener("scroll", update, { passive: true });
            addEventListener("resize", update);
            update();
        }
    </script>
</header>
