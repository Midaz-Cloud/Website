---
import { LEGAL_DOCS, LEGAL_ORDER } from "../../data/legal.mjs";
import { CONTACT, SOCIAL } from "../../data/contacto.mjs";

// En la portada los enlaces son anclas de la misma página; en las demás páginas llevan a la portada.
const { home = true } = Astro.props;
const base = home ? "" : "/";
// Figma "Nav - Social links": círculos de 48 px con borde blanco de 1,5 px, ícono de 22 px y 16 px entre ellos.
const socials = [
    { name: "Instagram", label: "Midaz en Instagram", href: SOCIAL.instagram, icon: "instagram" },
    { name: "Correo", label: `Escríbenos a ${CONTACT.email}`, href: `mailto:${CONTACT.email}`, icon: "gmail" },
    { name: "TikTok", label: "Midaz en TikTok", href: SOCIAL.tiktok, icon: "tiktok" },
    { name: "X", label: "Midaz en X", href: SOCIAL.x, icon: "x" },
    { name: "LinkedIn", label: "Midaz en LinkedIn", href: SOCIAL.linkedin, icon: "linkedin" },
    { name: "Facebook", label: "Midaz en Facebook", href: SOCIAL.facebook, icon: "facebook" },
];
const ecosystem = [
    ["Midaz Web", "Fila Cero", "Atlas", "Ágora"],
    ["MidazPay", "Midaz App", "Midaz Marketplace", "Hermez - Asistente IA"],
];
const support = [
    { label: "Dudas frecuentes", href: base + "#dudas" },
    { label: "Centro de ayuda", href: "#" },
    { label: "Contacto y soporte", href: base + "#contacto" },
    { label: "Solicitud de Demo", href: "/comenzar" },
];
const legal = LEGAL_ORDER.map((doc) => ({ label: LEGAL_DOCS[doc].title, href: `/legal/${doc}` }));
const heading = "font-poppins text-[11px] font-bold uppercase leading-[16.5px] tracking-[0.55px] text-white/70";
const link = "text-sm font-semibold leading-5 text-white hover:underline";
---

<footer id="contacto" data-nav-azul class="overflow-hidden bg-landing-blue pb-12 text-white">
    <div class="mx-auto flex max-w-[896px] flex-col items-center px-4 pt-8 sm:px-8">
        <form
            action="/comenzar"
            method="get"
            class="relative flex w-full max-w-[672px] items-center rounded-full border border-white/20 bg-white/[0.18] py-[9px] pl-6 pr-[9px] shadow-[inset_0_2px_4px_0_rgba(0,0,0,0.05)] backdrop-blur-[2px] sm:h-[58px] sm:pl-[29px]"
        >
            <label for="footer-email" class="sr-only">Correo electrónico</label>
            <input
                id="footer-email"
                name="email"
                type="email"
                required
                placeholder="Escribe tu correo electrónico"
                class="min-w-0 flex-1 bg-transparent py-[10px] text-base tracking-[0.45px] text-white placeholder:text-white/70 focus:outline-none"
            />
            <button
                type="submit"
                class="shrink-0 rounded-full bg-white px-5 py-3 text-base font-semibold leading-7 text-landing-blue drop-shadow-[0_1px_1px_rgba(0,0,0,0.05)] transition-colors hover:bg-white/90 sm:px-8"
            >
                Contactar ahora
            </button>
        </form>
        <p class="pt-[14px] text-center text-sm font-medium leading-5 tracking-[-0.35px] text-white/90">
            Tu cerebro operativo y fiscal. Factura, cobra y prepara tu información fiscal desde un solo sistema.
        </p>
        <nav aria-label="Redes sociales" class="flex flex-wrap items-start justify-center gap-4 pb-12 pt-10">
            {
                socials.map((s) => (
                    <a
                        href={s.href}
                        {...(s.href.startsWith("mailto:") ? {} : { target: "_blank", rel: "noopener" })}
                        aria-label={s.label}
                        class="flex size-12 shrink-0 items-center justify-center rounded-full border-[1.5px] border-white transition-colors hover:bg-white/15"
                    >
                        <img src={`/landing/icons/redes/${s.icon}.svg`} alt="" width="22" height="22" class="size-[22px]" />
                    </a>
                ))
            }
        </nav>
    </div>

    <div class="-mb-4 flex h-[19vw] max-h-[242px] items-start justify-center overflow-hidden" aria-hidden="true">
        <p class="-translate-x-[0.0225em] whitespace-nowrap font-funnel text-[26vw] font-semibold uppercase leading-[0.78] tracking-[-0.05em] xl:text-[332.8px] xl:leading-[259.58px]">MIDAZ</p>
    </div>

    <div class="relative mx-auto max-w-[1152px] bg-landing-blue px-4 sm:px-8 lg:px-12 xl:px-[48px]">
        <div class="flex flex-col gap-8 pt-4 md:flex-row md:items-start md:justify-between">
            <div class="flex flex-col gap-3 border-t border-white/30 pt-3 md:w-[286px]">
                <h2 class={heading}>Ecosistema</h2>
                <div class="flex gap-3">
                    {
                        ecosystem.map((col, i) => (
                            <ul class:list={["flex flex-col gap-2 leading-5", i === 0 ? "w-[120px]" : "flex-1"]}>
                                {col.map((item) => (
                                    <li class="whitespace-nowrap">
                                        <a href={base + "#productos"} class={link}>{item}</a>
                                    </li>
                                ))}
                            </ul>
                        ))
                    }
                </div>
            </div>
            <div class="flex flex-col gap-3 border-t border-white/30 pt-3 md:w-[226px]">
                <h2 class={heading}>Soporte</h2>
                <ul class="flex flex-col gap-3 leading-5">
                    {support.map((s) => <li><a href={s.href} class={link}>{s.label}</a></li>)}
                </ul>
            </div>
            <div class="flex flex-col gap-3 border-t border-white/30 pt-3 md:w-[172px]">
                <h2 class={heading}>Legal</h2>
                <ul class="flex flex-col gap-2 leading-5">
                    {legal.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
                </ul>
            </div>
            <div class="flex flex-col gap-3 border-t border-white/30 pt-3 md:w-[220px]">
                <h2 class={heading}>Contacto</h2>
                <ul class="flex flex-col gap-2 leading-5">
                    <li><a href={CONTACT.whatsappUrl} target="_blank" rel="noopener" class={link}>WhatsApp <span class="whitespace-nowrap">{CONTACT.whatsappText}</span></a></li>
                    <li><a href={`mailto:${CONTACT.email}`} class={link}>{CONTACT.email}</a></li>
                    <li class="text-sm leading-5 text-white/80">{CONTACT.hours}</li>
                </ul>
            </div>
        </div>
        <p class="mt-10 border-t border-white/30 pt-4 text-xs font-medium leading-5 tracking-[0.2px] text-white/70">{CONTACT.legalLine}</p>
    </div>
</footer>
