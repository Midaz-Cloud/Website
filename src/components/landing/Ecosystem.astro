---
// "Un ecosistema completo" (Figma: instancia 111:363 del componente "Ecosistema / Carrusel", 87:533).
// El producto activo va grande a la izquierda y los siguientes, en orden, en tarjetas pequeñas a su
// derecha. En ≥1280px la sección se queda fija y la rueda del mouse (scroll vertical) la recorre en
// horizontal producto por producto; al llegar al último la página sigue bajando. Cada cambio usa la
// transición del Figma: 800 ms ease-in-out (rueda, pestañas, avance automático) y 600 ms ease-out al arrastrar.

// Posición de una imagen dentro de su tarjeta: [x, y, ancho] en grande y en pequeño (medidas del Figma).
type Box = [number, number, number];
type Product = {
    name: string;
    short: string;
    title: string;
    text: string;
    image: { src: string; width: number; height: number; alt: string };
    big: Box;
    small: Box;
    soon?: boolean;
    // Titular (x, ancho) y párrafo (x, ancho) en el lienzo de 1280px.
    copy: { tx: number; tw: number; px: number; pw: number };
};
const products: Product[] = [
    {
        name: "Midaz Web (Core)",
        short: "Midaz Web",
        title: "es el centro operativo de tu negocio",
        text: "Sincroniza todas tus sedes y canales de venta en tiempo real. Controla tus libros de ventas, la tasa BCV y tu inventario con menos errores operativos y mayor control fiscal.",
        image: { src: "/landing/macbook-full.webp", width: 1267, height: 770, alt: "Midaz Web en una laptop mostrando el módulo de facturas" },
        big: [-14.2, 42, 633.4],
        small: [27.7, 94, 258],
        copy: { tx: 169, tw: 392, px: 611, pw: 500 },
    },
    {
        name: "Fila Cero",
        short: "Fila Cero",
        title: "es el punto de venta ágil para cobros en caja y comanderas",
        text: "Agiliza las colas y procesa pedidos en segundos. Sincroniza las ventas de tus cajas físicas directamente con el inventario central y la facturación fiscal de tu negocio.",
        image: { src: "/landing/iphone15.webp", width: 392, height: 782, alt: "Fila Cero en un iPhone: ficha de producto con precio y extras" },
        big: [50.7, 20, 213],
        small: [78.7, 21, 156],
        copy: { tx: 69, tw: 592, px: 711, pw: 500 },
    },
    {
        name: "Atlas",
        short: "Atlas",
        title: "es la solución de autogestión y pedidos independientes.",
        text: "Transforma la experiencia de compra en el establecimiento con atención rápida y sin colas. Procesa pagos con tarjetas o métodos digitales y envía las comandes directamente a cocina o despacho.",
        image: { src: "/landing/kiosko.webp", width: 408, height: 930, alt: "Atlas en un kiosco de autoservicio" },
        big: [55.7, 0, 204],
        small: [82.8, 4, 148],
        copy: { tx: 47, tw: 592, px: 689, pw: 544 },
    },
    {
        name: "Ágora",
        short: "Ágora",
        title: "es tu canal de ventas e-commerce integrado.",
        text: "Vende por internet con catálogo dinámico y cobros en línea. Sincroniza precios, promociones e inventario al instante con el resto de tus sedes.",
        image: { src: "/landing/agora.webp", width: 338, height: 870, alt: "Ágora en un punto de venta Disglobal" },
        big: [72.7, 21, 169],
        small: [100.8, 29.5, 112],
        copy: { tx: 47, tw: 592, px: 689, pw: 544 },
    },
    {
        name: "MidazPay",
        short: "MidazPay",
        title: "es el sistema de cobros inteligentes en tiempo real.",
        text: "Unifica todos tus métodos de pago físicos y digitales en una sola plataforma. Sincroniza las comisiones bancarias y la facturación fiscal sin intervención manual.",
        // El POS va girado 1° en el Figma; la imagen ya trae el giro (caja exterior del rectángulo girado).
        image: { src: "/landing/pos-n82.webp", width: 387, height: 889, alt: "MidazPay en un punto de venta Disglobal con el carrito a cobrar" },
        big: [59.1, 10.6, 193.4],
        small: [88.1, 20.1, 136],
        copy: { tx: 47, tw: 592, px: 689, pw: 544 },
    },
    {
        name: "Midaz App",
        short: "Midaz App",
        title: "es el centro de control gerencial en tu bolsillo.",
        text: "Monitorea las ventas en vivo, el flujo de caja y las métricas clave de tus sedes desde cualquier lugar. Recibe alertas en tiempo real y toma decisiones informadas al instante.",
        image: { src: "/landing/iphone15.webp", width: 392, height: 782, alt: "" },
        big: [57.7, 31, 202],
        small: [86.4, 30.5, 142.9],
        soon: true,
        copy: { tx: 47, tw: 592, px: 689, pw: 544 },
    },
];
const panelBg = "linear-gradient(155deg, #07143a 1.5%, #1337a0 97.6%)";
// Geometría de las tarjetas (lienzo de 1280px, y desde el borde superior del carrusel, que empieza en y=377.5).
const geo = { x0: 64, bigTop: 20, bigH: 465, smallW: 314, gap: 16, step: 330, webW: 603.5 };
const smallBox = (i: number) => (i <= 1 ? { top: 140, h: 345 } : { top: 139, h: 346 });
const px = (v: number) => `${v}px`;
---

<section id="productos" class="pt-6 xl:pt-0" data-eco>
    <div data-eco-track>
        <div class="xl:sticky xl:top-[min(0px,calc(100vh-1083px))] xl:h-[1083px]" data-eco-sticky>
            <header class="mx-auto flex max-w-[685px] flex-col items-center gap-4 px-4 pb-[30px] text-center xl:pt-[59.5px]">
                <h2 class="font-poppins text-[clamp(2.25rem,6vw,3.375rem)] font-semibold leading-[1.02] tracking-[-0.041em] text-landing-navy xl:leading-[55px] xl:tracking-[-2.24px]">
                    <span class="block text-landing-orange">Un ecosistema completo,</span>
                    <span class="block">no una app suelta</span>
                </h2>
                <p class="max-w-[641px] text-base leading-[25px] text-[rgba(7,20,58,0.6)] xl:self-start">
                    Empiezas por donde te haga falta y creces sin cambiar de sistema. El inventario, los precios y la contabilidad son los mismos en todos los canales.
                </p>
            </header>

            <div class="pb-5">
                <div role="tablist" aria-label="Productos Midaz" class="flex gap-[10px] overflow-x-auto px-4 py-2 [scrollbar-width:none] md:flex-wrap md:justify-center" data-product-tabs>
                    {
                        products.map((product, i) => (
                            <button
                                type="button"
                                role="tab"
                                id={`producto-tab-${i}`}
                                aria-controls="producto-panel"
                                aria-selected={i === 0 ? "true" : "false"}
                                tabindex={i === 0 ? 0 : -1}
                                class="group flex h-[42px] shrink-0 items-center justify-center gap-[10px] rounded-[10px] border border-[#d1d5db] bg-white px-5 text-base font-medium leading-4 text-landing-navy transition-colors hover:border-landing-navy aria-selected:border-landing-navy aria-selected:bg-landing-navy aria-selected:h-10 aria-selected:border-0 aria-selected:px-[21.5px] aria-selected:text-white aria-selected:drop-shadow-[0_1px_1px_rgba(0,0,0,0.05)]"
                            >
                                {product.name}
                                <img src="/landing/icons/arrow-circle-right.svg" alt="" width="28" height="28" class="hidden size-7 group-aria-selected:block" />
                            </button>
                        ))
                    }
                </div>
            </div>

            <!-- Carrusel (Figma "Container": 523px de alto, recorta lo que sale). --k escala el lienzo de 1280px. -->
            <div class="relative overflow-hidden xl:absolute xl:left-1/2 xl:top-[377.5px] xl:w-[1280px] xl:-translate-x-1/2" data-eco-viewport>
                <div
                    id="producto-panel"
                    role="tabpanel"
                    aria-labelledby="producto-tab-0"
                    aria-roledescription="carrusel"
                    class="relative h-[calc(var(--k)*523px)] w-full touch-pan-y select-none [--k:0.55] [--d:800ms] [--e:cubic-bezier(0.42,0,0.58,1)] sm:[--k:0.8] lg:[--k:1]"
                    data-product-panel
                >
                    {
                        products.map((product, i) => {
                            const web = i === 0;
                            const s = smallBox(i);
                            const big = i === 0;
                            const left = big ? geo.x0 : geo.x0 + geo.webW + geo.gap + (i - 1) * geo.step;
                            const imgVars = `--bx:${product.big[0]};--by:${product.big[1]};--bw:${product.big[2]};--sx:${product.small[0]};--sy:${product.small[1]};--sw:${product.small[2]}`;
                            const img = "absolute left-[calc(var(--k)*var(--sx)*1px)] top-[calc(var(--k)*var(--sy)*1px)] h-auto w-[calc(var(--k)*var(--sw)*1px)] max-w-none transition-[left,top,width] duration-[var(--d)] ease-[var(--e)] group-data-[size=big]:left-[calc(var(--k)*var(--bx)*1px)] group-data-[size=big]:top-[calc(var(--k)*var(--by)*1px)] group-data-[size=big]:w-[calc(var(--k)*var(--bw)*1px)] motion-reduce:transition-none";
                            return (
                                <div
                                    class="group absolute transition-[left,top,width,height] duration-[var(--d)] ease-[var(--e)] motion-reduce:transition-none data-[snap]:!transition-none [&[data-snap]_*]:!transition-none"
                                    style={`--x:${left};--y:${big ? geo.bigTop : s.top};--w:${big ? geo.webW : geo.smallW};--h:${big ? geo.bigH : s.h};--st:${s.top};--sh:${s.h};left:calc(var(--k)*var(--x)*1px);top:calc(var(--k)*var(--y)*1px);width:calc(var(--k)*var(--w)*1px);height:calc(var(--k)*var(--h)*1px);${imgVars}`}
                                    data-product-slide={i}
                                    data-size={big ? "big" : "small"}
                                    aria-hidden={big ? "false" : "true"}
                                >
                                    <div
                                        class:list={[
                                            "absolute inset-y-0 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.25)] transition-[left,right,border-radius] duration-[var(--d)] ease-[var(--e)] motion-reduce:transition-none",
                                            web
                                                ? "left-0 right-0 rounded-[calc(var(--k)*10px)] group-data-[size=big]:left-[calc(var(--k)*32.8px)] group-data-[size=big]:right-[calc(var(--k)*32.8px)] group-data-[size=big]:rounded-[calc(var(--k)*20px)]"
                                                : "inset-x-0 rounded-[calc(var(--k)*10px)]",
                                        ]}
                                        style={{ backgroundImage: panelBg }}
                                    ></div>
                                    <div class="absolute inset-0 cursor-pointer overflow-hidden rounded-[calc(var(--k)*10px)] group-data-[size=big]:cursor-default">
                                        {product.soon ? (
                                            <>
                                                <img
                                                    src={product.image.src}
                                                    alt=""
                                                    width={product.image.width}
                                                    height={product.image.height}
                                                    draggable="false"
                                                    class={`${img} opacity-60 blur-[calc(var(--k)*9px)]`}
                                                    style={imgVars}
                                                    loading="lazy"
                                                />
                                                <img
                                                    src="/landing/reloj.webp"
                                                    alt=""
                                                    width="290"
                                                    height="290"
                                                    draggable="false"
                                                    class={img}
                                                    style="--bx:95.7;--by:115;--bw:128;--sx:93.8;--sy:73.5;--sw:128"
                                                    loading="lazy"
                                                />
                                                <p
                                                    class="absolute left-[calc(var(--k)*41.8px)] top-[calc(var(--k)*204.5px)] flex h-[calc(var(--k)*59px)] w-[calc(var(--k)*230px)] items-center justify-center rounded-[calc(var(--k)*15px)] border-2 border-white/50 bg-white/10 font-poppins text-[calc(var(--k)*20px)] font-bold leading-[21px] text-white shadow-[0_4px_6px_1px_rgba(0,0,0,0.1)] backdrop-blur-[10px] transition-[left,top] duration-[var(--d)] ease-[var(--e)] group-data-[size=big]:left-[calc(var(--k)*43.7px)] group-data-[size=big]:top-[calc(var(--k)*246px)] motion-reduce:transition-none"
                                                >
                                                    Próximamente
                                                </p>
                                            </>
                                        ) : (
                                            <img
                                                src={product.image.src}
                                                alt={product.image.alt}
                                                width={product.image.width}
                                                height={product.image.height}
                                                draggable="false"
                                                class={img}
                                                style={imgVars}
                                                loading={i <= 2 ? "eager" : "lazy"}
                                            />
                                        )}
                                    </div>
                                </div>
                            );
                        })
                    }
                    <!-- Desvanecidos de los bordes (Figma: 40px a la izquierda, 200px a la derecha) -->
                    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-20 w-[calc(var(--k)*40px)] bg-[linear-gradient(90deg,#f6f7fa,rgba(246,247,250,0))]"></div>
                    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-20 w-[calc(var(--k)*80px)] lg:w-[calc(var(--k)*200px)] bg-[linear-gradient(90deg,rgba(246,247,250,0),#f6f7fa)]"></div>
                </div>
            </div>

            <!-- Texto del producto activo: en 1280px cada uno va en la posición de su variante del Figma. -->
            <div class="relative mx-auto grid max-w-[1280px] px-4 py-10 sm:px-8 xl:absolute xl:left-1/2 xl:top-[867.5px] xl:h-[156px] xl:w-[1280px] xl:-translate-x-1/2 xl:px-0 xl:py-0" aria-live="polite">
                {
                    products.map((product, i) => (
                        <div
                            class:list={[
                                "col-start-1 row-start-1 flex flex-col gap-6 transition-[opacity,transform,filter] duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none lg:flex-row lg:items-center lg:justify-center lg:gap-[50px] xl:block",
                                i === 0 ? "opacity-100" : "pointer-events-none translate-y-4 opacity-0 blur-sm",
                            ]}
                            data-product-copy={i}
                            aria-hidden={i === 0 ? "false" : "true"}
                        >
                            <h3
                                class="font-poppins text-[clamp(1.75rem,4vw,2.125rem)] font-semibold leading-[1.18] tracking-[-0.85px] text-landing-navy lg:max-w-[560px] xl:absolute xl:left-[var(--tx)] xl:top-[38px] xl:w-[var(--tw)] xl:max-w-none xl:leading-10"
                                style={`--tx:${product.copy.tx}px;--tw:${product.copy.tw}px`}
                            >
                                <span class="text-landing-blue">{product.short}</span> {product.title.split("e-commerce").flatMap((part, k) => (k ? [<span class="whitespace-nowrap">e-commerce</span>, part] : [part]))}
                            </h3>
                            <p
                                class="max-w-[544px] text-base leading-[25px] text-[rgba(7,20,58,0.6)] lg:shrink-0 xl:absolute xl:left-[var(--px)] xl:top-[40.5px] xl:w-[var(--pw)] xl:max-w-none"
                                style={`--px:${product.copy.px}px;--pw:${product.copy.pw}px`}
                            >
                                {product.text}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script define:vars={{ geo, smallBoxes: products.map((_, i) => smallBox(i)) }}>
    // Figma: avance automático cada 3,5 s, cambio 800 ms ease-in-out; al arrastrar, 600 ms ease-out.
    const HOLD = 3500;
    const EASE = "cubic-bezier(0.42,0,0.58,1)";
    const EASE_DRAG = "cubic-bezier(0,0,0.58,1)";
    // Recorrido de scroll por producto mientras la sección está fija (≥1280px).
    const STEP_VH = 0.55;

    const section = document.querySelector("[data-eco]");
    if (section) {
        const list = section.querySelector("[data-product-tabs]");
        const tabs = Array.from(list.querySelectorAll('[role="tab"]'));
        const panel = section.querySelector("[data-product-panel]");
        const track = section.querySelector("[data-eco-track]");
        const slides = Array.from(section.querySelectorAll("[data-product-slide]"));
        const copies = Array.from(section.querySelectorAll("[data-product-copy]"));
        const n = slides.length;
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
        const wide = window.matchMedia("(min-width: 1280px)");
        let active = 0;
        let timer = 0;
        let visible = false;
        let hovering = false;

        // Posición de cada tarjeta según su distancia d a la activa, como en las variantes del Figma: la
        // activa grande en x=64 y las demás en fila a su derecha, cada 330px, en orden circular. Con d
        // negativo la tarjeta queda a la izquierda (fuera del carrusel): por ahí sale la que deja de
        // estar activa y vuelve a la cola sin cruzar por encima de las demás (la cola cae fuera de los 1280px).
        const offsets = slides.map((_, i) => i);
        const apply = (slide, i, d) => {
            const big = d === 0;
            const bigW = active === 0 ? geo.webW : geo.smallW;
            const sb = smallBoxes[i];
            const x = big ? geo.x0 : d > 0 ? geo.x0 + bigW + geo.gap + (d - 1) * geo.step : geo.x0 + d * geo.step;
            slide.style.setProperty("--x", String(x));
            slide.style.setProperty("--y", String(big ? geo.bigTop : sb.top));
            slide.style.setProperty("--w", String(big && i === 0 ? geo.webW : geo.smallW));
            slide.style.setProperty("--h", String(big ? geo.bigH : sb.h));
            slide.style.zIndex = big ? "2" : "1";
            slide.dataset.size = big ? "big" : "small";
        };
        const snap = (slide, i, d) => {
            slide.dataset.snap = "";
            apply(slide, i, d);
            slide.getBoundingClientRect();
            delete slide.dataset.snap;
        };
        const timers = slides.map(() => 0);
        const layout = (delta) =>
            slides.forEach((slide, i) => {
                window.clearTimeout(timers[i]);
                const d = (((i - active) % n) + n) % n;
                const vd = offsets[i] - delta;
                offsets[i] = d;
                slide.setAttribute("aria-hidden", String(d !== 0));
                if (delta > 0 && vd < 0) {
                    // Sale por la izquierda y luego pasa, sin verse, al final de la cola.
                    apply(slide, i, vd);
                    timers[i] = window.setTimeout(() => snap(slide, i, d), parseInt(panel.style.getPropertyValue("--d")) || 800);
                } else if (delta < 0 && vd >= n) {
                    // Entra desde la izquierda.
                    snap(slide, i, d + delta);
                    apply(slide, i, d);
                } else apply(slide, i, d);
            });

        const select = (index, drag = false, delta = index - active) => {
            index = Math.max(0, Math.min(n - 1, index));
            if (index === active) return;
            active = index;
            panel.style.setProperty("--d", drag ? "600ms" : "800ms");
            panel.style.setProperty("--e", drag ? EASE_DRAG : EASE);
            tabs.forEach((t, i) => {
                t.setAttribute("aria-selected", String(i === active));
                t.tabIndex = i === active ? 0 : -1;
            });
            panel.setAttribute("aria-labelledby", tabs[active].id);
            layout(delta);
            copies.forEach((copy, i) => {
                const on = i === active;
                copy.classList.toggle("opacity-100", on);
                copy.classList.toggle("opacity-0", !on);
                copy.classList.toggle("translate-y-4", !on);
                copy.classList.toggle("blur-sm", !on);
                copy.classList.toggle("pointer-events-none", !on);
                copy.setAttribute("aria-hidden", String(!on));
            });
            const tab = tabs[active];
            list.scrollTo({ left: tab.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2, behavior: "smooth" });
        };

        // ── ≥1280px: la rueda manda. La pista alarga la sección y el contenido queda fijo (sticky);
        // cada tramo de scroll corresponde a un producto.
        const stepPx = () => Math.round(window.innerHeight * STEP_VH);
        const sizeTrack = () => {
            track.style.height = wide.matches && !reduced.matches ? `${1083 + stepPx() * n}px` : "";
        };
        const trackTop = () => track.getBoundingClientRect().top + window.scrollY;
        // El contenido se fija cuando su borde inferior toca el de la ventana (o arriba, si cabe entero).
        const pinStart = () => trackTop() + Math.max(0, 1083 - window.innerHeight);
        const fromScroll = () => {
            if (!wide.matches || reduced.matches) return;
            const p = (window.scrollY - pinStart()) / stepPx();
            select(Math.floor(Math.max(0, p)));
        };
        const scrollToProduct = (i) => {
            const target = pinStart() + (i + 0.5) * stepPx();
            const from = window.scrollY;
            const t0 = performance.now();
            const ease = (t) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
            const tick = (now) => {
                const t = Math.min(1, (now - t0) / 800);
                window.scrollTo(0, from + (target - from) * ease(t));
                if (t < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
        };
        window.addEventListener("scroll", fromScroll, { passive: true });

        // ── Por debajo de 1280px: avance automático, pestañas y deslizar con el dedo.
        const stop = () => window.clearTimeout(timer);
        const start = () => {
            stop();
            if (wide.matches || reduced.matches || hovering || !visible) return;
            timer = window.setTimeout(() => {
                select(active === n - 1 ? 0 : active + 1, false, 1);
                start();
            }, HOLD);
        };
        const go = (i, drag = false) => {
            if (wide.matches && !reduced.matches) scrollToProduct(Math.max(0, Math.min(n - 1, i)));
            else {
                select(((i % n) + n) % n, drag, i - active);
                start();
            }
        };

        tabs.forEach((tab, i) => tab.addEventListener("click", () => go(i)));
        slides.forEach((slide, i) => slide.addEventListener("click", () => i !== active && go(i)));
        list.addEventListener("keydown", (e) => {
            const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
            if (!step) return;
            e.preventDefault();
            go(active + step);
            tabs[Math.max(0, Math.min(n - 1, active + step))].focus();
        });

        let downX = null;
        panel.addEventListener("pointerdown", (e) => (downX = e.clientX));
        panel.addEventListener("pointerup", (e) => {
            if (downX === null) return;
            const dx = e.clientX - downX;
            downX = null;
            if (Math.abs(dx) > 40) go(active + (dx < 0 ? 1 : -1), true);
        });
        panel.addEventListener("pointercancel", () => (downX = null));
        panel.addEventListener("mouseenter", () => ((hovering = true), stop()));
        panel.addEventListener("mouseleave", () => ((hovering = false), start()));

        // Escala: lienzo de 1280px desde 1024px; más angosto se reduce para que se vea la tarjeta siguiente.
        const resize = () => {
            const w = panel.clientWidth;
            panel.style.setProperty("--k", String(w >= 1024 ? 1 : Math.max(0.55, Math.min(1, w / 1000))));
            sizeTrack();
            fromScroll();
            start();
        };
        new ResizeObserver(resize).observe(panel);
        wide.addEventListener("change", resize);
        reduced.addEventListener("change", resize);
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            start();
        }).observe(panel);
        resize();
    }
</script>
