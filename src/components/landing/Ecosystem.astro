---
import Overview from "./Overview.astro";

// Cada pestaña muestra su pantalla en el panel central. Fila Cero, Atlas y Ágora aún no tienen
// captura en el Figma, así que muestran un panel con su nombre hasta que se agregue.
const products = [
    { name: "Midaz Web (Core)", image: { src: "/landing/macbook.webp", width: 604, height: 385, alt: "Midaz Web en una laptop mostrando el módulo de facturas" }, laptop: true },
    { name: "Fila Cero" },
    { name: "Atlas" },
    { name: "Ágora" },
    { name: "MidazPay", image: { src: "/landing/pos.webp", width: 314, height: 411, alt: "MidazPay en un punto de venta Disglobal" }, fill: true },
    { name: "Midaz App", image: { src: "/landing/phone.webp", width: 361, height: 594, alt: "Midaz App: pedidos desde la mesa en un iPhone" } },
    { name: "Midaz Marketplace", image: { src: "/landing/iphone15.webp", width: 196, height: 391, alt: "Midaz Marketplace: ficha de producto en un iPhone" } },
];
const panelBg = "linear-gradient(152deg, #07143a 1.5%, #1337a0 97.6%)";
// Posición de cada tarjeta según su distancia a la activa: centro, vecinas, extremos y fuera de vista.
// x es el centro de la tarjeta respecto al centro del carrusel (px de Figma a 1280).
const slots: Record<string, { x: number; w: number; h: number; o: number; z: number }> = {
    "0": { x: 0, w: 538, h: 465, o: 1, z: 30 },
    "1": { x: 459, w: 314, h: 411, o: 1, z: 20 },
    "2": { x: 783, w: 314, h: 345, o: 1, z: 10 },
    "3": { x: 1107, w: 314, h: 345, o: 0, z: 0 },
};
---

<section id="productos" class="pt-6 lg:pt-0">
    <header class="mx-auto flex max-w-[673px] flex-col items-center gap-4 px-4 pb-[30px] text-center">
        <h2 class="font-funnel text-[clamp(2.25rem,6vw,3.375rem)] font-semibold leading-[1.02] tracking-[-0.041em] text-landing-navy">
            <span class="block text-landing-orange">Un ecosistema completo,</span>
            <span class="block">no una app suelta</span>
        </h2>
        <p class="max-w-[641px] text-base lg:-mx-2 lg:max-w-none leading-[25px] text-[rgba(7,20,58,0.6)]">
            Empiezas por donde te haga falta y creces sin cambiar de sistema. El inventario,<br class="hidden lg:inline" /> los precios y la contabilidad son los mismos en todos los canales.
        </p>
    </header>

    <div class="pb-5">
        <div role="tablist" aria-label="Productos Midaz" class="flex gap-[10px] overflow-x-auto px-4 py-2 [scrollbar-width:none] md:flex-wrap md:justify-center" data-product-tabs>
            {
                products.map((product, i) => (
                    <button
                        type="button"
                        role="tab"
                        id={`producto-tab-${i}`}
                        aria-controls="producto-panel"
                        aria-selected={i === 0 ? "true" : "false"}
                        tabindex={i === 0 ? 0 : -1}
                        class="group flex h-[42px] shrink-0 items-center justify-center gap-[10px] rounded-[10px] border border-[#d1d5db] bg-white px-5 text-base font-medium leading-4 text-landing-navy transition-colors hover:border-landing-navy aria-selected:border-landing-navy aria-selected:bg-landing-navy aria-selected:h-10 aria-selected:border-0 aria-selected:px-[21.5px] aria-selected:text-white aria-selected:drop-shadow-[0_1px_1px_rgba(0,0,0,0.05)]"
                    >
                        {product.name}
                        <img src="/landing/icons/arrow-circle-right.svg" alt="" width="28" height="28" class="hidden size-7 group-aria-selected:block" />
                    </button>
                ))
            }
        </div>
    </div>

    <!-- Carrusel de dispositivos: todas las tarjetas se deslizan en horizontal y la activa queda al centro.
         Las medidas de cada posición son las del Figma (centro 538×465, vecinas 314×411, extremos 314×345);
         --k las escala en pantallas más angostas. -->
    <div class="overflow-hidden pb-4 pt-2 lg:pb-[44px] lg:pt-[15px]">
        <div
            id="producto-panel"
            role="tabpanel"
            aria-labelledby="producto-tab-0"
            aria-roledescription="carrusel"
            class="relative mx-auto h-[calc(var(--k)*465px)] w-full touch-pan-y select-none [--k:0.56] sm:[--k:0.8] lg:[--k:1] xl:translate-x-[1.5px]"
            data-product-panel
        >
            {
                products.map((product, i) => {
                    const d = i > products.length / 2 ? i - products.length : i;
                    const slot = slots[String(Math.min(Math.abs(d), 3))];
                    return (
                        <div
                            class="group absolute left-1/2 top-1/2 transition-[transform,width,height,opacity] duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)] motion-reduce:transition-none"
                            style={`--x:${Math.sign(d) * slot.x};width:calc(var(--k)*${slot.w}px);height:calc(var(--k)*${slot.h}px);opacity:${slot.o};z-index:${slot.z};transform:translate(-50%,-50%) translateX(calc(var(--x)*var(--k)*1px))`}
                            data-product-slide={i}
                            data-pos={d === 0 ? "center" : "side"}
                            aria-hidden={d === 0 ? "false" : "true"}
                        >
                            <div class="absolute inset-0 overflow-hidden rounded-[10px] shadow-[0_10px_30px_-10px_rgba(0,0,0,0.25)] transition-[border-radius] duration-[900ms] group-data-[pos=center]:rounded-[20px]" style={{ backgroundImage: panelBg }}></div>
                            <div class="absolute inset-0 flex cursor-pointer items-center justify-center group-data-[pos=center]:cursor-default">
                                {product.image ? (
                                    <img
                                        src={product.image.src}
                                        alt={product.image.alt}
                                        width={product.image.width}
                                        height={product.image.height}
                                        draggable="false"
                                        class:list={[
                                            "relative max-w-none transition-[width,height] duration-[900ms] ease-[cubic-bezier(0.16,1,0.3,1)]",
                                            product.laptop ? "h-auto w-[94%] group-data-[pos=center]:w-[112.2%]" : product.fill ? "h-full w-auto group-data-[pos=center]:h-[88%]" : "h-[92%] w-auto group-data-[pos=center]:h-[88%]",
                                        ]}
                                        loading={i === 0 ? "eager" : "lazy"}
                                    />
                                ) : (
                                    <div class="relative flex flex-col items-center gap-[calc(var(--k)*16px)] px-[12%] text-center text-white">
                                        <img src="/landing/icons/logo.svg" alt="" width="128" height="30" draggable="false" class="h-auto w-[calc(var(--k)*96px)] brightness-0 invert group-data-[pos=center]:w-[calc(var(--k)*128px)]" />
                                        <p class="font-funnel text-[calc(var(--k)*30px)] font-semibold leading-none tracking-[-0.03em] group-data-[pos=center]:text-[calc(var(--k)*54px)]">{product.name}</p>
                                    </div>
                                )}
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>

    <Overview align="center">
        <Fragment slot="title"><span class="text-landing-blue">Midaz Web</span> es el centro operativo de tu negocio</Fragment>
        Sincroniza todas tus sedes y canales de venta en tiempo real. Controla tus libros de ventas, la tasa BCV y tu inventario sin errores operativos ni riesgos fiscales.
    </Overview>
</section>

<script define:vars={{ slots }}>
    // Carrusel de productos: avanza solo cada pocos segundos (se pausa con el mouse encima, con el
    // foco de teclado o fuera de pantalla). Las pestañas, un clic en una tarjeta lateral o deslizar
    // con el dedo también lo mueven.
    const INTERVAL = 4500;
    document.querySelectorAll("[data-product-tabs]").forEach((list) => {
        const section = list.closest("section");
        const tabs = Array.from(list.querySelectorAll('[role="tab"]'));
        const panel = section.querySelector("[data-product-panel]");
        const slides = Array.from(section.querySelectorAll("[data-product-slide]"));
        const n = slides.length;
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
        const offsets = slides.map((_, i) => (i > n / 2 ? i - n : i));
        let active = 0;
        let timer;
        let hovering = false;
        let focused = false;
        let visible = false;

        const place = (slide, d, animate) => {
            const slot = slots[String(Math.min(Math.abs(d), 3))];
            if (!animate) slide.style.transition = "none";
            slide.style.setProperty("--x", String(Math.sign(d) * slot.x));
            slide.style.width = `calc(var(--k)*${slot.w}px)`;
            slide.style.height = `calc(var(--k)*${slot.h}px)`;
            slide.style.opacity = String(slot.o);
            slide.style.zIndex = String(slot.z);
            slide.dataset.pos = d === 0 ? "center" : "side";
            slide.setAttribute("aria-hidden", String(d !== 0));
            if (!animate) {
                slide.getBoundingClientRect();
                slide.style.transition = "";
            }
        };

        const select = (index) => {
            active = ((index % n) + n) % n;
            tabs.forEach((t, i) => {
                t.setAttribute("aria-selected", String(i === active));
                t.tabIndex = i === active ? 0 : -1;
            });
            panel.setAttribute("aria-labelledby", tabs[active].id);
            slides.forEach((slide, i) => {
                let d = (((i - active) % n) + n) % n;
                if (d > n / 2) d -= n;
                // La tarjeta que da la vuelta (de un extremo al otro) salta sin cruzar el carrusel.
                place(slide, d, Math.abs(d - offsets[i]) <= n / 2);
                offsets[i] = d;
            });
            const tab = tabs[active];
            list.scrollTo({ left: tab.offsetLeft - (list.clientWidth - tab.offsetWidth) / 2, behavior: "smooth" });
        };

        const stop = () => window.clearInterval(timer);
        const start = () => {
            stop();
            if (reduced.matches || hovering || focused || !visible) return;
            timer = window.setInterval(() => select(active + 1), INTERVAL);
        };
        const go = (index) => {
            select(index);
            start();
        };

        tabs.forEach((tab, i) => tab.addEventListener("click", () => go(i)));
        slides.forEach((slide, i) => slide.addEventListener("click", () => i !== active && go(i)));
        list.addEventListener("keydown", (e) => {
            const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
            if (!step) return;
            e.preventDefault();
            select(active + step);
            tabs[active].focus();
        });

        // Deslizar con el dedo (o arrastrar con el mouse) cambia de tarjeta.
        let downX = null;
        panel.addEventListener("pointerdown", (e) => (downX = e.clientX));
        panel.addEventListener("pointerup", (e) => {
            if (downX === null) return;
            const dx = e.clientX - downX;
            downX = null;
            if (Math.abs(dx) > 40) go(active + (dx < 0 ? 1 : -1));
        });
        panel.addEventListener("pointercancel", () => (downX = null));

        // Escala del carrusel: tamaño de Figma desde 1024px; más angosto, la tarjeta central ocupa ~78% del ancho.
        const resize = () => {
            const w = panel.clientWidth;
            panel.style.setProperty("--k", String(w >= 1024 ? 1 : Math.min(1, (w * 0.78) / 538)));
        };
        new ResizeObserver(resize).observe(panel);
        resize();

        [list, panel].forEach((el) => {
            el.addEventListener("mouseenter", () => ((hovering = true), stop()));
            el.addEventListener("mouseleave", () => ((hovering = false), start()));
        });
        // Solo el foco de teclado pausa; un clic con el mouse no debe dejarlo detenido.
        list.addEventListener("focusin", (e) => {
            if (!e.target.matches(":focus-visible")) return;
            focused = true;
            stop();
        });
        list.addEventListener("focusout", () => ((focused = false), start()));
        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            start();
        }).observe(panel);
        reduced.addEventListener("change", start);
    });
</script>
