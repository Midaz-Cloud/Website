---
interface Props {
    currentPath?: string;
}
const { currentPath = "/" } = Astro.props;
---

<header id="navbar" class="navbar">
    <div class="navbar-inner">
        <!-- Logo -->
        <a href="/" class="navbar-logo">
            <img src="/logo-white.svg" alt="Midaz" class="navbar-logo-img" />
        </a>

        <!-- Desktop nav -->
        <nav class="navbar-links" aria-label="Navegación principal">
            <a href="/#producto" class="nav-link">Producto</a>
            <a href="/#como-funciona" class="nav-link">Cómo funciona</a>
            <a href="/#para-quien" class="nav-link">Para quién</a>
            <a href="/#contacto" class="nav-link">Contacto</a>
            <a href="/comenzar" class="nav-cta">Solicitar acceso</a>
        </nav>

        <!-- Hamburger -->
        <button id="mobile-btn" class="hamburger" aria-label="Abrir menú" aria-expanded="false">
            <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
            <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>
    </div>

    <!-- Mobile drawer -->
    <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
        <a href="/#producto" class="drawer-link">Producto</a>
        <a href="/#como-funciona" class="drawer-link">Cómo funciona</a>
        <a href="/#para-quien" class="drawer-link">Para quién</a>
        <a href="/#contacto" class="drawer-link">Contacto</a>
        <a href="/comenzar" class="drawer-cta">Solicitar acceso</a>
    </div>
</header>

<style>
    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        transition: background 0.3s ease, backdrop-filter 0.3s ease;
    }
    .navbar.scrolled {
        background: rgba(7, 20, 58, 0.95);
        backdrop-filter: blur(12px);
    }
    .navbar-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .navbar-logo {
        display: flex;
        align-items: center;
        text-decoration: none;
    }
    .navbar-logo-img {
        height: 32px;
        width: auto;
    }
    .navbar-links {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .nav-link {
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: #a9ccff;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 6px;
        transition: color 0.2s ease;
    }
    .nav-link:hover { color: #ffffff; }
    .nav-cta {
        background: #004be0;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 600;
        padding: 10px 24px;
        border-radius: 8px;
        text-decoration: none;
        margin-left: 8px;
        transition: background 0.2s ease;
    }
    .nav-cta:hover { background: #0040c0; }
    .hamburger {
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        color: #ffffff;
        padding: 4px;
    }
    .mobile-drawer {
        position: fixed;
        inset: 0;
        background: #07143a;
        z-index: 99;
        display: flex;
        flex-direction: column;
        padding: 80px 32px 40px;
        gap: 8px;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
    }
    .mobile-drawer.open { transform: translateX(0); }
    .drawer-link {
        font-family: 'Inter', sans-serif;
        font-size: 20px;
        color: #a9ccff;
        text-decoration: none;
        padding: 16px 0;
        border-bottom: 1px solid rgba(169, 204, 255, 0.1);
        transition: color 0.2s ease;
    }
    .drawer-link:hover { color: #ffffff; }
    .drawer-cta {
        margin-top: 24px;
        background: #004be0;
        color: #ffffff;
        font-family: 'Inter', sans-serif;
        font-size: 16px;
        font-weight: 600;
        padding: 16px 32px;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        transition: background 0.2s ease;
    }
    .drawer-cta:hover { background: #0040c0; }

    @media (max-width: 1024px) {
        .navbar-links { display: none; }
        .hamburger { display: flex; }
    }
</style>

<script>
    const navbar   = document.getElementById('navbar');
    const mobileBtn    = document.getElementById('mobile-btn');
    const drawer   = document.getElementById('mobile-drawer');
    const iconOpen  = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    window.addEventListener('scroll', () => {
        if (!navbar) return;
        if (window.scrollY > 80) {
            navbar.classList.add('scrolled');
        } else {
            navbar.classList.remove('scrolled');
        }
    }, { passive: true });

    mobileBtn?.addEventListener('click', () => {
        const isOpen = drawer?.classList.contains('open');
        if (isOpen) {
            drawer?.classList.remove('open');
            if (iconOpen) iconOpen.style.display = '';
            if (iconClose) iconClose.style.display = 'none';
            mobileBtn.setAttribute('aria-expanded', 'false');
            drawer?.setAttribute('aria-hidden', 'true');
        } else {
            drawer?.classList.add('open');
            if (iconOpen) iconOpen.style.display = 'none';
            if (iconClose) iconClose.style.display = '';
            mobileBtn.setAttribute('aria-expanded', 'true');
            drawer?.setAttribute('aria-hidden', 'false');
        }
    });

    document.querySelectorAll('.drawer-link, .drawer-cta').forEach(link => {
        link.addEventListener('click', () => {
            drawer?.classList.remove('open');
            if (iconOpen) iconOpen.style.display = '';
            if (iconClose) iconClose.style.display = 'none';
        });
    });

    document.querySelectorAll('a[href^="#"]').forEach(link => {
        link.addEventListener('click', (e) => {
            const href = (link as HTMLAnchorElement).getAttribute('href') || '';
            if (!href.startsWith('#') && !href.includes('/#')) return;
            const id = href.includes('/#') ? href.split('/#')[1] : href.slice(1);
            const target = document.getElementById(id);
            if (target) {
                e.preventDefault();
                target.scrollIntoView({ behavior: 'smooth' });
            }
        });
    });
</script>
