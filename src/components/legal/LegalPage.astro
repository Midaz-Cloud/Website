---
// Página de un documento legal (Guía de Implementación, sección 2): texto oficial tal cual, versión,
// fecha de entrada en vigor, PDF y el archivo de versiones. La usan /legal/<doc> (vigente) y /legal/<doc>/<v> (fija).
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { join } from "node:path";
import LandingLayout from "../../layouts/LandingLayout.astro";
import Navbar from "../landing/Navbar.astro";
import LandingFooter from "../landing/LandingFooter.astro";
import { LEGAL_DOCS, LEGAL_ORDER, currentVersion, versionUrl } from "../../data/legal.mjs";

interface Props {
    doc: keyof typeof LEGAL_DOCS;
    slug: string;
    /** true en /legal/<doc>: muestra la vigente sin número en la URL. */
    latest?: boolean;
}
const { doc, slug, latest = false } = Astro.props;
const info = LEGAL_DOCS[doc];
const v = info.versions.find((x) => x.slug === slug)!;
const current = currentVersion(doc);
const isCurrent = v.slug === current.slug;

// Texto convertido del .docx oficial (scripts/legal/importar.py).
const bodies = import.meta.glob("/src/legal/*/*.html", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const body = bodies[`/src/legal/${doc}/${v.slug}.html`];
if (!body) throw new Error(`Falta src/legal/${doc}/${v.slug}.html`);

// La huella registrada debe ser la del texto publicado: si alguien edita una versión publicada, el build falla.
const txtPath = `/legal/${doc}/${v.slug}.txt`;
const sha = createHash("sha256").update(readFileSync(join(process.cwd(), "public", txtPath))).digest("hex");
if (sha !== v.sha256) throw new Error(`La huella de ${txtPath} (${sha}) no coincide con src/data/legal.mjs. Una versión publicada no se modifica: publica una versión nueva.`);

// Índice de cláusulas a partir de los encabezados del texto.
const toc = [...body.matchAll(/<h2 id="([^"]+)">(.*?)<\/h2>/g)].map((m) => ({
    id: m[1],
    label: m[2].replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim(),
}));
const pdf = `/legal/${doc}/${v.slug}.pdf`;
const title = `${info.title} · Versión ${v.version} | Midaz`;
const description = `${info.fullTitle}, versión ${v.version}, en vigor desde el ${v.effectiveText}. MIDAZ LATAM, C.A.`;
---

<LandingLayout title={title} description={description} intro={false} noindex={!isCurrent} canonicalPath={isCurrent ? `/legal/${doc}` : undefined}>
    <Navbar home={false} />
    <main class="legal mx-auto max-w-[880px] px-4 pb-20 pt-10 sm:px-8 lg:pt-14">
        <nav aria-label="Documentos legales" class="flex flex-wrap gap-2">
            {
                LEGAL_ORDER.map((d) => (
                    <a
                        href={`/legal/${d}`}
                        class:list={[
                            "rounded-full border px-4 py-2 font-[Inter] text-sm font-semibold leading-5 transition-colors",
                            d === doc
                                ? "border-landing-blue bg-landing-blue text-white"
                                : "border-[rgba(0,75,224,0.25)] bg-white/70 text-landing-navy hover:border-landing-blue hover:text-landing-blue",
                        ]}
                        aria-current={d === doc ? "page" : undefined}
                    >
                        {LEGAL_DOCS[d].title}
                    </a>
                ))
            }
        </nav>

        <header class="mt-8 rounded-[26px] bg-landing-blue px-6 py-8 text-white shadow-[0_20px_40px_-20px_rgba(0,75,224,0.6)] sm:px-10 sm:py-10">
            <p class="font-[Inter] text-xs font-semibold uppercase tracking-[1.2px] text-white/80">MIDAZ LATAM, C.A.</p>
            <h1 class="mt-3 font-funnel text-[clamp(1.875rem,4.5vw,2.75rem)] font-bold leading-[1.1] tracking-[-0.02em]">{info.fullTitle}</h1>
            <p class="mt-2 text-sm text-white/85">{info.subtitle}</p>
            <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3 text-sm">
                <div>
                    <dt class="text-white/70">Versión</dt>
                    <dd class="font-semibold">{v.version}{isCurrent ? " · vigente" : ""}</dd>
                </div>
                <div>
                    <dt class="text-white/70">Fecha de entrada en vigor</dt>
                    <dd class="font-semibold"><time datetime={v.effective}>{v.effectiveText}</time></dd>
                </div>
            </dl>
            <div class="mt-6 flex flex-wrap items-center gap-3">
                <a
                    href={pdf}
                    download={`Midaz_${info.title.replace(/\s+/g, "_")}_v${v.version}.pdf`}
                    class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 font-[Inter] text-sm font-semibold text-landing-blue transition-colors hover:bg-white/90"
                >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
                    </svg>
                    Descargar PDF
                </a>
                {latest && <a href={versionUrl(doc, v)} class="font-[Inter] text-sm font-semibold text-white underline underline-offset-4 hover:text-white/85">Enlace fijo a esta versión</a>}
            </div>
        </header>

        {
            !isCurrent && (
                <p role="note" class="mt-6 rounded-2xl border border-[rgba(255,149,33,0.5)] bg-[rgba(255,149,33,0.1)] px-5 py-4 text-sm font-medium text-landing-navy">
                    Esta versión ya no está vigente. La versión vigente es la{" "}
                    <a href={`/legal/${doc}`} class="font-semibold text-landing-blue underline underline-offset-2">
                        {current.version}, en vigor desde el {current.effectiveText}
                    </a>
                    .
                </p>
            )
        }

        {
            toc.length > 3 && (
                <details class="mt-8 rounded-2xl border border-[rgba(152,171,204,0.6)] bg-white/70 px-5 py-4">
                    <summary class="cursor-pointer font-[Inter] text-sm font-semibold text-landing-navy">Contenido</summary>
                    <ol class="mt-3 grid gap-1 text-sm sm:grid-cols-2">
                        {toc.map((t) => (
                            <li>
                                <a href={`#${t.id}`} class="text-landing-navy/80 hover:text-landing-blue hover:underline">
                                    {t.label}
                                </a>
                            </li>
                        ))}
                    </ol>
                </details>
            )
        }

        <article class="legal-texto mt-10" set:html={body} />

        <section aria-labelledby="versiones" class="mt-14 border-t border-[rgba(152,171,204,0.6)] pt-8">
            <h2 id="versiones" class="font-funnel text-xl font-bold text-landing-navy">Versiones publicadas</h2>
            <p class="mt-2 text-sm text-[rgba(7,20,58,0.7)]">
                Cada versión se conserva sin cambios en su propia dirección. Un cambio en el documento se publica como una versión nueva.
            </p>
            <ul class="mt-4 divide-y divide-[rgba(152,171,204,0.4)] rounded-2xl border border-[rgba(152,171,204,0.6)] bg-white/70">
                {
                    info.versions.map((x) => (
                        <li class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 text-sm">
                            <a href={versionUrl(doc, x)} class="font-semibold text-landing-blue hover:underline">
                                Versión {x.version}
                            </a>
                            <span class="text-[rgba(7,20,58,0.7)]">
                                En vigor desde el {x.effectiveText}
                                {x.slug === current.slug && <span class="ml-2 rounded-full bg-[rgba(0,75,224,0.1)] px-2 py-0.5 text-xs font-semibold text-landing-blue">Vigente</span>}
                            </span>
                            <span class="flex gap-4">
                                <a href={`/legal/${doc}/${x.slug}.pdf`} class="text-landing-navy hover:text-landing-blue hover:underline">PDF</a>
                                <a href={`/legal/${doc}/${x.slug}.txt`} class="text-landing-navy hover:text-landing-blue hover:underline" title={`SHA-256 ${x.sha256}`}>
                                    Texto
                                </a>
                            </span>
                        </li>
                    ))
                }
            </ul>
            <p class="mt-3 break-all font-mono text-[11px] leading-4 text-[rgba(7,20,58,0.55)]">Huella SHA-256 del texto de la versión {v.version}: {v.sha256}</p>
        </section>
    </main>
    <LandingFooter home={false} />
</LandingLayout>

<style is:global>
    .legal-texto {
        color: rgba(7, 20, 58, 0.85);
        font-size: 15px;
        line-height: 1.7;
    }
    .legal-texto > * + * {
        margin-top: 0.9em;
    }
    .legal-texto h2 {
        margin-top: 2.4em;
        scroll-margin-top: 120px;
        border-top: 2px solid #004be0;
        padding-top: 0.9em;
        font-family: "Funnel Display", sans-serif;
        font-size: 19px;
        font-weight: 700;
        line-height: 1.3;
        color: #004be0;
    }
    .legal-texto h2 .legal-num {
        display: block;
        margin-bottom: 2px;
        font-size: 12px;
        letter-spacing: 0.08em;
    }
    .legal-texto strong {
        color: #07143a;
        font-weight: 600;
    }
    .legal-texto ul,
    .legal-texto ol {
        padding-left: 1.4em;
    }
    .legal-texto ul {
        list-style: disc;
    }
    .legal-texto ol {
        list-style: decimal;
    }
    .legal-texto li + li {
        margin-top: 0.4em;
    }
    .legal-texto a {
        color: #004be0;
        text-decoration: underline;
    }
    .legal-recuadro {
        border-left: 4px solid #004be0;
        border-radius: 14px;
        background: rgba(0, 75, 224, 0.06);
        padding: 18px 22px;
    }
    .legal-recuadro > * + * {
        margin-top: 0.7em;
    }
    .legal-tabla {
        overflow-x: auto;
        border: 1px solid rgba(152, 171, 204, 0.6);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.7);
    }
    .legal-tabla table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
        line-height: 1.5;
    }
    .legal-tabla th,
    .legal-tabla td {
        padding: 10px 14px;
        text-align: left;
        vertical-align: top;
        border-top: 1px solid rgba(152, 171, 204, 0.4);
    }
    .legal-tabla thead th {
        border-top: 0;
        background: rgba(0, 75, 224, 0.08);
        color: #07143a;
        font-weight: 600;
    }
    .legal-tabla p {
        margin: 0;
    }
    .legal-cierre {
        margin-top: 2.5em !important;
        font-size: 13px;
        font-weight: 600;
        color: rgba(7, 20, 58, 0.6);
    }
</style>
