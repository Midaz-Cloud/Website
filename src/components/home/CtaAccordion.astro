---
export interface CtaCard {
  slug: string;
  badge: string;
  title: string;
  sub: string;
  image: string;
  metric: string;
  caption: string;
  href: string;
  cta: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  note?: string;
  cards: CtaCard[];
}

const { eyebrow, heading, note, cards } = Astro.props;
---

<section id="contacto" class="cta-accordion-section">
  <header class="cta-header">
    {eyebrow && <p class="cta-eyebrow">{eyebrow}</p>}
    <h2 class="cta-heading" set:html={heading} />
    {note && <p class="cta-note-top">{note}</p>}
  </header>

  <div class="cta-row" role="list">
    {cards.map((c, i) => (
      <article
        class="cta-card"
        role="listitem"
        tabindex="0"
        data-slug={c.slug}
        style={`--i:${i}`}
      >
        <img
          class="cta-poster"
          src={c.image}
          alt={c.title}
          loading="lazy"
          decoding="async"
        />

        <div class="cta-overlay-base">
          <span class="cta-badge">{c.badge}</span>
          <h3 class="cta-card-title">{c.title}</h3>
          <p class="cta-card-sub">{c.sub}</p>
        </div>

        <div class="cta-overlay-active">
          <div class="cta-metric-block">
            <p class="cta-metric">{c.metric}</p>
            <p class="cta-caption">{c.caption}</p>
          </div>
          <a class="cta-btn-link" href={c.href}>
            {c.cta}
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* ── SHELL ── */
  .cta-accordion-section {
    background: #07143a;
    color: #f5f5f0;
    padding: clamp(4rem, 10vw, 7rem) clamp(1rem, 4vw, 3rem);
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* ── HEADER ── */
  .cta-header {
    max-width: 1400px;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .cta-eyebrow {
    display: block;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12px;
    color: #f49a40;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin: 0 0 20px;
  }

  .cta-heading {
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 1.25rem;
    color: #ffffff;
  }

  .cta-heading :global(em) {
    font-style: italic;
    color: #f49a40;
  }

  .cta-note-top {
    font-size: 1rem;
    color: rgba(169, 204, 255, 0.75);
    margin: 0;
    line-height: 1.6;
    max-width: 540px;
    margin-inline: auto;
  }

  /* ── ROW ── */
  .cta-row {
    display: flex;
    gap: 4px;
    height: clamp(460px, 62vh, 640px);
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── CARDS ── */
  .cta-card {
    position: relative;
    flex: 1 1 0;
    overflow: hidden;
    cursor: pointer;
    background: #0f1e45;
    transition: flex-grow 700ms cubic-bezier(0.65, 0, 0.35, 1);
    outline: none;
    border-radius: 2px;
  }

  .cta-row:hover .cta-card,
  .cta-row:focus-within .cta-card {
    flex-grow: 0.4;
  }

  .cta-row .cta-card:hover,
  .cta-row .cta-card:focus-visible,
  .cta-row .cta-card.is-active {
    flex-grow: 4;
  }

  /* ── POSTER ── */
  .cta-poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.35) saturate(0.7);
    transition: filter 700ms ease;
  }

  .cta-card:hover .cta-poster,
  .cta-card:focus-visible .cta-poster,
  .cta-card.is-active .cta-poster {
    filter: brightness(0.55) saturate(1);
  }

  /* ── OVERLAY BASE (siempre visible, se oculta en hover) ── */
  .cta-overlay-base {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.5rem;
    pointer-events: none;
    transition: opacity 400ms ease;
    text-align: center;
  }

  .cta-card:hover .cta-overlay-base,
  .cta-card:focus-visible .cta-overlay-base,
  .cta-card.is-active .cta-overlay-base {
    opacity: 0;
  }

  .cta-badge {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f49a40;
    border: 1px solid rgba(244, 154, 64, 0.5);
    padding: 3px 10px;
    border-radius: 99px;
    margin-bottom: 0.4rem;
  }

  .cta-card-title {
    font-size: clamp(1.6rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: #f5f5f0;
    margin: 0;
    line-height: 1.05;
    letter-spacing: -0.02em;
    mix-blend-mode: screen;
    opacity: 0.9;
  }

  .cta-card-sub {
    margin: 0;
    font-size: 0.8rem;
    color: rgba(245, 245, 240, 0.55);
    letter-spacing: 0.02em;
  }

  /* ── OVERLAY ACTIVE (aparece en hover) ── */
  .cta-overlay-active {
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.75rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 350ms ease 100ms;
    background: linear-gradient(
      to top,
      rgba(7, 20, 58, 0.85) 0%,
      rgba(7, 20, 58, 0.3) 55%,
      transparent 100%
    );
  }

  .cta-card:hover .cta-overlay-active,
  .cta-card:focus-visible .cta-overlay-active,
  .cta-card.is-active .cta-overlay-active {
    opacity: 1;
    pointer-events: auto;
  }

  .cta-metric-block {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    transform: translateY(20px);
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1) 150ms;
  }

  .cta-card:hover .cta-metric-block,
  .cta-card:focus-visible .cta-metric-block,
  .cta-card.is-active .cta-metric-block {
    transform: translateY(0);
  }

  .cta-metric {
    font-size: clamp(1.25rem, 2.8vw, 2rem);
    font-weight: 400;
    margin: 0;
    line-height: 1.1;
    color: #f5f5f0;
    letter-spacing: -0.01em;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(245, 245, 240, 0.3);
  }

  .cta-caption {
    margin: 0;
    font-size: 0.875rem;
    color: rgba(245, 245, 240, 0.8);
    letter-spacing: 0.01em;
  }

  /* ── CTA BUTTON ── */
  .cta-btn-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #f49a40;
    color: #07143a;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.65rem 1.4rem;
    border-radius: 4px;
    transition: background 200ms ease, gap 250ms ease;
    letter-spacing: 0.01em;
  }

  .cta-btn-link:hover {
    background: #ffb05a;
    gap: 0.9rem;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .cta-row {
      flex-direction: column;
      height: auto;
    }

    .cta-card {
      height: 320px;
      flex: 0 0 auto !important;
    }

    .cta-overlay-base {
      opacity: 0;
    }

    .cta-overlay-active {
      opacity: 1;
      pointer-events: auto;
    }

    .cta-metric-block {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-card,
    .cta-poster,
    .cta-overlay-active,
    .cta-metric-block {
      transition: none;
    }
  }
</style>

<script>
  function initCtaAccordion() {
    const cards = document.querySelectorAll<HTMLElement>('.cta-accordion-section .cta-card');

    cards.forEach((card) => {
      card.addEventListener('touchstart', () => {
        cards.forEach((c) => c.classList.remove('is-active'));
        card.classList.add('is-active');
      }, { passive: true });
    });
  }

  document.addEventListener('astro:page-load', initCtaAccordion);
  if (document.readyState !== 'loading') initCtaAccordion();
  else document.addEventListener('DOMContentLoaded', initCtaAccordion);
</script>
