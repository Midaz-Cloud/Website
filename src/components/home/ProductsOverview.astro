---
import {
    ArrowRight,
    Store,
    UtensilsCrossed,
    Monitor,
    Zap,
    CheckCircle,
    Clock,
    Star,
} from "lucide-react";

const products = [
    {
        id: "agora",
        icon: Store,
        name: "AGORA",
        tagline: "POS General",
        quickDesc: "Retail, tiendas, comercios",
        status: "available",
        statusText: "Disponible",
        statusColor: "bg-green-500",
        gradient: "from-blue-500 to-cyan-500",
        bgColor: "bg-blue-50",
        keyFeatures: ["Setup 2h", "SENIAT incluido", "Nexgo certificado"],
        price: "Precio por anunciar",
        businesses: "🏪 Retail • 💊 Farmacias • 👕 Boutiques",
    },
    {
        id: "ambrosia",
        icon: UtensilsCrossed,
        name: "AMBROSIA",
        tagline: "Restaurantes",
        quickDesc: "F&B, costos, comandas",
        status: "coming",
        statusText: "Próximamente",
        statusColor: "bg-orange-500",
        gradient: "from-orange-500 to-red-500",
        bgColor: "bg-orange-50",
        keyFeatures: ["Costos F&B", "Comandas", "QR menús"],
        price: "Precio por anunciar",
        businesses: "🍽️ Restaurantes • ☕ Cafeterías • 🍕 Fast Food",
    },
    {
        id: "atlas",
        icon: Monitor,
        name: "ATLAS",
        tagline: "Kioscos Autopago",
        quickDesc: "Self-service, filas cero",
        status: "coming",
        statusText: "Próximamente",
        statusColor: "bg-emerald-500",
        gradient: "from-emerald-500 to-teal-500",
        bgColor: "bg-emerald-50",
        keyFeatures: ["Kiosco Nexgo", "Sin filas", "Autopago"],
        price: "Hardware incluido",
        businesses: "🍟 Fast Food • 🛒 Supermercados • ☕ Cafés",
    },
    {
        id: "eter",
        icon: Zap,
        name: "ETER",
        tagline: "Especializado",
        quickDesc: "Custom, cualquier sector",
        status: "concept",
        statusText: "Próximamente",
        statusColor: "bg-purple-500",
        gradient: "from-purple-500 to-pink-500",
        bgColor: "bg-purple-50",
        keyFeatures: ["100% Custom", "Cualquier sector", "Desarrollo ágil"],
        price: "Cotización personalizada",
        businesses: "🏥 Clínicas • 🔧 Talleres • 🧪 Laboratorios",
    },
];
---

<section
    class="py-20 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden"
    id="productos"
>
    <div class="container-custom relative z-10">
        {/* Compact header */}
        <div class="text-center mb-16 fade-in">
            <div
                class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-full font-medium mb-6 shadow-lg text-sm"
            >
                <Star className="w-4 h-4" />
                <span>Elige Tu Solución</span>
            </div>

            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                ¿Cuál es tu <span class="text-gradient">Negocio</span>?
            </h2>

            <p class="text-lg text-gray-600 max-w-2xl mx-auto mb-8">
                Selecciona la solución perfecta para tu tipo de negocio
            </p>
        </div>

        {/* Compact 4-column grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            {
                products.map((product, index) => {
                    const IconComponent = product.icon;
                    const isAvailable = product.status === "available";
                    const delay = `${index * 0.1}s`;

                    return (
                        <div
                            class={`product-card bg-white rounded-2xl p-6 border border-gray-200/50 shadow-lg hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group cursor-pointer slide-up relative ${
                                !isAvailable ? "opacity-95" : ""
                            }`}
                            style={`animation-delay: ${delay}`}
                            data-target={product.id}
                            data-available={isAvailable ? "true" : "false"}
                        >
                            {/* Status badge - compact */}
                            <div class="absolute -top-2 -right-2">
                                <div
                                    class={`${product.statusColor} text-white px-3 py-1 rounded-full text-xs font-bold shadow-md flex items-center gap-1`}
                                >
                                    {isAvailable ? (
                                        <CheckCircle className="w-3 h-3" />
                                    ) : (
                                        <Clock className="w-3 h-3" />
                                    )}
                                    {product.statusText}
                                </div>
                            </div>

                            {/* Icon and title - compact */}
                            <div class="flex items-center gap-3 mb-4">
                                <div
                                    class={`w-12 h-12 ${product.bgColor} rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform shadow-sm`}
                                >
                                    <IconComponent className="w-6 h-6 text-gray-800" />
                                </div>
                                <div>
                                    <h3 class="text-xl font-bold text-gray-900">
                                        {product.name}
                                    </h3>
                                    <p
                                        class={`text-sm font-semibold bg-gradient-to-r ${product.gradient} bg-clip-text text-transparent`}
                                    >
                                        {product.tagline}
                                    </p>
                                </div>
                            </div>

                            {/* Quick description */}
                            <p class="text-sm text-gray-600 mb-4">
                                {product.quickDesc}
                            </p>

                            {/* Business types - visual */}
                            <div class="text-xs text-gray-500 mb-4 leading-relaxed">
                                {product.businesses}
                            </div>

                            {/* Key features - compact */}
                            <div class="space-y-2 mb-4">
                                {product.keyFeatures.map((feature) => (
                                    <div class="flex items-center gap-2">
                                        <div
                                            class={`w-1.5 h-1.5 rounded-full bg-gradient-to-r ${product.gradient}`}
                                        />
                                        <span class="text-xs text-gray-700 font-medium">
                                            {feature}
                                        </span>
                                    </div>
                                ))}
                            </div>

                            {/* Price */}
                            <div class="text-sm font-bold text-gray-900 mb-4">
                                {product.price}
                            </div>

                            {/* CTA button - compact */}
                            <button
                                class={`w-full text-sm py-2 px-4 rounded-xl transition-all duration-300 group-hover:scale-105 shadow-md hover:shadow-lg font-semibold flex items-center justify-center gap-2 ${
                                    isAvailable
                                        ? "bg-gradient-to-r from-gray-900 to-gray-800 hover:from-gray-800 hover:to-gray-700 text-white"
                                        : "bg-gray-200 text-gray-500 cursor-not-allowed"
                                }`}
                                disabled={!isAvailable}
                            >
                                {isAvailable ? "Ver Detalles" : "Notificarme"}
                                <ArrowRight className="w-3 h-3" />
                            </button>
                        </div>
                    );
                })
            }
        </div>

        {/* Quick action CTA */}
        <div class="text-center">
            <div
                class="bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl p-8 text-white shadow-xl"
            >
                <h3 class="text-2xl font-bold mb-3">¿Necesitas AGORA ahora?</h3>
                <p class="text-blue-100 mb-6 max-w-xl mx-auto">
                    La única solución disponible hoy. Setup en 2 horas.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <button
                        class="btn-primary px-8 py-3 inline-flex items-center justify-center rounded-full text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 shadow-md hover:shadow-lg transition-all duration-300 font-semibold bg-gradient-to-r from-primary to-primary-dark text-white hover:from-primary-dark hover:to-primary"
                        id="implement-agora-btn"
                    >
                        <span class="mr-2">Implementar AGORA</span>
                        <ArrowRight className="w-4 h-4" />
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Handle click events for product cards
    document.querySelectorAll(".product-card").forEach((card) => {
        card.addEventListener("click", (e) => {
            const targetId = card.getAttribute("data-target");
            const isAvailable = card.getAttribute("data-available") === "true";

            if (isAvailable && targetId) {
                document
                    .getElementById(targetId)
                    ?.scrollIntoView({ behavior: "smooth" });
            }
        });
    });

    // Handle click for Implement AGORA button
    document
        .getElementById("implement-agora-btn")
        ?.addEventListener("click", () => {
            document
                .getElementById("agora")
                ?.scrollIntoView({ behavior: "smooth" });
        });
</script>
