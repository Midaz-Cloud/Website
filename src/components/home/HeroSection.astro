---
import { ArrowRight, Shield, Building2, CheckCircle } from "lucide-react";
---

<section
    class="min-h-screen hero-gradient relative overflow-hidden flex items-center pt-20"
>
    <!-- Animated background elements -->
    <div class="absolute inset-0 mesh-gradient opacity-30"></div>

    <!-- Floating elements -->
    <div
        class="absolute top-20 left-10 w-32 h-32 bg-blue-500/10 rounded-full blur-xl float"
    >
    </div>
    <div
        class="absolute bottom-20 right-10 w-48 h-48 bg-purple-500/10 rounded-full blur-xl float"
        style="animation-delay: 2s"
    >
    </div>
    <div
        class="absolute top-1/2 left-1/4 w-24 h-24 bg-cyan-500/10 rounded-full blur-xl float"
        style="animation-delay: 4s"
    >
    </div>

    <div class="container-custom relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div class="space-y-8 fade-in">
                <!-- Company heritage badge -->
                <div class="flex items-center gap-3 mb-6">
                    <div
                        class="flex items-center gap-2 bg-white/10 backdrop-blur-md rounded-full px-4 py-2 border border-white/20"
                    >
                        <Building2 className="w-4 h-4 text-blue-400" />
                        <span class="text-white/90 font-medium text-sm"
                            >by Disglobal</span
                        >
                    </div>
                </div>

                <!-- Main heading - Professional messaging -->
                <div class="space-y-4">
                    <h1
                        class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight"
                    >
                        El Amanecer de una <span class="text-gradient"
                            >Nueva Era</span
                        >
                        <br />
                        para Cada Negocio
                    </h1>
                </div>

                <!-- Professional description with current availability -->
                <div class="space-y-4">
                    <p
                        class="text-xl text-white/90 leading-relaxed max-w-2xl font-medium"
                    >
                        La solución transformadora que revoluciona negocios de
                        todos los tamaños con una suite integrada que
                        <strong class="text-blue-300">
                            maximiza eficiencia, optimiza operaciones</strong
                        > e impulsa el crecimiento empresarial.
                    </p>
                    <p class="text-lg text-white/80 leading-relaxed max-w-2xl">
                        Comienza hoy con <strong class="text-green-300"
                            >AGORA</strong
                        >, nuestro POS disponible ahora. Más soluciones
                        especializadas en desarrollo activo.
                    </p>
                </div>

                <!-- Business size indicator with availability -->
                <div
                    class="bg-gradient-to-r from-blue-600/20 to-purple-600/20 backdrop-blur-md rounded-2xl p-6 border border-blue-400/30"
                >
                    <div class="text-center mb-4">
                        <h4 class="text-white font-bold mb-2 text-lg">
                            Para Negocios de Todos los Tamaños
                        </h4>
                        <div
                            class="flex justify-center items-center gap-6 text-white/80 text-sm mb-4"
                        >
                            <span class="flex items-center gap-1">
                                <span class="w-2 h-2 bg-blue-400 rounded-full"
                                ></span>
                                Pequeños
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="w-2 h-2 bg-purple-400 rounded-full"
                                ></span>
                                Medianos
                            </span>
                            <span class="flex items-center gap-1">
                                <span class="w-2 h-2 bg-cyan-400 rounded-full"
                                ></span>
                                Grandes
                            </span>
                        </div>
                    </div>
                </div>

                <!-- CTA buttons -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <a href="#productos" class="btn-primary">
                        <span>Explorar Soluciones</span>
                        <ArrowRight className="w-5 h-5" />
                    </a>
                    <a href="/comenzar" class="btn-secondary">
                        <span>Comenzar Gratis</span>
                    </a>
                </div>

                <!-- Trust indicators -->
                <div class="flex flex-wrap gap-6 text-white/60 text-sm">
                    <div class="flex items-center gap-2">
                        <Building2 className="w-4 h-4 text-blue-400" />
                        <span>Respaldado por Disglobal</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <Shield className="w-4 h-4 text-green-400" />
                        <span>Cumplimiento Garantizado</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <CheckCircle className="w-4 h-4 text-emerald-400" />
                        <span>AGORA Disponible Ahora</span>
                    </div>
                </div>
            </div>

            <!-- Enhanced phone mockup showing business transformation with availability -->
            <div class="phone-container slide-up">
                <div class="phone-mockup">
                    <div class="phone-screen">
                        <!-- App header with transformation theme -->
                        <div
                            class="flex justify-between items-center pb-4 border-b border-gray-300/50 relative z-10"
                        >
                            <div>
                                <div class="text-2xl font-bold text-gradient">
                                    MIDAZ
                                </div>
                                <div class="text-xs text-gray-500 font-medium">
                                    by Disglobal
                                </div>
                            </div>
                            <div
                                class="w-3 h-3 bg-emerald-400 rounded-full pulse-glow"
                            >
                            </div>
                        </div>

                        <!-- Business transformation metrics with availability -->
                        <div
                            class="app-item bg-green-50 border-l-4 border-green-500"
                            style="animation-delay: 0.2s"
                        >
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 bg-gradient-to-r from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center"
                                >
                                    <span class="text-white text-sm font-bold"
                                        >📈</span
                                    >
                                </div>
                                <div>
                                    <span class="font-medium text-gray-700"
                                        >AGORA - Crecimiento</span
                                    >
                                    <div
                                        class="text-xs text-green-600 font-semibold"
                                    >
                                        ✓ Disponible Ahora
                                    </div>
                                </div>
                            </div>
                            <span class="text-xl font-bold text-emerald-600"
                                >+47%</span
                            >
                        </div>

                        <div
                            class="app-item bg-orange-50 border-l-4 border-orange-500"
                            style="animation-delay: 0.4s"
                        >
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 bg-gradient-to-r from-orange-500 to-orange-600 rounded-xl flex items-center justify-center"
                                >
                                    <span class="text-white text-sm font-bold"
                                        >🍽️</span
                                    >
                                </div>
                                <div>
                                    <span class="font-medium text-gray-700"
                                        >AMBROSIA - F&B</span
                                    >
                                    <div
                                        class="text-xs text-orange-600 font-semibold"
                                    >
                                        🚧 Q2 2025
                                    </div>
                                </div>
                            </div>
                            <span class="text-lg font-bold text-orange-600"
                                >Próximo</span
                            >
                        </div>

                        <div
                            class="app-item bg-blue-50 border-l-4 border-blue-500"
                            style="animation-delay: 0.6s"
                        >
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl flex items-center justify-center"
                                >
                                    <span class="text-white text-sm font-bold"
                                        >🖥️</span
                                    >
                                </div>
                                <div>
                                    <span class="font-medium text-gray-700"
                                        >ATLAS - Kioscos</span
                                    >
                                    <div
                                        class="text-xs text-blue-600 font-semibold"
                                    >
                                        ⏳ Q3 2025
                                    </div>
                                </div>
                            </div>
                            <span class="text-lg font-bold text-blue-600"
                                >Desarrollo</span
                            >
                        </div>

                        <div
                            class="app-item bg-purple-50 border-l-4 border-purple-500"
                            style="animation-delay: 0.8s"
                        >
                            <div class="flex items-center gap-3">
                                <div
                                    class="w-10 h-10 bg-gradient-to-r from-purple-500 to-purple-600 rounded-xl flex items-center justify-center"
                                >
                                    <span class="text-white text-sm font-bold"
                                        >⚡</span
                                    >
                                </div>
                                <div>
                                    <span class="font-medium text-gray-700"
                                        >ETER - Custom</span
                                    >
                                    <div
                                        class="text-xs text-purple-600 font-semibold"
                                    >
                                        💭 Q4 2025
                                    </div>
                                </div>
                            </div>
                            <span class="text-lg font-bold text-purple-600"
                                >Concepto</span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
